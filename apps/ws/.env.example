# ==========================================
# Server Configuration
# ==========================================
# Environment mode (development/production)
NODE_ENV=development
# Service run mode (api/worker/both)
RUN_MODE=worker
# Port to run the server on
PORT=4000

# ==========================================
# Security & JWT Secrets
# ==========================================
# Secret for signing access tokens
JWT_SECRET=your_jwt_secret
# Secret for signing refresh tokens
JWT_REFRESH_SECRET=your_jwt_refresh_secret
# Secret for super admin authentication
SUPER_ADMIN_JWT_SECRET=your_super_admin_jwt_secret

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/db

# ==========================================
# Cache & Queues (Redis)
# ==========================================
# Redis connection URL
REDIS_URL=redis://host:6379
# Internal Redis URL (if applicable)
REDIS_INTERNAL_URL=redis://host:6379

# ==========================================
# Authentication (Google OAuth)
# ==========================================
# Google OAuth Client ID
GOOGLE_CLIENT_ID=690957532930-t9npgpdiaf1119np8jkl41tsf5q1trtu.apps.googleusercontent.com

# ==========================================
# Default Admin Credentials
# ==========================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# ==========================================
# Cloudflare R2 Storage (CDN)
# ==========================================
R2_ENDPOINT=https://your-r2-endpoint.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_bucket_name
REELS_CDN_URL=https://your-cdn-url.r2.dev
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key

# ==========================================
# Email Configuration (Nodemailer SMTP)
# ==========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_smtp_user"
SMTP_PASS="your_smtp_password"
EMAIL_FROM="your_email_from"

# ==========================================
# Payment Gateway (Razorpay)
# ==========================================
# Backend Razorpay Key ID
RAZORPAY_KEY_ID="your_razorpay_key_id"
# Backend Razorpay Key Secret
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Client URL for CORS
CLIENT_URL="https://pitchin180.com,https://workspace.pitchin180.com,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003"

# Skip Prisma Generate on Vercel install
PRISMA_GENERATE_SKIP=true
