# 180 Voiceforce Frontend Environment Variables (Port 3007)

# Standard 180 Identity OAuth Client Credentials
NEXT_PUBLIC_180_CLIENT_ID=your_180_identity_client_id_here
NEXT_PUBLIC_180_CLIENT_SECRET=your_180_identity_client_secret_here

# Services Base URLs
NEXT_PUBLIC_180_AUTH_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4002
