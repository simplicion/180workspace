PORT=4003
NODE_ENV=development

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key

# Database Connections (PostgreSQL with Prisma)
CORE_DATABASE_URL="postgresql://user:password@localhost:5432/180core_db?schema=public"

# Google OAuth (For Sovereign 180 Profile Login)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Sovereign Payment Gateway (Razorpay - ONLY IN 180 CORE BACKEND!)
RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Email SMTP (For OTP Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@180workspace.com"
SMTP_PASS="your_app_password"
EMAIL_FROM="notifications@180workspace.com"

# MSG91 WhatsApp / SMS OTP
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
MSG91_WHATSAPP_INTEGRATED_NUMBER="919381420546"
MSG91_WHATSAPP_TEMPLATE_NAME="welcome"
MSG91_WHATSAPP_LANG="en"

# Traffic Director 180 Pay Webhook Dispatch (Replace localhost with production domain in prod)
TRAFFIC_DIRECTOR_WEBHOOK_URL="http://localhost:4002/api/v1/traffic-director/billing/webhook"
TRAFFIC_DIRECTOR_WEBHOOK_SECRET="180_webhook_traffic_director_prod_sec_991823"

# Recurring Billing Cron Secret (For authenticating external scheduler calls to POST /api/v1/subscriptions/run-billing-cycle)
BILLING_CRON_SECRET="180_billing_cron_secret_prod_secure_2026"
