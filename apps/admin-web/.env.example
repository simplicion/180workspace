# ==========================================
# API Configuration
# ==========================================
# Backend API URL
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Socket.IO URL
NEXT_PUBLIC_SOCKET_URL=https://api.yourdomain.com

# ==========================================
# Authentication & Identity
# ==========================================
# Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# ==========================================
# Application Settings
# ==========================================
# Main domain for subdomain detection
NEXT_PUBLIC_MAIN_DOMAIN=yourdomain.com

# ==========================================
# Payment Gateway (Razorpay)
# ==========================================
# Public Razorpay Key
NEXT_PUBLIC_RAZORPAY_KEY=your_razorpay_key_here

CLIENT_URL="https://pitchin180.com,https://workspace.pitchin180.com,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003"

# Skip Prisma Generate on Vercel install
PRISMA_GENERATE_SKIP=true
