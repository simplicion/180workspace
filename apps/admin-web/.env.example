# ==========================================
# API Configuration
# ==========================================
# Backend API URL
NEXT_PUBLIC_API_URL=https://api.180workspace.com

# Socket.IO URL
NEXT_PUBLIC_SOCKET_URL=https://api.yourdomain.com

# ==========================================
# Authentication & Identity (180 Identity)
# ==========================================
NEXT_PUBLIC_180_CLIENT_ID="your_180_client_id_here"
NEXT_PUBLIC_180_AUTH_URL="https://profile.180workspace.com"

# ==========================================
# Application Settings
# ==========================================
# Main domain for subdomain detection
NEXT_PUBLIC_MAIN_DOMAIN=admin.180workspace.com
NEXT_PUBLIC_ROOT_DOMAIN=180workspace.com
NEXT_PUBLIC_APP_URL=https://app.180workspace.com
NEXT_PUBLIC_MARKETING_URL=https://180workspace.com

CLIENT_URL="https://app.180workspace.com,https://180workspace.com,https://admin.180workspace.com,https://api.180workspace.com"

# Skip Prisma Generate on Vercel install
PRISMA_GENERATE_SKIP=true


