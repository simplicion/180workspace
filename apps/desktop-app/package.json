{
  "name": "@workspace/desktop-app",
  "version": "1.0.0",
  "private": true,
  "description": "180 Workspace - desktop app for the whole platform (Windows, macOS, Linux): offline support and local media processing",
  "scripts": {
    "icons": "tauri icon ../frontend/public/icons/icon-512x512.png",
    "prepare:sidecars": "node scripts/prepare-sidecars.mjs",
    "dev:tauri": "node scripts/prepare-sidecars.mjs && tauri dev",
    "build:tauri": "node scripts/prepare-sidecars.mjs && tauri build",
    "build:windows": "powershell -ExecutionPolicy Bypass -File ./windows/build-windows.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
