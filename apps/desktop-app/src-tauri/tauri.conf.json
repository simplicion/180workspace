{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "180 Workspace",
  "version": "1.0.0",
  "identifier": "com.workspace180.desktop",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://app.180workspace.com https://180workspace.com http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "180 Workspace desktop app",
    "longDescription": "The 180 Workspace desktop app: your whole workspace, offline support, and local video editing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["workspace180"]
      }
    }
  }
}
