---
const appLinks = [
  { label: 'Voiceforce (AI Calling)', href: '/apps/voiceforce' },
  { label: 'CRM & Sales', href: '/apps/crm-and-sales' },
  { label: 'Traffic Director', href: '/apps/traffic-director' },
  { label: 'Finance & Invoicing', href: '/apps/finance' },
  { label: 'Projects & Tasks', href: '/apps/projects-and-tasks' },
  { label: 'HR Management', href: '/apps/hr-management' },
  { label: 'Communications & Meetings', href: '/apps/communications' },
  { label: 'Orbit AI Copilot', href: '/apps/orbit-copilot' },
  { label: 'Social Media Suite', href: '/apps/social-media' },
  { label: 'All Applications →', href: '/apps' },
];

const platformLinks = [
  { label: 'Pricing & Plans', href: '/pricing' },
  { label: 'Enterprise & Security', href: '/enterprise' },
  { label: 'Customer Case Studies', href: '/case-studies' },
  { label: 'Blog & Thought Leadership', href: '/blog' },
  { label: 'Developer REST API', href: '/developers' },
];

const legalLinks = [
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms of Service', href: '/terms' },
  { label: 'Security & Compliance', href: '/enterprise' },
  { label: 'Platform Architecture', href: '/features' },
  { label: 'XML Sitemap', href: '/sitemap.xml' },
  { label: 'Robots.txt', href: '/robots.txt' },
];
---

<footer class="bg-slate-50 dark:bg-slate-950 border-t border-slate-200/80 dark:border-slate-800 pt-16 pb-12 mt-24">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      
      {/* Brand Column */}
      <div class="lg:col-span-1">
        <a href="/" class="text-xl font-black text-slate-950 dark:text-white tracking-tight flex items-center gap-2 mb-4">
          <img src="/icons/black-icon.svg" alt="180workspace" class="w-8 h-8 dark:hidden" width="32" height="32" />
          <img src="/icons/white-icon.svg" alt="180workspace" class="w-8 h-8 hidden dark:block" width="32" height="32" />
          <span>180<span class="text-indigo-600">workspace</span></span>
        </a>
        <p class="body-standard text-xs leading-relaxed mb-6">
          The unified Work Graph operating system. Run CRM, Traffic Routing, Invoicing, Projects, HR, and Orbit AI without software fragmentation.
        </p>
        <div class="flex items-center gap-3 text-slate-400 dark:text-slate-500 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>All Systems Operational</span>
        </div>
      </div>

      {/* App Playbooks Column */}
      <div class="lg:col-span-1">
        <h4 class="text-eyebrow text-slate-900 dark:text-white mb-4">Application Playbooks</h4>
        <ul class="space-y-2.5 text-xs">
          {appLinks.map((item) => (
            <li>
              <a href={item.href} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors font-medium">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Platform & Solutions Column */}
      <div class="lg:col-span-1">
        <h4 class="text-eyebrow text-slate-900 dark:text-white mb-4">Platform & Solutions</h4>
        <ul class="space-y-2.5 text-xs">
          {platformLinks.map((item) => (
            <li>
              <a href={item.href} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors font-medium">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Legal & Developers Column */}
      <div class="lg:col-span-1">
        <h4 class="text-eyebrow text-slate-900 dark:text-white mb-4">Developers & Trust</h4>
        <ul class="space-y-2.5 text-xs">
          {legalLinks.map((item) => (
            <li>
              <a href={item.href} class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors font-medium">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    {/* Bottom Legal Bar */}
    <div class="border-t border-slate-200 dark:border-slate-800 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 font-medium">
      <p>
        &copy; {new Date().getFullYear()} 180workspace. All rights reserved.
      </p>
      <div class="flex flex-wrap items-center gap-4 sm:gap-6 mt-4 sm:mt-0">
        <a href="/privacy" class="hover:text-slate-600 dark:hover:text-slate-300">Privacy Policy</a>
        <a href="/terms" class="hover:text-slate-600 dark:hover:text-slate-300">Terms of Service</a>
        <a href="/pricing" class="hover:text-slate-600 dark:hover:text-slate-300">Pricing</a>
        <a href="/enterprise" class="hover:text-slate-600 dark:hover:text-slate-300">Security</a>
        <a href="/developers" class="hover:text-slate-600 dark:hover:text-slate-300">Developers</a>
        <a href="/sitemap.xml" class="hover:text-slate-600 dark:hover:text-slate-300">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
