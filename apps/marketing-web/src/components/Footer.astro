---
const appLinks = [
  { label: 'Voiceforce (AI Calling)', href: '/apps/voiceforce' },
  { label: 'CRM & Sales', href: '/apps/crm-and-sales' },
  { label: 'Advertising', href: '/apps/advertising' },
  { label: 'Projects & Tasks', href: '/apps/projects-and-tasks' },
  { label: 'HR Management', href: '/apps/hr-management' },
  { label: 'Finance & Invoicing', href: '/apps/finance' },
  { label: 'Communications & Meetings', href: '/apps/communications' },
  { label: 'Workspace Tools', href: '/apps/workspace-tools' },
  { label: 'All 8 Applications', href: '/apps' },
];

const platformLinks = [
  { label: '180 Workspace', href: 'https://app.180workspace.com' },
  { label: '180 Core', href: '/180-core' },
  { label: '180 Traffic Director', href: '/180-traffic-director' },
  { label: '180 Social Studio', href: '/180-social-studio' },
  { label: 'Pricing & Plans', href: '/pricing' },
  { label: 'Customer Case Studies', href: '/case-studies' },
  { label: 'White Papers & Architecture', href: '/whitepapers' },
];

const legalLinks = [
  { label: 'Docs Portal (docs.180workspace.com)', href: 'https://docs.180workspace.com' },
  { label: 'Developer Console (developers.180workspace.com)', href: 'https://developers.180workspace.com' },
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms of Service', href: '/terms' },
  { label: 'XML Sitemap', href: '/sitemap.xml' },
];
---

<footer class="bg-slate-50 dark:bg-black border-t border-slate-200/80 dark:border-white/10 pt-16 pb-12 mt-24">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      
      {/* Brand Column */}
      <div class="lg:col-span-1">
        <a href="/" class="text-xl font-black text-slate-950 dark:text-white tracking-tight flex items-center gap-2 mb-4">
          <img src="/icons/black-icon.svg" alt="180workspace" class="w-8 h-8 dark:hidden" width="32" height="32" />
          <img src="/icons/white-icon.svg" alt="180workspace" class="w-8 h-8 hidden dark:block" width="32" height="32" />
          <span>180<span class="text-indigo-600">workspace</span></span>
        </a>
        <p class="body-standard text-xs leading-relaxed mb-6">
          The unified Work Graph operating system. Run CRM, Traffic Routing, Invoicing, Projects, HR, and Orbit AI without software fragmentation.
        </p>
        <div class="flex items-center gap-3 text-slate-400 dark:text-zinc-500 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>All Systems Operational</span>
        </div>
      </div>

      {/* App Playbooks Column */}
      <div class="lg:col-span-1">
        <h4 class="text-eyebrow text-slate-900 dark:text-white mb-4">Application Playbooks</h4>
        <ul class="space-y-2.5 text-xs">
          {appLinks.map((item) => (
            <li>
              <a href={item.href} class="text-slate-600 dark:text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors font-medium">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Platform & Solutions Column */}
      <div class="lg:col-span-1">
        <h4 class="text-eyebrow text-slate-900 dark:text-white mb-4">Platform & Solutions</h4>
        <ul class="space-y-2.5 text-xs">
          {platformLinks.map((item) => (
            <li>
              <a href={item.href} class="text-slate-600 dark:text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors font-medium">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Legal & Developers Column */}
      <div class="lg:col-span-1">
        <h4 class="text-eyebrow text-slate-900 dark:text-white mb-4">Developers & Trust</h4>
        <ul class="space-y-2.5 text-xs">
          {legalLinks.map((item) => (
            <li>
              <a href={item.href} class="text-slate-600 dark:text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors font-medium">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    {/* Bottom Legal Bar */}
    <div class="border-t border-slate-200 dark:border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 dark:text-zinc-500 font-medium">
      <p>
        &copy; {new Date().getFullYear()} 180workspace. All rights reserved.
      </p>
      <div class="flex flex-wrap items-center gap-4 sm:gap-6 mt-4 sm:mt-0">
        <a href="/privacy" class="hover:text-slate-600 dark:hover:text-zinc-300">Privacy Policy</a>
        <a href="/terms" class="hover:text-slate-600 dark:hover:text-zinc-300">Terms of Service</a>
        <a href="/pricing" class="hover:text-slate-600 dark:hover:text-zinc-300">Pricing</a>
        <a href="/developers" class="hover:text-slate-600 dark:hover:text-zinc-300">Developers</a>
        <a href="/sitemap.xml" class="hover:text-slate-600 dark:hover:text-zinc-300">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
