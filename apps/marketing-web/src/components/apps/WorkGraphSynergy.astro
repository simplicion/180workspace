---
import SectionHeader from '../ui/SectionHeader.astro';

interface SynergyLink {
  sourceApp: string;
  targetApp: string;
  description: string;
  badge?: string;
}

interface Props {
  sectionBadge?: string;
  title: string;
  subtitle: string;
  currentAppName: string;
  synergies: SynergyLink[];
}

const {
  sectionBadge = "The Work Graph Advantage",
  title = "Unified Cross-App Synergy",
  subtitle = "How this app communicates natively with the rest of your 180workspace ecosystem.",
  currentAppName,
  synergies = []
} = Astro.props;
---

<section class="py-20 md:py-28 bg-slate-50/70 dark:bg-slate-900/40 border-t border-slate-200/80 dark:border-slate-800 relative overflow-hidden">
  {/* Atmospheric Background glow */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-gradient-to-r from-indigo-500/10 via-purple-500/10 to-pink-500/10 blur-[140px] rounded-full pointer-events-none -z-10"></div>

  <div class="container mx-auto px-4 max-w-6xl relative z-10">
    
    <SectionHeader 
      badge={sectionBadge}
      badgeClass="badge-pill bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-400 border-indigo-200/60 dark:border-indigo-800"
      title={title}
      subtitle={subtitle}
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {synergies.map((item) => (
        <div class="glass-card-interactive p-7 flex flex-col justify-between relative group overflow-hidden">
          {/* Subtle top accent gradient */}
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-indigo-500 to-purple-500 opacity-60 group-hover:opacity-100 transition-opacity"></div>

          <div>
            {/* App Connection Header */}
            <div class="flex items-center gap-2.5 mb-5 flex-wrap">
              <span class="px-3 py-1 rounded-xl text-xs font-black bg-indigo-50 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300 border border-indigo-200/80 dark:border-indigo-800/80 shadow-sm">
                {currentAppName}
              </span>
              <svg class="w-4 h-4 text-slate-400 dark:text-slate-500 shrink-0 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
              <span class="px-3 py-1 rounded-xl text-xs font-black bg-purple-50 dark:bg-purple-950/80 text-purple-700 dark:text-purple-300 border border-purple-200/80 dark:border-purple-800/80 shadow-sm">
                {item.targetApp}
              </span>
            </div>

            {item.badge && (
              <span class="text-[10px] font-extrabold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 inline-block mb-3">
                {item.badge}
              </span>
            )}

            <p class="body-standard text-sm text-slate-600 dark:text-slate-300 leading-relaxed mt-1">
              {item.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800/80 text-xs font-semibold text-slate-500 dark:text-slate-400 flex items-center justify-between">
            <span>Zero manual sync needed</span>
            <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-50 dark:bg-emerald-950/50 px-2.5 py-1 rounded-full border border-emerald-200/60 dark:border-emerald-800/60">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Instant Work Graph Event
            </span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
