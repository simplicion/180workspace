---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  appName?: string;
  name?: string;
  description: string;
  urlPath?: string;
  url?: string;
  applicationCategory?: string;
  type?: string;
  faqs?: FAQItem[];
}

const {
  appName,
  name,
  description,
  urlPath,
  url,
  applicationCategory = "BusinessApplication",
  type = "SoftwareApplication",
  faqs = []
} = Astro.props;

const rootDomain = "https://180workspace.com";
const resolvedName = name || appName || "Workspace";
const displayName = resolvedName.startsWith("180") ? resolvedName : `180 ${resolvedName}`;

const effectivePath = urlPath || (url ? url.replace(rootDomain, '') : (Astro.url.pathname || ''));
let cleanPath = effectivePath;
if (cleanPath.length > 1 && cleanPath.endsWith('/')) {
  cleanPath = cleanPath.slice(0, -1);
}
const pageUrl = cleanPath.startsWith('http') ? cleanPath : `${rootDomain}${cleanPath === '/' ? '' : cleanPath}`;

// SoftwareApplication Schema
const appSchema = {
  "@context": "https://schema.org",
  "@type": type,
  "name": displayName,
  "operatingSystem": "Web, Cloud, Windows, macOS, Linux, iOS, Android",
  "applicationCategory": applicationCategory,
  "description": description,
  "url": pageUrl,
  "offers": {
    "@type": "Offer",
    "price": "0.00",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "180workspace",
      "url": rootDomain
    }
  },
  "publisher": {
    "@type": "Organization",
    "name": "180workspace",
    "url": rootDomain,
    "logo": `${rootDomain}/black-icon.svg`
  }
};

// FAQPage Schema
const faqSchema = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;

// BreadcrumbList Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": rootDomain
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Apps",
      "item": `${rootDomain}/apps`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": displayName,
      "item": pageUrl
    }
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
