---
import SectionHeader from '../ui/SectionHeader.astro';

interface PlaybookStep {
  stepNumber: string;
  title: string;
  description: string;
  actionSnippet?: string;
}

interface Props {
  sectionBadge?: string;
  title: string;
  subtitle: string;
  youtubeEmbedId?: string;
  videoCaption?: string;
  steps: PlaybookStep[];
}

const {
  sectionBadge = "Step-by-Step Playbook",
  title = "How It Works & Quickstart Guide",
  subtitle = "Master the workflow in minutes with this complete walkthrough.",
  youtubeEmbedId,
  videoCaption = "Live 2-Minute Feature Walkthrough",
  steps = []
} = Astro.props;
---

<section id="walkthrough" class="py-20 md:py-28 relative overflow-hidden">
  <div class="container mx-auto px-4 max-w-6xl">
    
    <SectionHeader 
      badge={sectionBadge}
      badgeClass="badge-pill bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-400 border-purple-200/60 dark:border-purple-800"
      title={title}
      subtitle={subtitle}
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      {/* Video Container (6-col on lg) */}
      <div class="lg:col-span-6 order-2 lg:order-1">
        <div class="mockup-terminal aspect-video flex items-center justify-center p-0 overflow-hidden">
          {youtubeEmbedId ? (
            <iframe 
              class="w-full h-full object-cover"
              src={`https://www.youtube-nocookie.com/embed/${youtubeEmbedId}?rel=0&modestbranding=1`}
              title="Feature Walkthrough Video"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            />
          ) : (
            <div class="p-8 text-center">
              <div class="w-16 h-16 rounded-full bg-indigo-600/30 text-indigo-400 border border-indigo-500/40 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
                <svg class="w-8 h-8 ml-1 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path></svg>
              </div>
              <h4 class="text-lg font-bold text-white mb-1">{videoCaption}</h4>
              <p class="body-standard text-xs text-slate-400">Interactive step-by-step visual training modules.</p>
            </div>
          )}
        </div>
      </div>

      {/* Steps List (6-col on lg) */}
      <div class="lg:col-span-6 order-1 lg:order-2 space-y-4 sm:space-y-6">
        {steps.map((step) => (
          <div class="flex gap-4 sm:gap-6 bg-white dark:bg-slate-900/80 p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm hover:border-indigo-300 dark:hover:border-indigo-700 transition-all">
            <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white font-black text-sm flex items-center justify-center shrink-0 shadow-md shadow-indigo-600/30">
              {step.stepNumber}
            </div>
            <div>
              <h3 class="text-base sm:text-lg font-bold text-slate-950 dark:text-white mb-1.5">
                {step.title}
              </h3>
              <p class="body-standard text-xs sm:text-sm mb-2">
                {step.description}
              </p>
              {step.actionSnippet && (
                <div class="font-mono text-[11px] bg-slate-100 dark:bg-slate-950 px-3 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 inline-block border border-slate-200 dark:border-slate-800">
                  {step.actionSnippet}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>
