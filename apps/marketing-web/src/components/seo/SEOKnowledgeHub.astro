---
interface Props {
  title?: string;
  subtitle?: string;
  className?: string;
}

const {
  title = "Frequently Searched Questions & Knowledge Base",
  subtitle = "Direct answers to how 180workspace unifies business operations, eliminates subscription sprawl, and ensures enterprise data sovereignty.",
  className = ""
} = Astro.props;

const searchQueries = [
  {
    category: "How-To Guide",
    tagColor: "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20",
    question: "How to replace multiple SaaS subscriptions with a single business operating system?",
    answer: "Most modern businesses pay separate subscription fees for CRM, project management, team chat, invoicing, and cloud storage. With 180workspace, all 16 core business applications are natively integrated on top of a single Work Graph database. Teams migrate their data via automated CSV/API importers and immediately eliminate redundant user seats, saving up to 60% on annual software licensing while eliminating the need for Zapier or third-party sync bridges.",
    searchIntent: "Informational & Cost Reduction"
  },
  {
    category: "Architecture Explainer",
    tagColor: "bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border-indigo-500/20",
    question: "What is a Work Graph architecture and how does it prevent database sync delays?",
    answer: "Traditional SaaS stacks use disparate databases glued together by fragile webhooks and batch synchronization jobs that can take 5 to 30 minutes to propagate. The 180workspace Work Graph connects all enterprise entities—leads, deals, projects, sprint tasks, invoices, employee records, support tickets, and files—into a single unified relational graph. When a deal closes in the CRM, the invoice, task board, and accounting records update instantaneously with zero millisecond sync lag.",
    searchIntent: "Technical & Architectural"
  },
  {
    category: "Workflow Automation",
    tagColor: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20",
    question: "How to automate end-to-end business workflows from sales lead to cash collection?",
    answer: "Using 180workspace Workflows & Automations, teams configure event-driven triggers powered by BullMQ queues. For instance, when a prospect converts to 'Closed-Won' in CRM & Sales, the system automatically: (1) generates a branded invoice in Finance, (2) provisions a new customer onboarding project with milestone tasks, (3) creates a private team communication channel, and (4) notifies leadership via Orbit AI Copilot with zero manual data entry.",
    searchIntent: "Operational Efficiency"
  },
  {
    category: "Sovereign Deployment",
    tagColor: "bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20",
    question: "Where can enterprises host and deploy sovereign 180workspace instances?",
    answer: "180workspace supports fully managed multi-region cloud hosting (US East/West, EU Frankfurt/Dublin, APAC Tokyo/Singapore) as well as dedicated sovereign enterprise private cloud deployments. All customer data is strictly isolated using cryptographic tenant IDs (companyId isolation), encrypted with AES-256 at rest, TLS 1.3 in transit, and certified compliant with SOC-2 Type II, GDPR, and HIPAA standards.",
    searchIntent: "Security & Compliance"
  },
  {
    category: "Platform Comparison",
    tagColor: "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20",
    question: "How does 180workspace compare against Microsoft 365, Notion, and Google Workspace?",
    answer: "While Microsoft 365 and Google Workspace focus primarily on office productivity (email, basic docs, spreadsheets, video calls) and Notion focuses on wikis and basic databases, neither provides native enterprise CRM, accounting/invoicing, HR & payroll, dynamic traffic cloaking, or unified billing intelligence. 180workspace is a complete business operating system that combines office productivity with revenue operations, people operations, and executive business intelligence in one sovereign environment.",
    searchIntent: "Commercial Investigation"
  },
  {
    category: "AI Copilot Integration",
    tagColor: "bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20",
    question: "Which business operating system offers an AI assistant with full cross-app context?",
    answer: "Orbit AI Copilot inside 180workspace operates natively across all 16 apps. It can summarize video meetings, extract action items into task boards, analyze ad spend return from Google/Meta against actual CRM invoice cash receipts, and write executive summary memos using live company data. Crucially, your private workspace data is never used to train public AI foundation models.",
    searchIntent: "AI Capability"
  }
];

// Schema.org FAQPage for rich snippet eligibility
const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": searchQueries.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section class={`py-20 md:py-28 relative overflow-hidden bg-slate-50/50 dark:bg-slate-900/30 border-t border-slate-200/80 dark:border-slate-800 ${className}`}>
  <!-- Schema.org Script -->
  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />

  <!-- Background decorative glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-indigo-500/5 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="container mx-auto px-4 max-w-5xl relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-200/60 dark:border-indigo-800/60 text-indigo-700 dark:text-indigo-300 mb-4 shadow-sm">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Search Engine & AI Discovery Hub</span>
      </div>
      <h2 class="text-3xl md:text-5xl font-black tracking-tight text-slate-950 dark:text-white mb-4">
        {title}
      </h2>
      <p class="text-base md:text-lg text-slate-600 dark:text-slate-400 font-normal">
        {subtitle}
      </p>
    </div>

    <!-- Search Intent Query Accordion -->
    <div class="space-y-4">
      {searchQueries.map((item, index) => (
        <details class="group bg-white dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 transition-all duration-200 hover:border-indigo-500/40 dark:hover:border-indigo-500/40 hover:shadow-md cursor-pointer">
          <summary class="flex items-start justify-between gap-4 font-semibold text-slate-900 dark:text-white text-lg select-none list-none">
            <div class="space-y-2 pr-4">
              <span class={`inline-block px-2.5 py-0.5 rounded-md text-xs font-medium border ${item.tagColor}`}>
                {item.category}
              </span>
              <h3 class="text-base md:text-lg font-bold text-slate-950 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                {item.question}
              </h3>
            </div>
            <div class="flex-shrink-0 mt-1 w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 group-hover:bg-indigo-50 dark:group-hover:bg-indigo-950 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-all group-open:rotate-180">
              <svg class="w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800/80 text-sm md:text-base text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
