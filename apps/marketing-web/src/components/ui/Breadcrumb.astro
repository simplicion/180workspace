---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;
---

<nav aria-label="Breadcrumbs" class={`flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-zinc-400 overflow-x-auto scrollbar-none py-2.5 ${className}`}>
  {items.map((item, index) => {
    const isLast = index === items.length - 1;
    return (
      <div class="flex items-center gap-2 shrink-0">
        {index > 0 && (
          <svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {isLast ? (
          <span class="text-slate-900 dark:text-white font-bold truncate max-w-[280px]" aria-current="page">
            {item.name}
          </span>
        ) : (
          <a href={item.url} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors shrink-0">
            {item.name}
          </a>
        )}
      </div>
    );
  })}
</nav>
