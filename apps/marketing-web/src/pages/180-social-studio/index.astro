---
import Layout from '../../layouts/Layout.astro';
import AppHero from '../../components/apps/AppHero.astro';
import CapabilityPillars from '../../components/apps/CapabilityPillars.astro';
import VideoPlaybook from '../../components/apps/VideoPlaybook.astro';
import WorkGraphSynergy from '../../components/apps/WorkGraphSynergy.astro';
import FAQAccordion from '../../components/apps/FAQAccordion.astro';
import AppBottomCTA from '../../components/apps/AppBottomCTA.astro';
import JSONLDSchema from '../../components/apps/JSONLDSchema.astro';

const pillars = [
  {
    badge: ">500 FPS Export",
    title: "Lossless Smart Stream-Copy Video Engine",
    description: "Export untouched video segments at raw disk I/O speeds without generational quality loss. Only modified transition GOP boundaries are re-encoded.",
    bullets: [
      "Stream-copy untouched keyframe GOP packets directly",
      "500+ FPS export throughput on standard NVMe SSDs",
      "Exact GOP boundary calculation with zero audio desync"
    ]
  },
  {
    badge: "AI Creative Director",
    title: "Autonomous Video Editing & Caption Generation",
    description: "Deterministic telemetry extraction feeds compact JSON ASTs into LLM directors, generating viral jump-cuts, highlight reels, and dynamic animated subtitles.",
    bullets: [
      "Automated transcript silence detection and jump-cut pacing",
      "Rule-based QA Critic scoring retention, zoom, and text visibility",
      "100% offline fallback mode with built-in heuristic director"
    ]
  },
  {
    badge: "Universal Calendar",
    title: "Visual Multi-Channel Content Calendar",
    description: "Plan, draft, and schedule all your marketing content across social channels in an intuitive drag-and-drop monthly, weekly, and daily calendar view.",
    bullets: [
      "Drag-and-drop post rescheduling across dates and times",
      "Channel filtering (LinkedIn, Twitter/X, Instagram, YouTube, Facebook)",
      "Color-coded campaign tags and content category grouping"
    ]
  },
  {
    badge: "Multi-Publishing",
    title: "One-Click Multi-Network Distribution",
    description: "Write your post once and customize captions, hashtags, and video aspect ratios for each platform with real-time live preview mockups.",
    bullets: [
      "Direct API publishing to LinkedIn, Twitter/X, Meta, and Instagram",
      "Platform-specific character counters and hashtag helpers",
      "First-comment auto-posting for links and extra hashtags"
    ]
  },
  {
    badge: "Approval Tiers",
    title: "Content Review & Approval Workflows",
    description: "Prevent accidental social slip-ups. Draft posts require client or marketing director review and sign-off before automated scheduling.",
    bullets: [
      "Draft, Pending Review, Scheduled, and Published states",
      "In-line feedback comments directly on post drafts",
      "External client approval links for agency social managers"
    ]
  },
  {
    badge: "Performance",
    title: "Social Engagement & Audience Analytics",
    description: "Track post impressions, engagement rates, click-throughs, and follower growth trends across all connected social channels in one dashboard.",
    bullets: [
      "Cross-platform impression and engagement comparisons",
      "Top-performing post leaderboards to identify winning formats",
      "Best time-to-post recommendations based on historical data"
    ]
  }
];

const playbookSteps = [
  {
    stepNumber: "01",
    title: "Connect Social Channels & Import Assets",
    description: "Connect your LinkedIn company page, Twitter/X, YouTube, and Instagram accounts. Import raw 4K footage or graphics directly from 180 Cloud Drive.",
    actionSnippet: "Social Studio -> Settings -> Connect Accounts"
  },
  {
    stepNumber: "02",
    title: "Auto-Edit Videos with AI Director",
    description: "Load footage into the timeline. The AI Director trims dead air, generates animated kinetic subtitles, and optimizes aspect ratios for Reels and Shorts.",
    actionSnippet: "Render Engine: >500 FPS Lossless Stream Copy"
  },
  {
    stepNumber: "03",
    title: "Schedule on the Visual Content Calendar",
    description: "Drag rendered media onto your publishing calendar. Customize platform captions, first-comment links, and scheduled publish times.",
    actionSnippet: "Multi-Network Distribution -> Auto-Format"
  },
  {
    stepNumber: "04",
    title: "Automated Publishing & Work Graph Tracking",
    description: "The Work Graph background queue automatically publishes each post and tracks audience impressions and lead attribution in 180 CRM.",
    actionSnippet: "Published via BullMQ Workers • Sync to CRM"
  }
];

const synergies = [
  {
    sourceApp: "180 Social Studio",
    targetApp: "180 CRM & Sales",
    badge: "Lead Attribution",
    description: "Social post clicks and campaign UTMs feed directly into CRM lead timelines when prospective clients interact."
  },
  {
    sourceApp: "180 Social Studio",
    targetApp: "Workspace Tools",
    badge: "Cloud Storage",
    description: "Direct zero-egress integration with Cloud Drive for high-resolution video b-roll and marketing asset libraries."
  },
  {
    sourceApp: "180 Social Studio",
    targetApp: "Voiceforce",
    badge: "Audio Sync",
    description: "Incorporate autonomous voice clone audio tracks directly into video timeline sequences."
  }
];

const faqs = [
  {
    question: "What is 180 Social Studio?",
    answer: "180 Social Studio is an all-in-one creative suite combining an ultra-fast autonomous video editor engine (>500 FPS stream-copy) with a unified multi-channel social media scheduler and analytics dashboard."
  },
  {
    question: "Which social media platforms does 180 Social Studio support?",
    answer: "Social Studio natively supports direct publishing and scheduling to LinkedIn (personal profiles and company pages), Twitter/X, YouTube (Shorts and long-form), Facebook Pages, and Instagram."
  },
  {
    question: "How does the >500 FPS stream-copy video engine work?",
    answer: "Unlike traditional video editors that re-encode every single frame from scratch, our stream-copy engine extracts untouched keyframe GOP packets directly from disk, re-encoding only modified cuts and transitions for extreme export speeds."
  },
  {
    question: "Can agencies invite clients to approve social posts?",
    answer: "Yes. Social Studio includes dedicated client approval links where external clients can review post mockups, leave feedback comments, and approve drafts with one click without needing full workspace access."
  },
  {
    question: "Is video editing performed locally or in the cloud?",
    answer: "Video editing executes local-first with hardware acceleration via NVENC, Apple VideoToolbox, and WebGPU shaders, eliminating long cloud upload delays for raw 4K and 8K footage."
  }
];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Apps', url: '/apps' },
  { name: '180 Social Studio', url: '/180-social-studio' }
];
---

<Layout 
  title="180 Social Studio — Autonomous Video Editor & Omnichannel Scheduler | 180workspace"
  description="High-speed >500 FPS video editing engine and universal multi-network social media publisher integrated on the 180 Work Graph."
  breadcrumbs={breadcrumbs}
  applicationCategory="MultimediaApplication"
>
  <main class="w-full relative">
    
    <AppHero 
      title="Create, edit, and publish social media at"
      highlightText="unprecedented speed."
      description="Autonomous video editing with >500 FPS stream-copy rendering combined with unified multi-channel scheduling for YouTube, Instagram, X, and LinkedIn."
      breadcrumbs={breadcrumbs}
    />

    <CapabilityPillars 
      sectionBadge="Social Studio Features"
      sectionTitle="Everything your creative team needs to scale content output."
      sectionSubtitle="From raw footage cuts to scheduled multi-network distribution in one cohesive workflow."
      pillars={pillars}
    />

    <VideoPlaybook 
      sectionBadge="Creative Playbook"
      title="From Raw Footage to Viral Social Post"
      subtitle="Follow these 4 steps to produce and schedule high-impact content across every channel."
      videoCaption="2-Minute 180 Social Studio Walkthrough"
      steps={playbookSteps}
    />

    <WorkGraphSynergy 
      currentAppName="180 Social Studio"
      title="Creative publishing connected to business growth."
      subtitle="See how social impressions and video engagements flow into CRM leads and revenue attribution."
      synergies={synergies}
    />

    <FAQAccordion 
      sectionBadge="Social Studio FAQs"
      title="Frequently Asked Questions about 180 Social Studio"
      subtitle="Answers regarding video engine performance, platform connections, approval tiers, and client access."
      faqs={faqs}
    />

    <AppBottomCTA 
      appName="180 Social Studio" 
      headline="Scale your content production without the subscription bloat."
      subheadline="Start editing faster and scheduling smarter today with 180 Social Studio on 180workspace."
    />

    <JSONLDSchema 
      appName="180 Social Studio"
      description="High-speed >500 FPS video editing engine and universal multi-network social media publisher integrated on the 180 Work Graph."
      urlPath="/180-social-studio"
      faqs={faqs}
    />

  </main>
</Layout>
