---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';

const popularPages = [
  { name: "Explore All 8 Apps", href: "/apps", desc: "Discover CRM, Projects, Finance, Voiceforce, HR & Comms" },
  { name: "Free Tools Suite", href: "/tools", desc: "PDF Converter, Invoice Generator, UTM Builder & YouTube Suite" },
  { name: "Transparent Pricing", href: "/pricing", desc: "Real, transparent plans at $10, $17, and $20/month" },
  { name: "Developer Portal", href: "/developers", desc: "REST APIs, OAuth 2.0 PKCE & Sovereign Identity SDKs" },
  { name: "Architecture Whitepapers", href: "/whitepapers", desc: "Deep dives into Work Graph & multi-tenant edge routing" },
  { name: "Customer Case Studies", href: "/case-studies", desc: "Proven operational ROI and team migration results" },
];
---

<Layout 
  title="404 — Page Not Found | 180workspace"
  description="The page you were looking for could not be found. Explore our 8 native apps, free utilities, transparent pricing, or return to the 180workspace homepage."
  noindex={true}
>
  <main class="w-full relative min-h-[85vh] flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
    {/* Atmospheric Glow */}
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[650px] bg-gradient-to-tr from-indigo-500/15 via-violet-500/10 to-transparent blur-[140px] rounded-full pointer-events-none -z-10"></div>
    <div class="absolute inset-0 bg-grid-pattern dark:bg-grid-pattern-dark [mask-image:radial-gradient(ellipse_70%_60%_at_50%_40%,#000_60%,transparent_100%)] opacity-70 -z-20"></div>

    <div class="container mx-auto max-w-4xl text-center relative z-10">
      
      {/* 404 Badge */}
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800 shadow-sm mb-6">
        <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">HTTP 404 • Resource Not Found</span>
      </div>

      {/* Main Error Heading */}
      <h1 class="display-h1 mb-6">
        Lost in the <br class="hidden sm:inline">
        <span class="bg-gradient-to-r from-indigo-600 via-violet-600 to-rose-600 bg-clip-text text-transparent">
          Work Graph?
        </span>
      </h1>

      <p class="body-lead max-w-2xl mx-auto mb-10">
        The link you followed may be broken, out of date, or the requested page has been relocated. Let’s get you back to the right workspace.
      </p>

      {/* Action Buttons */}
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16 max-w-md mx-auto">
        <Button href="/" variant="primary" icon={true} class="w-full sm:w-auto shadow-xl shadow-indigo-600/25">
          Return to Homepage
        </Button>
        <Button href="/apps" variant="secondary" class="w-full sm:w-auto">
          Browse All 8 Apps
        </Button>
      </div>

      {/* Recommended Directories Grid */}
      <div class="text-left border-t border-slate-200/80 dark:border-white/10 pt-12">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-zinc-500 mb-6 text-center">
          Popular & Verified Destinations
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {popularPages.map(page => (
            <a 
              href={page.href}
              class="glass-card-interactive p-5 flex flex-col justify-between group hover:border-indigo-500/50 hover:shadow-lg transition-all"
            >
              <div>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mb-1.5 flex items-center justify-between">
                  <span>{page.name}</span>
                  <span class="text-xs text-indigo-500 group-hover:translate-x-1 transition-transform">→</span>
                </h3>
                <p class="text-xs text-slate-500 dark:text-zinc-400 leading-relaxed">
                  {page.desc}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>

      {/* Help / Support Contact */}
      <div class="mt-12 text-xs text-slate-500 dark:text-zinc-400">
        Looking for something specific? Contact our systems engineering team at{" "}
        <a href="mailto:support@180workspace.com" class="font-bold text-indigo-600 dark:text-indigo-400 hover:underline">
          support@180workspace.com
        </a>
      </div>

    </div>
  </main>
</Layout>
