---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Badge from '../../components/ui/Badge.astro';
import AppBottomCTA from '../../components/apps/AppBottomCTA.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { prisma } from '@workspace/db';

let apps = [];
try {
  apps = await prisma.marketingPage.findMany({
    where: {
      type: 'FEATURE',
      published: true
    },
    orderBy: {
      seoTitle: 'asc'
    }
  });
} catch (error) {
  // Rely on robust core fallback suite
}

const defaultFeatures = [
  {
    slug: 'voiceforce',
    url: '/apps/voiceforce',
    title: 'Autonomous AI Phone Agents (Voiceforce)',
    category: 'AI Telephony',
    description: 'Sub-200ms conversational voice synthesis, dedicated international numbers, and automatic CRM call logging for sales and client support.'
  },
  {
    slug: 'crm-and-sales',
    url: '/apps/crm-and-sales',
    title: 'CRM, Deal Pipelines & Proposal E-Signatures',
    category: 'Revenue Ops',
    description: 'Visual drag-and-drop pipelines, custom stage weighting, and legally-binding contract e-signatures with cryptographic audit logs.'
  },
  {
    slug: 'advertising',
    url: '/apps/advertising',
    title: 'Closed-Loop Ad Attribution & ROAS Tracking',
    category: 'Ad Analytics',
    description: 'Real-time multi-network ad spend attribution matched directly to bank deposit revenue across Meta, Google, and TikTok ads.'
  },
  {
    slug: 'projects-and-tasks',
    url: '/apps/projects-and-tasks',
    title: 'Agile Kanban Sprints & Billable Time Tracking',
    category: 'Project Management',
    description: 'Hardware-accelerated project boards, milestone roadmaps, client approval portals, and employee timelog ledger integration.'
  },
  {
    slug: 'hr-management',
    url: '/apps/hr-management',
    title: 'Enterprise HRMS, Leave Directory & Payroll',
    category: 'People Ops',
    description: 'Digital time clocking, leave requests, employee records, compensation tiers, and automated multi-currency payroll calculations.'
  },
  {
    slug: 'finance',
    url: '/apps/finance',
    title: 'Automated Invoicing & Multi-Entity Ledger',
    category: 'Finance & Invoicing',
    description: 'Recurring B2B retainer subscriptions via Stripe, automated late reminders, cash flow forecasting, and expense balance sheets.'
  },
  {
    slug: 'communications',
    url: '/apps/communications',
    title: 'Encrypted Team Chat & HD WebRTC Meetings',
    category: 'Collaboration',
    description: 'Sub-50ms team messaging, direct channels, and embedded WebRTC 4K meetings with real-time screen sharing and AI transcripts.'
  },
  {
    slug: 'workspace-tools',
    url: '/apps/workspace-tools',
    title: '180 Docs, Shared Calendar & Cloud Drive',
    category: 'Workspace Tools',
    description: 'Zero-knowledge document vaults, collaborative block editing, team scheduling, and sovereign cloud drive file synchronization.'
  }
];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Features', url: '/features' }
];
---

<Layout 
  title="Features & Integrated Ecosystem | 180workspace"
  description="Explore the 8 integrated business applications of 180workspace: CRM, Projects, Finance, Voiceforce AI telephony, HR, Comms & cloud storage on one Work Graph."
  breadcrumbs={breadcrumbs}
>
  <main class="w-full relative">
    
    <!-- Hero -->
    <section class="relative pt-24 pb-16 md:pt-36 md:pb-20 overflow-hidden">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-gradient-to-tr from-indigo-500/15 to-violet-500/10 blur-[120px] rounded-full pointer-events-none -z-10"></div>
      <div class="absolute inset-0 bg-grid-pattern dark:bg-grid-pattern-dark [mask-image:radial-gradient(ellipse_70%_60%_at_50%_10%,#000_60%,transparent_100%)] -z-20"></div>

      <div class="container mx-auto px-4 max-w-5xl text-center">
        
        <div class="flex justify-center mb-6">
          <Breadcrumb items={breadcrumbs} />
        </div>

        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800 shadow-sm mb-6">
          <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Unified Work Graph Ecosystem</span>
        </div>

        <h1 class="display-h1 max-w-4xl mx-auto mb-6">
          8 Integrated Applications. <span class="bg-gradient-to-r from-indigo-600 via-violet-600 to-pink-600 bg-clip-text text-transparent">Zero Context Switching.</span>
        </h1>
        <p class="body-lead max-w-3xl mx-auto">
          Discover the powerful suite of native business applications designed to streamline every aspect of your agency's operations on one connected database.
        </p>
      </div>
    </section>

    <!-- Features Grid -->
    <section class="py-8 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {(apps.length > 0 ? apps : defaultFeatures).map(app => (
          <a href={app.url || `/features/${app.slug}`} class="glass-card-interactive p-6 flex flex-col justify-between group hover:border-indigo-500/50 hover:shadow-xl transition-all">
            <div>
              <div class="mb-4">
                <span class="badge-pill text-[10px] py-1 px-2.5 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-400 border-indigo-200/60 dark:border-indigo-800">
                  {app.category || "Feature Spotlight"}
                </span>
              </div>
              <h2 class="text-base font-bold text-slate-950 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mb-2.5 leading-snug">
                {app.title || app.heroHeadline || app.seoTitle}
              </h2>
              <p class="body-standard text-xs text-slate-600 dark:text-zinc-400 mb-6 leading-relaxed">
                {app.description || app.seoDescription || "Learn more about how this app integrates into the Work Graph."}
              </p>
            </div>
            <div class="flex items-center text-xs font-bold text-indigo-600 dark:text-indigo-400 gap-1.5 group-hover:gap-2.5 transition-all pt-4 border-t border-slate-100 dark:border-white/10">
              <span>Explore Capability</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Bottom CTA -->
    <AppBottomCTA 
      appName="180workspace"
      headline="Ready to run your entire company on one Work Graph?"
      subheadline="Start your free 14-day trial today. Instant setup, no credit card required."
    />

  </main>
</Layout>
