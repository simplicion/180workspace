---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import AppBottomCTA from '../../components/apps/AppBottomCTA.astro';

const saasUrl = import.meta.env.PUBLIC_SAAS_URL || 'https://app.180workspace.com';

const apiEndpoints = [
  {
    method: "POST",
    path: "/api/v1/identity/auth/login",
    desc: "Authenticate user and receive JWT bearer token and refresh tokens.",
    tag: "Auth"
  },
  {
    method: "GET",
    path: "/api/v1/crm-and-sales/deals",
    desc: "List and filter active sales pipeline deals with revenue weighting.",
    tag: "CRM"
  },
  {
    method: "POST",
    path: "/api/v1/projects-and-tasks/tasks",
    desc: "Programmatically create sprint tasks, set assignees, and deadlines.",
    tag: "Projects"
  },
  {
    method: "POST",
    path: "/api/v1/traffic-director/evaluate/:slug",
    desc: "Edge-based real-time traffic evaluation & bot shielding endpoint.",
    tag: "Edge"
  },
  {
    method: "POST",
    path: "/api/v1/finance/invoices",
    desc: "Generate custom invoices and receive hosted Stripe payment links.",
    tag: "Finance"
  },
  {
    method: "POST",
    path: "/api/v1/ai/meetings/process",
    desc: "Upload meeting transcripts or audio for autonomous task extraction.",
    tag: "AI"
  }
];

const sdkFeatures = [
  {
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>',
    title: "Work Graph Event Triggers",
    description: "Every API mutation triggers real-time Work Graph events across all 15 connected apps automatically."
  },
  {
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>',
    title: "HMAC-SHA256 Webhooks",
    description: "Outbound webhook payloads are signed with HMAC-SHA256 for tamper-proof verification."
  },
  {
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/>',
    title: "Sub-50ms Global Latency",
    description: "Endpoints route through Cloudflare Edge for sub-50ms response times worldwide."
  },
  {
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>',
    title: "Tenant-Isolated by Default",
    description: "Every request is scoped to your company tenant. Cross-tenant data access is impossible."
  }
];
---

<Layout 
  title="Developer Portal & REST API Reference | 180workspace"
  description="Explore the 180workspace REST API, real-time webhooks, SDKs, and custom domain integrations to extend your business operating system."
>
  <main class="w-full relative">
    
    {/* Developer Hero */}
    <section class="pt-24 pb-20 md:pt-36 md:pb-32 relative overflow-hidden bg-slate-950 text-white">
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[600px] bg-gradient-to-tr from-indigo-600/20 via-violet-600/15 to-transparent blur-[140px] rounded-full pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-indigo-500/40 to-transparent"></div>
      <div class="absolute inset-0 bg-grid-pattern-dark [mask-image:radial-gradient(ellipse_70%_60%_at_50%_10%,#000_60%,transparent_100%)]"></div>
      
      <div class="container mx-auto px-4 max-w-5xl text-center relative z-10">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/5 backdrop-blur-xl border border-white/10 shadow-lg shadow-indigo-500/5 mb-8">
          <span class="flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-300">Platform REST API v1.0 -- Live</span>
        </div>

        <h1 class="display-h1 text-white mb-8">
          Build on the <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-violet-400 to-pink-400">180 Work Graph.</span>
        </h1>

        <p class="body-lead text-slate-400 max-w-3xl mx-auto mb-12">
          Programmatically manage CRM pipelines, provision project sprints, trigger edge traffic evaluation, and automate invoice payments with our clean REST API and real-time Webhooks.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href={`${saasUrl}/signup`} class="btn-primary w-full sm:w-auto">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
            <span>Get Free API Key</span>
          </a>
          <a href="#endpoints" class="btn-secondary bg-white/5 border-slate-700 text-white hover:bg-white/10 w-full sm:w-auto">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
            <span>Explore Endpoints</span>
          </a>
        </div>

        {/* Metrics bar */}
        <div class="mt-14 grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-3xl mx-auto">
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-black text-white">6</div>
            <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mt-1">API Modules</div>
          </div>
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-black text-white">&lt;50ms</div>
            <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mt-1">Avg Latency</div>
          </div>
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-black text-white">99.99%</div>
            <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mt-1">Uptime SLA</div>
          </div>
          <div class="text-center">
            <div class="text-2xl sm:text-3xl font-black text-white">REST</div>
            <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mt-1">JSON Standard</div>
          </div>
        </div>
      </div>
    </section>

    {/* SDK Features Grid */}
    <section class="py-16 md:py-24 bg-slate-50 dark:bg-slate-950 border-b border-slate-200/80 dark:border-slate-800">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {sdkFeatures.map((feat) => (
            <div class="glass-card p-6 hover:border-indigo-300 dark:hover:border-indigo-700 transition-all duration-300">
              <div class="w-11 h-11 rounded-2xl bg-indigo-50 dark:bg-indigo-950/80 border border-indigo-100 dark:border-indigo-800 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={feat.iconSvg}></svg>
              </div>
              <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-2">{feat.title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{feat.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Interactive Code Section */}
    <section class="py-20 md:py-28 bg-slate-50/70 dark:bg-slate-900/40 border-y border-slate-200/80 dark:border-slate-800 relative overflow-hidden">
      <div class="absolute top-1/2 left-0 w-[400px] h-[400px] bg-indigo-500/5 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 max-w-6xl relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          
          <div class="lg:col-span-5">
            <div class="text-eyebrow text-indigo-600 dark:text-indigo-400 mb-3">Developer Experience</div>
            <h2 class="section-h2 text-slate-950 dark:text-white text-3xl sm:text-4xl mb-5">
              Simple REST endpoints. Instant Work Graph execution.
            </h2>
            <p class="body-standard text-slate-600 dark:text-slate-400 mb-8">
              Every API call is secured with Bearer token authentication and strictly isolated to your company tenant. Creating a deal programmatically triggers the same powerful Work Graph events as the web app.
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="text-sm text-slate-700 dark:text-slate-300 font-medium">Standard JSON request and response payloads</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="text-sm text-slate-700 dark:text-slate-300 font-medium">HMAC-SHA256 signature verification on outbound Webhooks</span>
              </li>
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="text-sm text-slate-700 dark:text-slate-300 font-medium">Sub-50ms endpoint latency across global Cloudflare Edge</span>
              </li>
            </ul>
          </div>

          <div class="lg:col-span-7">
            <div class="rounded-3xl border border-slate-700/80 bg-slate-950 shadow-2xl shadow-indigo-950/30 overflow-hidden">
              {/* Terminal Chrome */}
              <div class="flex items-center justify-between px-5 py-3.5 border-b border-slate-800 bg-slate-900/60">
                <div class="flex items-center gap-2.5">
                  <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
                  <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
                  <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
                  <span class="ml-3 text-xs font-mono text-slate-400">CreateDeal.ts</span>
                </div>
                <span class="text-[10px] bg-indigo-950/80 border border-indigo-800/60 px-2.5 py-1 rounded-lg text-indigo-300 font-bold font-mono">POST /api/v1/crm-and-sales/deals</span>
              </div>
              {/* Code Content */}
              <div class="p-5 sm:p-6 overflow-x-auto">
                <pre class="text-xs sm:text-[13px] leading-relaxed font-mono"><code><span class="text-purple-400">import</span> <span class="text-slate-300">{'{'}</span> <span class="text-sky-300">WorkspaceClient</span> <span class="text-slate-300">{'}'}</span> <span class="text-purple-400">from</span> <span class="text-emerald-400">'@180workspace/sdk'</span><span class="text-slate-500">;</span>

<span class="text-purple-400">const</span> <span class="text-sky-300">client</span> <span class="text-slate-400">=</span> <span class="text-purple-400">new</span> <span class="text-amber-300">WorkspaceClient</span><span class="text-slate-300">({'{'}</span>
  <span class="text-sky-300">apiKey</span><span class="text-slate-400">:</span> <span class="text-slate-300">process.env.</span><span class="text-amber-200">WORKSPACE_API_KEY</span>
<span class="text-slate-300">{'}'})</span><span class="text-slate-500">;</span>

<span class="text-slate-600">// Create a new deal and trigger Work Graph execution</span>
<span class="text-purple-400">const</span> <span class="text-sky-300">deal</span> <span class="text-slate-400">=</span> <span class="text-purple-400">await</span> <span class="text-slate-300">client.crm.</span><span class="text-amber-300">createDeal</span><span class="text-slate-300">({'{'}</span>
  <span class="text-sky-300">title</span><span class="text-slate-400">:</span> <span class="text-emerald-400">'Enterprise Cloud Migration'</span><span class="text-slate-500">,</span>
  <span class="text-sky-300">amount</span><span class="text-slate-400">:</span> <span class="text-amber-300">45000</span><span class="text-slate-500">,</span>
  <span class="text-sky-300">stage</span><span class="text-slate-400">:</span> <span class="text-emerald-400">'PROPOSAL_SENT'</span><span class="text-slate-500">,</span>
  <span class="text-sky-300">contactEmail</span><span class="text-slate-400">:</span> <span class="text-emerald-400">'cto@acmecorp.com'</span>
<span class="text-slate-300">{'}'})</span><span class="text-slate-500">;</span>

<span class="text-slate-300">console.</span><span class="text-amber-300">log</span><span class="text-slate-300">(</span><span class="text-emerald-400">'Deal created with ID:'</span><span class="text-slate-500">,</span> <span class="text-slate-300">deal.id</span><span class="text-slate-300">)</span><span class="text-slate-500">;</span></code></pre>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    {/* Endpoints Table Section */}
    <section id="endpoints" class="py-20 md:py-28 bg-white dark:bg-slate-950">
      <div class="container mx-auto px-4 max-w-5xl">
        <SectionHeader 
          badge="REST API v1 Reference"
          title="Core API Endpoints"
          subtitle="Standard HTTP endpoints available across all platform modules."
        />

        <div class="space-y-3">
          {apiEndpoints.map((ep) => (
            <div class="bg-slate-50 dark:bg-slate-900/80 rounded-2xl p-5 sm:p-6 border border-slate-200/80 dark:border-slate-800 hover:border-indigo-300 dark:hover:border-indigo-700 transition-all duration-200 hover:shadow-lg hover:shadow-indigo-500/5 group">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <span class={`px-3 py-1.5 rounded-lg font-mono font-bold text-xs tracking-wide ${ep.method === 'POST' ? 'bg-indigo-100 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800' : 'bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800'}`}>
                    {ep.method}
                  </span>
                  <span class="font-mono font-bold text-sm text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">{ep.path}</span>
                </div>
                <span class="px-2.5 py-1 rounded-lg bg-slate-200/60 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-[10px] font-bold uppercase tracking-wider shrink-0 w-fit">
                  {ep.tag}
                </span>
              </div>
              <p class="text-sm text-slate-500 dark:text-slate-400 mt-3 font-medium">{ep.desc}</p>
            </div>
          ))}
        </div>

        <div class="mt-10 text-center">
          <a href={`${saasUrl}/signup`} class="btn-primary">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            <span>View Full API Documentation</span>
          </a>
        </div>
      </div>
    </section>

    {/* Bottom CTA */}
    <AppBottomCTA 
      appName="Developers" 
      headline="Start building with the 180workspace API today."
      subheadline="Create your developer account, generate API keys, and build custom integrations in minutes."
    />

  </main>
</Layout>
