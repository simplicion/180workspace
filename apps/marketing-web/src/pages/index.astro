---
import Layout from '../layouts/Layout.astro';

// We can define the SaaS base URL here as well
const saasUrl = import.meta.env.PUBLIC_SAAS_URL || 'http://localhost:3002';
---

<Layout title="180workspace | The Ultimate Work Graph Architecture">
  <main class="w-full relative">
    {/* Grid Background */}
    <div class="absolute inset-0 bg-grid-pattern [mask-image:linear-gradient(to_bottom,white,transparent)] -z-10 h-[120vh]"></div>

    <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden px-4">
      <!-- Glow effect -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-indigo-500/10 blur-[100px] rounded-full -z-10"></div>
      
      <div class="relative z-10 text-center max-w-5xl mx-auto pt-20">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-gray-200 shadow-sm mb-8 animate-fade-in">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
          <span class="text-sm font-medium text-gray-700">The new 180workspace is live</span>
        </div>

        <h1 class="text-5xl md:text-7xl font-black tracking-tight mb-8 text-gray-950 leading-tight">
          Run your entire agency on one <span class="text-indigo-600">unified platform.</span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-600 mb-12 max-w-3xl mx-auto leading-relaxed font-medium">
          Eliminate software fragmentation. Connect your CRM, HR, Projects, and Finance in a single powerful work graph.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href={`${saasUrl}/signup`} class="w-full sm:w-auto inline-flex h-14 items-center justify-center rounded-full bg-indigo-600 px-8 text-lg font-bold text-white shadow-xl shadow-indigo-600/20 transition-all hover:bg-indigo-700 hover:scale-105 hover:shadow-2xl">
            Start your workspace
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
          <a href="#features" class="w-full sm:w-auto inline-flex h-14 items-center justify-center rounded-full border border-gray-200 bg-white px-8 text-lg font-bold text-gray-700 shadow-sm transition-all hover:bg-gray-50 hover:border-gray-300">
            Explore Features
          </a>
        </div>
      </div>
    </section>

    <!-- Bento Box Features Grid -->
    <section id="features" class="w-full py-24 px-4 sm:px-6 lg:px-8 bg-white/50 backdrop-blur-3xl">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-black text-gray-950 tracking-tight mb-4">Eliminate chaos. Scale with confidence.</h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto font-medium">Stop duct-taping your business together. 180workspace provides everything you need natively, so your team can focus on growth.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Feature 1 -->
          <a href="/features/crm-and-sales-software" class="col-span-1 md:col-span-2 lg:col-span-2 bg-white rounded-3xl p-8 border border-gray-200 hover:border-indigo-300 transition-colors group overflow-hidden relative shadow-xl shadow-indigo-900/5 block">
            <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl -mr-20 -mt-20 group-hover:bg-indigo-500/20 transition-all"></div>
            <div class="w-14 h-14 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center mb-6 border border-indigo-200">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-950 tracking-tight mb-3 group-hover:text-indigo-600 transition-colors">CRM & Sales Pipeline</h3>
            <p class="text-gray-600 text-lg max-w-md font-medium">Stop letting leads slip through the cracks. Manage client relationships, track pipelines, and close deals faster.</p>
          </a>

          <!-- Feature 2 -->
          <a href="/features/hr-management-system" class="bg-white rounded-3xl p-8 border border-gray-200 hover:border-emerald-300 transition-colors group relative overflow-hidden shadow-xl shadow-indigo-900/5 block">
            <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl -mr-20 -mt-20 group-hover:bg-emerald-500/20 transition-all"></div>
            <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center mb-6 border border-emerald-200">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-950 tracking-tight mb-3 group-hover:text-emerald-600 transition-colors">HR Management</h3>
            <p class="text-gray-600 text-lg font-medium">Automate onboarding, track time off, and manage your entire workforce seamlessly.</p>
          </a>

          <!-- Feature 3 -->
          <a href="/features/project-management-tool" class="bg-white rounded-3xl p-8 border border-gray-200 hover:border-blue-300 transition-colors group relative overflow-hidden shadow-xl shadow-indigo-900/5 block">
            <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl -mr-20 -mt-20 group-hover:bg-blue-500/20 transition-all"></div>
            <div class="w-14 h-14 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center mb-6 border border-blue-200">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"></path></svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-950 tracking-tight mb-3 group-hover:text-blue-600 transition-colors">Projects & Tasks</h3>
            <p class="text-gray-600 text-lg font-medium">Keep your team aligned and deliver on time with robust kanban boards and project tracking.</p>
          </a>

          <!-- Feature 4 -->
          <a href="/features/invoicing-and-finance" class="bg-white rounded-3xl p-8 border border-gray-200 hover:border-amber-300 transition-colors group relative overflow-hidden shadow-xl shadow-indigo-900/5 block">
            <div class="absolute top-0 right-0 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl -mr-20 -mt-20 group-hover:bg-amber-500/20 transition-all"></div>
            <div class="w-14 h-14 bg-amber-100 text-amber-600 rounded-2xl flex items-center justify-center mb-6 border border-amber-200">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-950 tracking-tight mb-3 group-hover:text-amber-600 transition-colors">Finance & Assets</h3>
            <p class="text-gray-600 text-lg font-medium">Monitor expenses, track revenue, and manage company assets seamlessly.</p>
          </a>

          <!-- Feature 5 -->
          <a href="/features/agency-analytics-dashboard" class="bg-white rounded-3xl p-8 border border-gray-200 hover:border-pink-300 transition-colors group relative overflow-hidden shadow-xl shadow-indigo-900/5 block">
            <div class="absolute top-0 right-0 w-64 h-64 bg-pink-500/10 rounded-full blur-3xl -mr-20 -mt-20 group-hover:bg-pink-500/20 transition-all"></div>
            <div class="w-14 h-14 bg-pink-100 text-pink-600 rounded-2xl flex items-center justify-center mb-6 border border-pink-200">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-950 tracking-tight mb-3 group-hover:text-pink-600 transition-colors">Deep Insights</h3>
            <p class="text-gray-600 text-lg font-medium">Make data-driven decisions with real-time reports and analytics across all your operations.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="w-full py-24 px-4 text-center">
      <h2 class="text-4xl md:text-5xl font-black tracking-tight text-gray-950 mb-6">Stop paying the fragmentation tax.</h2>
      <p class="text-xl text-gray-600 font-medium mb-10 max-w-2xl mx-auto">Join forward-thinking businesses who have consolidated their tech stack and accelerated their growth.</p>
      <a href={`${saasUrl}/signup`} class="inline-flex px-10 py-5 text-lg font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-full shadow-xl hover:shadow-2xl transition-all transform hover:-translate-y-1">
        Create your free account
      </a>
    </section>

    <!-- Schema.org Organization Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "180workspace",
        "url": "https://180workspace.com",
        "logo": "https://180workspace.com/logo.png",
        "description": "The ultimate SaaS ecosystem for digital agencies.",
        "sameAs": [
          "https://twitter.com/180workspace",
          "https://linkedin.com/company/180workspace"
        ]
      }
    </script>
  </main>
</Layout>
