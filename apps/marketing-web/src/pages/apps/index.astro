---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/ui/Badge.astro';
import AppBottomCTA from '../../components/apps/AppBottomCTA.astro';

const saasUrl = import.meta.env.PUBLIC_SAAS_URL || 'https://app.180workspace.com';

const appCategories = [
  {
    name: "Revenue & Growth",
    description: "Convert high-value leads, deploy autonomous AI calling agents, and track true ad ROI.",
    apps: [
      {
        name: "Voiceforce (AI Calling)",
        slug: "voiceforce",
        badge: "Launch Offer Rs 999",
        variant: "crm" as const,
        description: "Autonomous AI phone agents with sub-200ms Cartesia voice streaming. Connect your BYOK LLM, rent global DIDs, and automate calls 24/7.",
        capabilities: ["Sub-200ms Voice Stream", "BYOK OpenAI & Groq", "Rs 999 Starter Pack", "Live CRM Tool Calls"],
        iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>'
      },
      {
        name: "CRM & Sales Pipeline",
        slug: "crm-and-sales",
        badge: "Most Popular",
        variant: "crm" as const,
        description: "Visual deal pipelines, automated follow-ups, client interaction timelines, and legally-binding contract e-signatures.",
        capabilities: ["Custom Pipelines", "Lead Scoring", "Proposal Signatures", "Activity Feeds"],
        iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>'
      },
      {
        name: "Advertising & Campaign ROI",
        slug: "advertising",
        badge: "Marketing Attribution",
        variant: "crm" as const,
        description: "Multi-platform ad spend aggregation versus closed-won CRM revenue for true marketing ROI attribution.",
        capabilities: ["Ad Spend Sync", "True ROI Calculation", "Campaign Optimization", "Conversion Attribution"],
        iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>'
      }
    ]
  },
  {
    name: "Operations & Workforce",
    description: "Manage projects, agile team sprints, cash flow, and complete employee lifecycles.",
    apps: [
      {
        name: "Projects & Tasks",
        slug: "projects-and-tasks",
        badge: "Essential",
        variant: "projects" as const,
        description: "Sprint planning, visual Kanban boards, milestone Gantt timelines, task dependencies, and billable work logs.",
        capabilities: ["Kanban & Gantt", "Subtask Hierarchies", "Work Log Approvals", "Milestone Tracking"],
        iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>'
      },
      {
        name: "HR Management & Payroll",
        slug: "hr-management",
        badge: "Workforce",
        variant: "hr" as const,
        description: "Employee directories, multi-tier leave approvals, payroll structures, attendance tracking, and performance reviews.",
        capabilities: ["Employee Onboarding", "Leave Accruals", "Payroll Structures", "Performance Reviews"],
        iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>'
      },
      {
        name: "Finance, Invoicing & Ledger",
        slug: "finance",
        badge: "Invoicing & Cashflow",
        variant: "finance" as const,
        description: "Automated invoice generation, multi-currency cash flow forecasting, expense tracking, and vendor bill schedules.",
        capabilities: ["Smart Invoices", "Receipt Scanning", "Vendor Schedules", "Cash Flow Analytics"],
        iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>'
      }
    ]
  },
  {
    name: "Tools & Team Collaboration",
    description: "Connect your team with real-time video, chat, cloud storage, and collaborative documents.",
    apps: [
      {
        name: "Communications & HD Meetings",
        slug: "communications",
        badge: "HD WebRTC",
        variant: "comms" as const,
        description: "Zero-context-switching team messaging, HD video calls with Picture-in-Picture, unified email inboxes, and channels.",
        capabilities: ["Direct & Channel Chat", "HD Video Meetings", "Picture-in-Picture", "Unified Email Sync"],
        iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>'
      },
      {
        name: "Workspace Tools & Cloud Drive",
        slug: "workspace-tools",
        badge: "Docs & Files",
        variant: "tools" as const,
        description: "Collaborative 180 Documents, enterprise cloud storage, document template engines, and legally-binding e-signatures.",
        capabilities: ["180 Rich Documents", "Cloud Storage", "PDF Generation", "Template Engines"],
        iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>'
      }
    ]
  }
];
---

<Layout 
  title="All 8 Applications & Work Graph Modules | 180workspace"
  description="Explore the 8 native applications integrated into the 180workspace business operating system. From CRM to Projects, HR, Finance, Voiceforce AI, and Communications."
>
  <main class="w-full relative">
    
    {/* Hero Section */}
    <section class="pt-24 pb-16 md:pt-32 md:pb-20 text-center relative overflow-hidden">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-indigo-500/10 blur-[100px] rounded-full pointer-events-none -z-10"></div>
      
      <div class="container mx-auto px-4 max-w-5xl">
        <Badge text="The Complete Work Graph Suite" variant="crm" pulse class="mb-6" />

        <h1 class="display-h1 mb-6">
          8 specialized apps. <br /><span class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 bg-clip-text text-transparent">One unified operating system.</span>
        </h1>

        <p class="body-lead max-w-3xl mx-auto mb-10">
          Say goodbye to fragmented logins, chaotic CSV exports, and expensive subscription bloat. 180workspace delivers the 8 core operational applications your business needs, natively connected on one Work Graph.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3 text-xs font-bold text-slate-500 uppercase tracking-wider">
          <span class="px-3.5 py-1.5 rounded-xl bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-sm backdrop-blur-md">8 Connected Applications</span>
          <span class="px-3.5 py-1.5 rounded-xl bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-sm backdrop-blur-md">Single Unified Database</span>
          <span class="px-3.5 py-1.5 rounded-xl bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-sm backdrop-blur-md">Instant Cross-App Sync</span>
        </div>
      </div>
    </section>

    {/* App Directory Categories */}
    <section class="py-12 md:py-16">
      <div class="container mx-auto px-4 max-w-7xl space-y-20">
        {appCategories.map((cat) => (
          <div>
            <div class="mb-8 border-b border-slate-200/80 dark:border-slate-800 pb-4">
              <h2 class="section-h2">
                {cat.name}
              </h2>
              <p class="body-standard mt-1">
                {cat.description}
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {cat.apps.map((app) => (
                <a 
                  href={`/apps/${app.slug}`} 
                  class="glass-card-interactive p-6 flex flex-col justify-between group"
                >
                  <div>
                    <div class="flex items-center justify-between mb-4">
                      <div class="w-11 h-11 p-2.5 bg-slate-50 dark:bg-slate-800/80 rounded-2xl border border-slate-100 dark:border-slate-800 flex items-center justify-center text-slate-800 dark:text-slate-200 group-hover:scale-110 transition-transform duration-300">
                        <svg class="w-6 h-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={app.iconSvg}></svg>
                      </div>
                      {app.badge && (
                        <Badge text={app.badge} variant={app.variant} size="sm" />
                      )}
                    </div>

                    <h3 class="card-h3 mb-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                      {app.name}
                    </h3>

                    <p class="body-standard line-clamp-3 mb-6">
                      {app.description}
                    </p>
                  </div>

                  <div>
                    <div class="flex flex-wrap gap-1.5 border-t border-slate-100 dark:border-slate-800 pt-4 mb-4">
                      {app.capabilities.slice(0, 3).map((cap) => (
                        <span class="text-[10px] font-semibold bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 px-2 py-0.5 rounded-md">
                          {cap}
                        </span>
                      ))}
                    </div>

                    <div class="text-xs font-bold text-indigo-600 dark:text-indigo-400 flex items-center justify-between group-hover:translate-x-1 transition-transform">
                      <span>Explore App Guide</span>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* Bottom Conversion CTA */}
    <AppBottomCTA 
      appName="Platform" 
      headline="Unlock all 8 applications with one simple workspace."
      subheadline="Start your 14-day free trial on the $12 Momentum plan today. Onboard your entire team in under 3 minutes."
    />

  </main>
</Layout>
