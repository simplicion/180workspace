---

<Layout 
  title="All Applications & Work Graph Modules | 180workspace"
  description="Explore all 15 native applications integrated into the 180workspace business operating system. From CRM to HR, Finance, and Edge Traffic Routing."
>
  <main class="w-full relative">
    
    {/* Hero Section */}
    <section class="pt-24 pb-16 md:pt-32 md:pb-20 text-center relative overflow-hidden">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-indigo-500/10 blur-[100px] rounded-full pointer-events-none -z-10"></div>
      
      <div class="container mx-auto px-4 max-w-5xl">
        <Badge text="The Complete Work Graph Suite" variant="crm" pulse class="mb-6" />

        <h1 class="display-h1 mb-6">
          15 powerful apps. <br /><span class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 bg-clip-text text-transparent">One unified operating system.</span>
        </h1>

        <p class="body-lead max-w-3xl mx-auto mb-10">
          Say goodbye to 15 different logins, chaotic CSV exports, and expensive subscription bloat. 180workspace delivers every core tool your business needs, natively connected.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3 text-xs font-bold text-slate-500 uppercase tracking-wider">
          <span class="px-3.5 py-1.5 rounded-xl bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-sm backdrop-blur-md">15 Integrated Apps</span>
          <span class="px-3.5 py-1.5 rounded-xl bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-sm backdrop-blur-md">Single Unified Database</span>
          <span class="px-3.5 py-1.5 rounded-xl bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-sm backdrop-blur-md">Autonomous AI Copilot</span>
        </div>
      </div>
    </section>

    {/* App Directory Categories */}
    <section class="py-12 md:py-16">
      <div class="container mx-auto px-4 max-w-7xl space-y-20">
        {appCategories.map((cat) => (
          <div>
            <div class="mb-8 border-b border-slate-200/80 dark:border-slate-800 pb-4">
              <h2 class="section-h2">
                {cat.name}
              </h2>
              <p class="body-standard mt-1">
                {cat.description}
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
              {cat.apps.map((app) => (
                <a 
                  href={`/apps/${app.slug}`} 
                  class="glass-card-interactive p-6 flex flex-col justify-between group"
                >
                  <div>
                    <div class="flex items-center justify-between mb-4">
                      <div class="w-11 h-11 p-2.5 bg-slate-50 dark:bg-slate-800/80 rounded-2xl border border-slate-100 dark:border-slate-800 flex items-center justify-center text-slate-800 dark:text-slate-200 group-hover:scale-110 transition-transform duration-300">
                        <svg class="w-6 h-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={app.iconSvg}></svg>
                      </div>
                      {app.badge && (
                        <Badge text={app.badge} variant={app.variant} size="sm" />
                      )}
                    </div>

                    <h3 class="card-h3 mb-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                      {app.name}
                    </h3>

                    <p class="body-standard line-clamp-3 mb-6">
                      {app.description}
                    </p>
                  </div>

                  <div>
                    <div class="flex flex-wrap gap-1.5 border-t border-slate-100 dark:border-slate-800 pt-4 mb-4">
                      {app.capabilities.slice(0, 3).map((cap) => (
                        <span class="text-[10px] font-semibold bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 px-2 py-0.5 rounded-md">
                          {cap}
                        </span>
                      ))}
                    </div>

                    <div class="text-xs font-bold text-indigo-600 dark:text-indigo-400 flex items-center justify-between group-hover:translate-x-1 transition-transform">
                      <span>Explore App Guide</span>
                      <span>→</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* Bottom Conversion CTA */}
    <AppBottomCTA 
      appName="Platform" 
      headline="Unlock all 15 applications with one simple workspace."
      subheadline="Start your 14-day free trial today. Onboard your entire team in under 3 minutes."
    />

  </main>
</Layout>
