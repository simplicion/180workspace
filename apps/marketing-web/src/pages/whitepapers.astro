---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import AppBottomCTA from '../components/apps/AppBottomCTA.astro';

const saasUrl = import.meta.env.PUBLIC_SAAS_URL || 'https://app.180workspace.com';

const whitepapers = [
  {
    id: "work-graph-architecture",
    title: "Work Graph Architecture: The Zero-Redundancy Operating Model",
    subtitle: "How Native Relational Nodes Replace Fragile Webhook Chains and SaaS Sprawl",
    category: "System Architecture",
    badge: "Flagship Research",
    date: "August 2026",
    pages: "24 Pages",
    format: "PDF & Technical Specification",
    abstract: "Traditional SaaS architectures force organizations to stitch disparate tools using Zapier, Make, or custom webhooks. This paper details the mathematical and structural mechanics of the 180 Work Graph—a unified schema where all 15 core business functions share atomic database nodes, guaranteeing 0ms synchronization lag and eliminating redundant subscription overhead.",
    keyPoints: [
      "Sub-12ms in-memory BullMQ queue execution for cross-departmental automations",
      "Elimination of silent webhook drops, API rate limit throttles, and partial rollback corruption",
      "Empirical cost comparison: $2,850/mo saved per 20-seat agency replacing 8 fragmented SaaS tools"
    ],
    readLink: "/blog/demystifying-work-graph-architecture",
    downloadUrl: "#"
  },
  {
    id: "sovereign-identity-ledger",
    title: "Sovereign 180 Profile: Universal Identity & Atomic Ledger Protocol",
    subtitle: "OAuth 2.0 PKCE, WhatsApp OTP Security, and Instant 1-Click Pay Settlements",
    category: "Cryptography & Fintech",
    badge: "Fintech Protocol",
    date: "September 2026",
    pages: "18 Pages",
    format: "Technical White Paper",
    abstract: "A deep dive into the cryptographic architecture of 180 Identity and Sovereign 180 Pay. Details how end-users maintain a single prepaid balance across first-party and authorized third-party developer applications with double-entry accounting guarantees, zero webhook verification vulnerabilities, and RFC 7636 PKCE code challenge enforcement.",
    keyPoints: [
      "Strict separation of OAuth authorization server and double-entry ledger domain models",
      "Zero-download developer integration with 180 Identity SDK (<4 lines of code)",
      "Instant Razorpay-backed wallet top-ups with HMAC-SHA256 server signature validation"
    ],
    readLink: "https://developers.180workspace.com/docs",
    downloadUrl: "#"
  },
  {
    id: "sub-5ms-edge-routing",
    title: "Sub-5ms Edge Traffic Evaluation & Anti-Bot Cloaking Shield",
    subtitle: "High-Throughput Bot Detection & Clean URL Cloaking on Cloudflare Workers",
    category: "Edge Infrastructure",
    badge: "Security Benchmark",
    date: "July 2026",
    pages: "16 Pages",
    format: "Performance White Paper",
    abstract: "An architectural review of the Traffic Director edge engine. Explores how custom worker scripts evaluate client user-agents, IP reputation, TLS fingerprinting, and query parameters in under 5 milliseconds to route legitimate buyers to optimized funnels while deflecting ad-bot scrapers.",
    keyPoints: [
      "Cloudflare Workers edge execution with geo-distributed Redis caching",
      "Real-time IP ASN lookup & crawler fingerprinting with zero origin server overhead",
      "Automated fallback URL rerouting and conversion pixel attribution preserving"
    ],
    readLink: "/apps/traffic-director",
    downloadUrl: "#"
  },
  {
    id: "multitenant-data-isolation",
    title: "Multitenant Data Isolation & Enterprise Compliance",
    subtitle: "Row-Level Multi-Tenancy, Automated Backups, and Zero-Leakage Architecture",
    category: "Enterprise Security",
    badge: "Governance",
    date: "June 2026",
    pages: "20 Pages",
    format: "Security White Paper",
    abstract: "Examines 180workspace's enterprise multitenancy security framework. Covers companyId tenancy middleware scoping, cryptographic token signing with RS256, immutable audit trails, and automated compliance controls ensuring zero cross-tenant contamination.",
    keyPoints: [
      "Enforced Prisma middleware and database indexing scoped by companyId",
      "Full HIPAA, GDPR & SOC2 readiness matrix with automated encryption-at-rest",
      "Isolated object storage partitioning and role-based access control (RBAC)"
    ],
    readLink: "/enterprise",
    downloadUrl: "#"
  }
];
---

<Layout 
  title="180workspace White Papers & Technical Research | Work Graph Architecture"
  description="Download technical white papers, architectural blueprints, and engineering research on the 180 Work Graph, sovereign identity protocol, and edge traffic routing."
  canonicalUrl="https://180workspace.com/whitepapers"
>
  <main class="w-full relative min-h-screen bg-slate-50 dark:bg-slate-950">
    
    <!-- Hero Header -->
    <section class="relative pt-24 pb-16 md:pt-36 md:pb-24 overflow-hidden border-b border-slate-200/80 dark:border-slate-800/80 bg-slate-950 text-white">
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-gradient-to-tr from-indigo-600/20 via-purple-600/15 to-transparent blur-[140px] rounded-full pointer-events-none -z-10"></div>
      <div class="absolute inset-0 bg-grid-pattern-dark [mask-image:radial-gradient(ellipse_70%_60%_at_50%_10%,#000_60%,transparent_100%)] -z-20"></div>

      <div class="container mx-auto px-4 max-w-5xl text-center relative z-10">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/5 backdrop-blur-xl border border-white/10 shadow-lg shadow-indigo-500/5 mb-8">
          <span class="flex h-2 w-2 rounded-full bg-indigo-400 animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-300">Engineering Publications & Research</span>
        </div>

        <h1 class="display-h1 text-white mb-6">
          Architectural <span class="bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">White Papers.</span>
        </h1>
        <p class="body-lead text-slate-400 max-w-3xl mx-auto mb-10">
          Peer-reviewed architectural blueprints, benchmark studies, and fintech protocol specifications published by the 180workspace engineering team.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-semibold text-slate-400">
          <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Verified Benchmarks</span>
          <span class="text-slate-700">•</span>
          <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Open Protocol Specs</span>
          <span class="text-slate-700">•</span>
          <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Zero Tool Fragmentation</span>
        </div>
      </div>
    </section>

    <!-- Whitepapers Collection -->
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl py-16 md:py-24">
      <div class="space-y-12">
        {whitepapers.map((paper, idx) => (
          <article 
            id={paper.id}
            class="rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl p-8 sm:p-10 lg:p-12 shadow-xl hover:shadow-2xl transition-all duration-300 relative overflow-hidden"
          >
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500"></div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
              
              {/* Left Column: Metadata & Abstract */}
              <div class="lg:col-span-8 space-y-6">
                <div class="flex flex-wrap items-center gap-3">
                  <span class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800">
                    {paper.category}
                  </span>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300">
                    {paper.badge}
                  </span>
                  <span class="text-xs text-slate-400 font-semibold tabular-nums">
                    {paper.date} • {paper.pages}
                  </span>
                </div>

                <div>
                  <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-950 dark:text-white tracking-tight leading-tight">
                    {paper.title}
                  </h2>
                  <p class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 mt-1">
                    {paper.subtitle}
                  </p>
                </div>

                <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
                  {paper.abstract}
                </p>

                {/* Key Points */}
                <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200/80 dark:border-slate-800 space-y-2.5">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white flex items-center gap-2">
                    <svg class="w-4 h-4 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>Key Architectural Findings:</span>
                  </h4>
                  <ul class="space-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
                    {paper.keyPoints.map((point) => (
                      <li class="flex items-start gap-2">
                        <span class="text-indigo-500 font-bold">•</span>
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              {/* Right Column: Actions & Quick Links */}
              <div class="lg:col-span-4 p-6 sm:p-8 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200/80 dark:border-slate-800 space-y-5 lg:sticky lg:top-24">
                <div class="flex items-center justify-between text-xs text-slate-400 pb-3 border-b border-slate-200 dark:border-slate-800 font-mono">
                  <span>SPECIFICATION</span>
                  <span class="text-emerald-500 font-bold">180 PUBLICATION</span>
                </div>

                <div class="space-y-2 text-xs text-slate-500 dark:text-slate-400">
                  <div class="flex justify-between">
                    <span>Document Format:</span>
                    <span class="font-semibold text-slate-800 dark:text-slate-200">{paper.format}</span>
                  </div>
                  <div class="flex justify-between">
                    <span>Target Audience:</span>
                    <span class="font-semibold text-slate-800 dark:text-slate-200">CTOs, Devs & Operators</span>
                  </div>
                  <div class="flex justify-between">
                    <span>Access Level:</span>
                    <span class="font-semibold text-emerald-600 dark:text-emerald-400">Open Public Access</span>
                  </div>
                </div>

                <div class="pt-3 space-y-2.5">
                  <a 
                    href={paper.readLink}
                    class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-indigo-600 via-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-bold text-xs shadow-md shadow-indigo-600/20 flex items-center justify-center gap-2 transition-all cursor-pointer"
                  >
                    <span>Read Full White Paper</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                  </a>

                  <a 
                    href="https://docs.180workspace.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full py-2.5 px-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-indigo-400 text-slate-700 dark:text-slate-300 font-semibold text-xs flex items-center justify-center gap-1.5 transition-colors"
                  >
                    <span>Explore Docs Portal</span>
                    <span class="text-indigo-500">↗</span>
                  </a>
                </div>
              </div>

            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Bottom CTA -->
    <AppBottomCTA 
      appName="Work Graph Platform" 
      headline="Deploy the Work Graph Architecture across your entire company."
      subheadline="Start with all 15 native applications unified on one schema. No webhooks, no glue code, no subscription bloat."
    />

  </main>
</Layout>
