<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const ua = navigator.userAgent.toLowerCase();
    const osCard = document.getElementById('os-detect-card');
    const osIcon = document.getElementById('detected-os-icon');
    const osText = document.getElementById('detected-os-text');
    const specsText = document.getElementById('detected-specs-text');
    const downloadBtn = document.getElementById('primary-download-btn');
    const downloadLabel = document.getElementById('primary-download-label');

    if (ua.includes('android')) {
      if (osText) osText.textContent = 'Detected: Android Device';
      if (specsText) specsText.textContent = 'Full Mobile Workspace • MediaCodec GPU Engine';
      if (downloadBtn) {
        downloadBtn.href = '/downloads/180Workspace-v1.0.apk';
        downloadBtn.setAttribute('download', '180Workspace-v1.0.apk');
        if (downloadLabel) downloadLabel.textContent = 'Download Android APK (.apk)';
      }
    } else if (ua.includes('iphone') || ua.includes('ipad') || ua.includes('ipod')) {
      if (osText) osText.textContent = 'Detected: Apple iOS / iPadOS';
      if (specsText) specsText.textContent = 'Universal Mobile Suite • Metal 3 Canvas';
      if (downloadBtn) {
        downloadBtn.href = 'https://testflight.apple.com/join/workspace180';
        downloadBtn.removeAttribute('download');
        if (downloadLabel) downloadLabel.textContent = 'Get 180 Workspace on TestFlight';
      }
    } else if (ua.includes('mac')) {
      if (osText) osText.textContent = 'Detected: macOS (Apple Silicon / Intel)';
      if (specsText) specsText.textContent = 'Full macOS Suite • Metal 3 • ProRes Engine';
      if (downloadBtn) {
        downloadBtn.href = '/downloads/180Workspace-Universal.dmg';
        downloadBtn.setAttribute('download', '180Workspace-Universal.dmg');
        if (downloadLabel) downloadLabel.textContent = 'Download 180 Workspace for Mac (.dmg)';
      }
    } else if (ua.includes('linux')) {
      if (osText) osText.textContent = 'Detected: Linux 64-bit';
      if (specsText) specsText.textContent = 'Universal Enterprise Suite • Vulkan Engine';
      if (downloadBtn) {
        downloadBtn.href = '/downloads/180Workspace-x86_64.AppImage';
        downloadBtn.setAttribute('download', '180Workspace-x86_64.AppImage');
        if (downloadLabel) downloadLabel.textContent = 'Download 180 Workspace for Linux (.AppImage)';
      }
    } else {
      if (osText) osText.textContent = 'Detected: Windows 64-bit';
      if (specsText) specsText.textContent = 'Full Workspace Suite • Direct3D 12 • Offline Vault';
      if (downloadBtn) {
        downloadBtn.href = '/downloads/180Workspace-Setup-x64.exe';
        downloadBtn.setAttribute('download', '180Workspace-Setup-x64.exe');
        if (downloadLabel) downloadLabel.textContent = 'Download 180 Workspace (.exe)';
      }
    }
  });
</script>
