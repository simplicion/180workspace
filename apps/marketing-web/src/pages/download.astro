---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import FAQAccordion from '../components/apps/FAQAccordion.astro';
import AppBottomCTA from '../components/apps/AppBottomCTA.astro';
import JSONLDSchema from '../components/apps/JSONLDSchema.astro';

const saasUrl = import.meta.env.PUBLIC_SAAS_URL || 'https://app.180workspace.com';

const downloadLinks = {
  windowsExe: '/downloads/180Workspace-Setup-x64.exe',
  windowsMsi: '/downloads/180Workspace-Setup-x64.exe',
  windowsPortable: '/downloads/180Workspace.exe',
  macArm: '/downloads/180Workspace-Universal.dmg',
  macIntel: '/downloads/180Workspace-x64.dmg',
  linuxAppImage: '/downloads/180Workspace-x86_64.AppImage',
  linuxDeb: '/downloads/180Workspace-amd64.deb',
  androidApk: '/downloads/180Workspace-v1.0.apk',
};

const desktopPlatforms = [
  {
    id: 'windows',
    name: 'Windows',
    badge: 'Windows 11 & 10 (64-bit)',
    iconSvg: '<svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.951-1.801"/></svg>',
    tagline: 'Complete 180 Workspace Enterprise Suite with Direct3D 12 & NVENC Acceleration',
    version: 'v2.0.0 Stable (x64 / ARM64)',
    size: '34.5 MB',
    fileName: '180Workspace-Setup-x64.exe',
    primaryDownload: {
      label: 'Download for Windows (.exe)',
      url: downloadLinks.windowsExe,
      sublabel: 'Full unified workspace suite • Installer & protocol registry',
    },
    alternatives: [
      { label: 'Portable Standalone (.exe)', url: downloadLinks.windowsPortable, fileName: '180Workspace.exe' },
      { label: 'Enterprise Setup (.msi)', url: downloadLinks.windowsMsi, fileName: '180Workspace-Setup-x64.exe' },
    ],
    features: [
      'Complete Workspace Suite: CRM, Chat, HD Meetings, Docs, Projects & Drive in one app',
      'Built-in 180 Media Studio with lossless 4K timeline & NVENC GPU stream-copy',
      '100% Offline-First Mode: Edit documents, leads, and timelines without internet connection',
      'Native OS integration: workspace180:// deep link protocol, system tray & dock shortcuts',
    ]
  },
  {
    id: 'mac',
    name: 'macOS',
    badge: 'macOS 12.0+ (Apple Silicon & Intel)',
    iconSvg: '<svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 1.01-2.87-.96.04-2.07.65-2.73 1.42-.56.66-.98 1.72-.94 2.76 1.07.08 2.11-.56 2.66-1.31z"/></svg>',
    tagline: 'Full Native macOS Workspace Suite with Metal 3 Hardware Compositor',
    version: 'v2.0.0 Universal Binary',
    size: '38.2 MB',
    fileName: '180Workspace-Universal.dmg',
    primaryDownload: {
      label: 'Download for Mac (Apple Silicon)',
      url: downloadLinks.macArm,
      sublabel: 'Native M1, M2, M3, M4 ARM64 execution',
    },
    alternatives: [
      { label: 'Mac with Intel Core Processor (.dmg)', url: downloadLinks.macIntel, fileName: '180Workspace-x64.dmg' },
      { label: 'Homebrew: brew install --cask 180workspace', url: '#homebrew', fileName: '' },
    ],
    features: [
      'All 17 Workspace Apps: Instant multi-tab workspace switching with zero browser lag',
      'Integrated 4K Media Studio with Metal 3 timeline compositing & ProRes hardware acceleration',
      'Native Mac Features: Spotlight deep-search, Menu Bar resident assistant & native notifications',
      'Offline encrypted local storage with automatic background cloud synchronization',
    ]
  },
  {
    id: 'linux',
    name: 'Linux',
    badge: 'Ubuntu, Debian, Fedora, Arch, Manjaro',
    iconSvg: '<svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor"><path d="M12.002 0c-4.484 0-8.118 3.634-8.118 8.118 0 2.062.772 3.945 2.046 5.378-1.571 1.638-2.616 3.844-2.616 6.292 0 .787.108 1.549.309 2.274.654.492 1.464.787 2.342.787 1.036 0 1.979-.411 2.673-1.077 1.025.545 2.199.859 3.447.859 1.258 0 2.441-.318 3.473-.871.695.666 1.637 1.089 2.672 1.089.878 0 1.688-.295 2.342-.787.201-.725.309-1.487.309-2.274 0-2.448-1.045-4.654-2.616-6.292 1.274-1.433 2.046-3.316 2.046-5.378C20.12 3.634 16.486 0 12.002 0z"/></svg>',
    tagline: 'Universal Linux Desktop Suite with Vulkan Hardware Acceleration',
    version: 'v2.0.0 x86_64 / ARM64',
    size: '36.0 MB',
    fileName: '180Workspace-x86_64.AppImage',
    primaryDownload: {
      label: 'Download AppImage (Universal)',
      url: downloadLinks.linuxAppImage,
      sublabel: 'Self-contained executable for all Linux distributions',
    },
    alternatives: [
      { label: 'Debian / Ubuntu Package (.deb)', url: downloadLinks.linuxDeb, fileName: '180Workspace-amd64.deb' },
      { label: 'RedHat / Fedora Package (.rpm)', url: downloadLinks.linuxAppImage, fileName: '180Workspace-x86_64.AppImage' },
    ],
    features: [
      'Full 180 Workspace Suite: CRM, Team Messaging, Cloud Storage, Docs & Video Studio',
      'Self-contained Universal AppImage with Wayland, X11, and DBus notification integration',
      'Vulkan & VAAPI hardware acceleration for smooth 120Hz canvas & fast video export',
      'Zero external runtime dependencies packaged inside with multi-tenant company isolation',
    ]
  }
];

const mobilePlatforms = [
  {
    id: 'android',
    name: 'Android Mobile App',
    badge: 'Android 10.0+ (Phones & Tablets)',
    iconSvg: '<svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor"><path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993.0001.5511-.4482.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5802 8.411 13.8444 8.082 12 8.082c-1.8444 0-3.5802.329-5.1368.8677L4.8409 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396"/></svg>',
    tagline: 'All-in-One Mobile Enterprise Suite with Snapdragon/Mali GPU Engine',
    version: 'v2.0.0 APK / Capacitor 8',
    size: '22.4 MB',
    fileName: '180Workspace-v1.0.apk',
    primaryDownload: {
      label: 'Download Android APK (.apk)',
      url: downloadLinks.androidApk,
      sublabel: 'Direct APK installation for Android phones & tablets',
    },
    alternatives: [
      { label: 'Get it on Google Play (Coming Soon)', url: '#play-store', fileName: '' },
      { label: 'Samsung Galaxy Store (Coming Soon)', url: '#galaxy-store', fileName: '' },
    ],
    features: [
      'Complete Mobile Workspace: Chat with teams, track CRM deals, review docs & manage tasks',
      'Mobile Media Studio: Trim, edit & export reels straight from camera roll (DCIM)',
      'Real-time push notifications for urgent customer leads, mentions, and calendar meetings',
      'Biometric security (Fingerprint / Face Unlock) with full offline cache mode',
    ]
  },
  {
    id: 'ios',
    name: 'iOS & iPadOS App',
    badge: 'iOS 16.0+ (iPhone & iPad)',
    iconSvg: '<svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 1.01-2.87-.96.04-2.07.65-2.73 1.42-.56.66-.98 1.72-.94 2.76 1.07.08 2.11-.56 2.66-1.31z"/></svg>',
    tagline: 'Enterprise Workspace Suite with Apple VideoToolbox & Metal 3',
    version: 'v2.0.0 TestFlight Beta',
    size: '26.1 MB',
    fileName: '',
    primaryDownload: {
      label: 'Join iOS TestFlight Beta',
      url: 'https://testflight.apple.com/join/workspace180',
      sublabel: 'Available on iPhone, iPad, and iPad Pro with Apple Pencil support',
    },
    alternatives: [
      { label: 'Download on Apple App Store (Coming Soon)', url: '#app-store', fileName: '' },
      { label: 'Install as iOS Home Screen PWA', url: '#pwa', fileName: '' },
    ],
    features: [
      'Universal iOS Workplace: Unified pipeline for messages, documents, meetings & CRM',
      'Integrated Mobile Studio: 4K ProRes timeline editing with Apple Pencil precision scrub',
      'Live Activities & Dynamic Island updates for render jobs, calls, and task deadlines',
      'Offline-first encrypted vault with bi-directional cloud synchronization',
    ]
  }
];

const featureComparison = [
  {
    feature: 'Complete Workspace Apps Included',
    web: 'All 17 Apps (Browser Tabs)',
    pwa: 'All 17 Apps (Cached Window)',
    mobile: 'All 17 Apps (Mobile Native UI)',
    native: 'All 17 Apps + Native Desktop Engine',
    highlight: true,
  },
  {
    feature: 'Offline Work & Document Storage',
    web: 'Requires Active Internet',
    pwa: 'Cached UI Only',
    mobile: 'Full Mobile Offline Cache',
    native: '100% Offline-First Encrypted Vault',
    highlight: true,
  },
  {
    feature: 'Integrated 4K Media Studio Engine',
    web: '30 FPS (Browser Canvas API)',
    pwa: '45-60 FPS (ServiceWorker Cache)',
    mobile: '60 FPS (MediaCodec / VideoToolbox)',
    native: '>500 FPS (NVENC, AMF, Metal Stream-Copy)',
    highlight: true,
  },
  {
    feature: 'Direct Local Storage (4K Ingestion)',
    web: 'Cloud Upload Wait (Minutes)',
    pwa: 'Cloud Upload Wait (Minutes)',
    mobile: 'Direct Mobile Storage / DCIM (Instant)',
    native: 'Direct NVMe SSD Access (Zero Cloud Upload)',
    highlight: true,
  },
  {
    feature: 'Deep OS Protocol (workspace180://)',
    web: 'Browser Tab Only',
    pwa: 'App Window Launch',
    mobile: 'Universal Deep Links',
    native: 'Native OS Registry Protocol & System Tray',
    highlight: false,
  },
  {
    feature: 'RAM & Resource Footprint',
    web: '1.2+ GB (Browser Overhead)',
    pwa: '400 MB (Chromium Process)',
    mobile: '80 MB (Capacitor Container)',
    native: '<60 MB (Ultra-lightweight Native Host)',
    highlight: false,
  }
];

const faqs = [
  {
    question: 'What is the 180 Workspace Native Desktop App?',
    answer: 'The 180 Workspace Native Desktop App is the full unified desktop application for Windows, macOS, and Linux. It packages the entire 180 Workspace platform—including CRM, Video Meetings, Team Chat, Cloud Drive, Document Editor, Projects & Sprints, HR Portal, and the Autonomous Media Studio—into a single high-performance desktop application with offline-first synchronization, native system notifications, and direct GPU hardware acceleration.'
  },
  {
    question: 'Is this download just for the video editor or the whole workspace?',
    answer: 'The installer provides the complete 180 Workspace platform. You get immediate access to all 17 integrated workspace apps plus the built-in GPU-accelerated Media Studio engine, so you never have to juggle multiple separate apps or browser tabs.'
  },
  {
    question: 'Can I use the desktop application completely offline?',
    answer: 'Yes! The 180 Workspace Native App includes local document compilers, offline task management, local media timeline engines, and local encrypted cache. You can manage your CRM pipeline, write documents, or edit full 4K videos on an airplane or without internet, and your work will automatically sync to your organization when you reconnect.'
  },
  {
    question: 'How do I install the Progressive Web App (PWA)?',
    answer: 'In Google Chrome, Microsoft Edge, or Brave, simply click the "Install App" icon in the address bar, or click "Install PWA" below. On iPhone/iPad Safari, tap "Share" and select "Add to Home Screen". The PWA runs in its own window with offline caching and zero installation prompts.'
  },
  {
    question: 'How does deep linking (workspace180://) work?',
    answer: 'When you install 180 Workspace Desktop, your operating system registers the custom workspace180:// protocol handler. When you click "Open in Desktop" anywhere in your web dashboard, email, or Slack, Windows, macOS, or Linux immediately launches the native desktop app and opens the exact project, document, or video timeline you requested.'
  },
  {
    question: 'Is the Desktop & Mobile App free with my 180 Workspace subscription?',
    answer: 'Yes! The 180 Workspace Native Desktop App and Mobile App are completely included across all subscription tiers (including Momentum, Scale, Enterprise, and Free Trial) without any extra licensing costs.'
  }
];
---

<Layout 
  title="Download 180 Workspace Apps | Windows, Mac, Linux, Android, iOS & PWA"
  description="Download the full 180 Workspace unified platform across Native Desktop (Windows, macOS, Linux), Mobile (Android APK, iOS), and Progressive Web App. Complete enterprise suite with CRM, meetings, docs, chat, and built-in hardware-accelerated Media Studio."
  canonicalUrl="https://180workspace.com/download"
  faqs={faqs}
>
  <JSONLDSchema 
    type="SoftwareApplication"
    name="180 Workspace"
    description="Unified universal enterprise workspace with CRM, team chat, meetings, docs, storage, offline AI director, and hardware-accelerated media studio."
    url="https://180workspace.com/download"
    applicationCategory="BusinessApplication"
  />

  {/* Hero Header Section */}
  <section class="relative pt-16 pb-12 lg:pt-24 lg:pb-16 overflow-hidden bg-gradient-to-b from-indigo-50/60 via-white to-slate-50 dark:from-slate-950 dark:via-indigo-950/20 dark:to-slate-950">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(99,102,241,0.15),rgba(255,255,255,0))] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(99,102,241,0.25),rgba(0,0,0,0))] pointer-events-none"></div>
    
    <div class="container mx-auto px-4 max-w-7xl relative z-10 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 dark:bg-indigo-500/10 border border-indigo-200/80 dark:border-indigo-500/20 text-xs font-bold text-indigo-700 dark:text-indigo-300 shadow-sm animate-fade-in">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Unified Universal Platform v2.0.0 Now Live</span>
      </div>

      <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-slate-950 dark:text-white tracking-tight leading-[1.1] max-w-4xl mx-auto">
        One Platform. <br class="hidden sm:block"/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-indigo-500 to-purple-600 dark:from-indigo-400 dark:via-indigo-300 dark:to-purple-400">
          Native on Every Device.
        </span>
      </h1>

      <p class="text-lg md:text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal">
        Experience the entire 180 Workspace suite—CRM, Meetings, Docs, Chat, and hardware-accelerated Media Studio—in one unified, lightning-fast native desktop application.
      </p>

      {/* Smart OS Detect Auto-Download Box */}
      <div class="pt-4 max-w-xl mx-auto">
        <div id="os-detect-card" class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-indigo-100 dark:border-indigo-900/50 shadow-xl shadow-indigo-500/10 dark:shadow-indigo-500/5 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
            <div class="flex items-center gap-2.5">
              <div id="detected-os-icon" class="text-indigo-600 dark:text-indigo-400">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.951-1.801"/></svg>
              </div>
              <div class="text-left">
                <p id="detected-os-text" class="text-sm font-bold text-slate-900 dark:text-white">Detected: Windows 64-bit</p>
                <p id="detected-specs-text" class="text-xs text-slate-500 dark:text-slate-400">Full Workspace Suite • Direct3D 12 • Offline Vault</p>
              </div>
            </div>
            <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
              Recommended for You
            </span>
          </div>

          <a 
            id="primary-download-btn" 
            href={downloadLinks.windowsExe} 
            download="180Workspace-Setup-x64.exe"
            class="flex items-center justify-center gap-3 w-full py-4 px-6 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-base shadow-lg shadow-indigo-600/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
          >
            <svg class="w-5 h-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span id="primary-download-label">Download 180 Workspace (.exe)</span>
          </a>

          <div class="flex items-center justify-center gap-4 text-xs text-slate-500 dark:text-slate-400">
            <span>Free Download</span>
            <span>•</span>
            <span>v2.0.0 Stable</span>
            <span>•</span>
            <span>All 17 Apps Included</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Platform Selector Quick Navigation */}
  <section class="py-8 bg-slate-50 dark:bg-slate-900/50 border-y border-slate-200/80 dark:border-slate-800">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="flex flex-wrap items-center justify-center gap-3 md:gap-4">
        <a href="#desktop" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm font-semibold text-slate-800 dark:text-slate-200 hover:border-indigo-500 hover:text-indigo-600 transition-colors shadow-xs">
          <svg class="w-4 h-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span>Desktop Suite (Win, Mac, Linux)</span>
        </a>
        <a href="#mobile" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm font-semibold text-slate-800 dark:text-slate-200 hover:border-indigo-500 hover:text-indigo-600 transition-colors shadow-xs">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          <span>Mobile Apps (Android & iOS)</span>
        </a>
        <a href="#pwa" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm font-semibold text-slate-800 dark:text-slate-200 hover:border-indigo-500 hover:text-indigo-600 transition-colors shadow-xs">
          <svg class="w-4 h-4 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
          <span>Instant PWA & Web Studio</span>
        </a>
      </div>
    </div>
  </section>

  {/* SECTION 1: NATIVE DESKTOP APPLICATIONS */}
  <section id="desktop" class="py-16 lg:py-24 bg-white dark:bg-slate-950">
    <div class="container mx-auto px-4 max-w-7xl space-y-12">
      <div class="text-center space-y-3 max-w-3xl mx-auto">
        <span class="text-xs font-black uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Section 1: Full Desktop Suite</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-950 dark:text-white">
          180 Workspace Native Desktop App
        </h2>
        <p class="text-slate-600 dark:text-slate-400 text-base md:text-lg">
          The complete 180 Workspace platform packaged into a high-performance native desktop application with offline-first synchronization, zero browser overhead, and built-in hardware-accelerated Media Studio.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {desktopPlatforms.map((p) => (
          <div class="flex flex-col justify-between rounded-3xl p-8 bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 hover:border-indigo-400/50 dark:hover:border-indigo-500/30 transition-all duration-300 shadow-sm hover:shadow-xl hover:shadow-indigo-500/5 group">
            <div class="space-y-6">
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-2xl bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 group-hover:scale-110 transition-transform">
                  <Fragment set:html={p.iconSvg} />
                </div>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                  {p.badge}
                </span>
              </div>

              <div>
                <h3 class="text-2xl font-bold text-slate-900 dark:text-white">{p.name}</h3>
                <p class="text-xs font-medium text-indigo-600 dark:text-indigo-400 mt-1">{p.tagline}</p>
              </div>

              <div class="space-y-2">
                <a
                  href={p.primaryDownload.url}
                  download={p.fileName || undefined}
                  class="flex items-center justify-center gap-2 w-full py-3.5 px-4 rounded-xl bg-slate-900 hover:bg-indigo-600 dark:bg-white dark:hover:bg-indigo-500 text-white dark:text-slate-950 dark:hover:text-white font-bold text-sm transition-colors shadow-sm"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
