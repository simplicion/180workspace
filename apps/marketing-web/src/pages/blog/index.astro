---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Badge from '../../components/ui/Badge.astro';
import { prisma } from '@workspace/db';

const fallbackBlogs = [
  {
    title: "The True Cost of Software Tool Fragmentation: Why Paying for 8 Tools Slows Down Growth",
    slug: "cost-of-software-fragmentation",
    category: "Operations",
    authorName: "180 Strategy Team",
    publishedAt: new Date("2026-08-15"),
    seoDescription: "Discover how context switching and paying for 8 to 12 disconnected SaaS tools erodes agency profit margins and how Work Graph consolidation solves it."
  },
  {
    title: "Demystifying Work Graph Architecture: How Data Links Across CRM, Invoices & Tasks in Zero Latency",
    slug: "demystifying-work-graph-architecture",
    category: "Architecture",
    authorName: "Engineering Team",
    publishedAt: new Date("2026-08-28"),
    seoDescription: "An in-depth look at how 180workspace connects sales leads, project sprints, client invoices, and employee attendance without fragile Zapier webhooks."
  },
  {
    title: "The Media Buyer's Guide to Edge Cloaking & Mitigating 99%+ of Fraudulent Ad Clicks",
    slug: "media-buyers-guide-edge-cloaking",
    category: "Growth & Ads",
    authorName: "Traffic Director Team",
    publishedAt: new Date("2026-09-01"),
    seoDescription: "Learn how sub-5ms edge request evaluation shields your Facebook and Google ad budgets from click fraud, scrapers, and ad review bots."
  }
];

let blogs = [];
try {
  blogs = await prisma.marketingBlog.findMany({
    where: {
      published: true,
    },
    orderBy: {
      publishedAt: 'desc'
    },
    select: {
      id: true,
      title: true,
      slug: true,
      category: true,
      authorName: true,
      publishedAt: true,
      seoDescription: true
    }
  });
} catch (error) {
  console.error("Failed to fetch blogs for SSG, using fallbacks:", error);
}

const displayBlogs = blogs.length > 0 ? blogs : fallbackBlogs;

const categoryColors: Record<string, string> = {
  "Operations": "bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-400 border-amber-200/60 dark:border-amber-800",
  "Architecture": "bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-400 border-indigo-200/60 dark:border-indigo-800",
  "Growth & Ads": "bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-400 border-rose-200/60 dark:border-rose-800",
};
---

<Layout 
  title="180workspace Blog & Insights | Work Graph Architecture & Growth"
  description="Explore expert guides on eliminating SaaS tool sprawl, Work Graph architecture, edge traffic routing, and modern agency scaling."
>
  <main class="w-full relative">
    
    <!-- Hero Header -->
    <section class="relative pt-24 pb-16 md:pt-36 md:pb-20 overflow-hidden">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-indigo-500/10 blur-[100px] rounded-full pointer-events-none -z-10"></div>
      <div class="absolute inset-0 bg-grid-pattern dark:bg-grid-pattern-dark [mask-image:radial-gradient(ellipse_70%_60%_at_50%_10%,#000_60%,transparent_100%)] -z-20"></div>

      <div class="container mx-auto px-4 max-w-5xl text-center">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800 shadow-sm mb-8">
          <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Thought Leadership & Insights</span>
        </div>

        <h1 class="display-h1 max-w-4xl mx-auto mb-6">
          Insights on building <span class="bg-gradient-to-r from-indigo-600 via-violet-600 to-pink-600 bg-clip-text text-transparent">high-velocity businesses.</span>
        </h1>
        <p class="body-lead max-w-3xl mx-auto">
          Deep dives into Work Graph architecture, eliminating software tool fatigue, edge traffic protection, and autonomous AI workflows.
        </p>
      </div>
    </section>

    <!-- Blog Articles Grid -->
    <section class="py-8 pb-24 md:pb-32 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {displayBlogs.map((blog, idx) => (
          <article class={`glass-card-interactive flex flex-col justify-between overflow-hidden ${idx === 0 && displayBlogs.length >= 3 ? 'md:col-span-2 lg:col-span-1' : ''}`}>
            {/* Category Color Bar */}
            <div class="h-1 w-full bg-gradient-to-r from-indigo-500 via-violet-500 to-purple-500"></div>
            
            <div class="p-7 flex flex-col justify-between flex-1">
              <div>
                <div class="flex items-center justify-between gap-2 mb-5">
                  <span class={`badge-pill text-[10px] py-1 px-2.5 ${categoryColors[blog.category] || 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700'}`}>
                    {blog.category}
                  </span>
                  <time class="text-[11px] text-slate-400 font-semibold tabular-nums">
                    {blog.publishedAt ? new Date(blog.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Recent'}
                  </time>
                </div>

                <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white leading-snug group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mb-3">
                  <a href={`/blog/${blog.slug}`} class="focus:outline-none">
                    {blog.title}
                  </a>
                </h2>

                <p class="body-standard text-sm line-clamp-3">
                  {blog.seoDescription}
                </p>
              </div>

              <div class="mt-6 pt-5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-full bg-indigo-50 dark:bg-indigo-950/80 border border-indigo-100 dark:border-indigo-800 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-[10px] font-black">
                    {blog.authorName.charAt(0)}
                  </div>
                  <span class="text-xs font-bold text-slate-700 dark:text-slate-300">
                    {blog.authorName}
                  </span>
                </div>
                <a 
                  href={`/blog/${blog.slug}`}
                  class="text-xs font-bold text-indigo-600 dark:text-indigo-400 flex items-center gap-1.5 hover:gap-2.5 transition-all"
                >
                  <span>Read Article</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

  </main>
</Layout>
