---
import Layout from '../../layouts/Layout.astro';
import { prisma } from '@workspace/db';

export async function getStaticPaths() {
  const blogs = await prisma.marketingBlog.findMany({
    where: {
      published: true,
    },
    select: {
      slug: true,
      title: true,
      content: true,
      category: true,
      authorName: true,
      publishedAt: true,
      metaTitle: true,
      metaDescription: true,
      structuredData: true
    }
  });

  return blogs.map(blog => ({
    params: { slug: blog.slug },
    props: { blog },
  }));
}

const { blog } = Astro.props;

// Default structured data for Article schema
const defaultStructuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": blog.metaTitle || blog.title,
  "description": blog.metaDescription,
  "author": {
    "@type": "Person",
    "name": blog.authorName || "180workspace Team"
  },
  "publisher": {
    "@type": "Organization",
    "name": "180workspace",
    "logo": {
      "@type": "ImageObject",
      "url": "https://180workspace.com/logo.png"
    }
  },
  "datePublished": blog.publishedAt?.toISOString(),
};

const jsonLd = blog.structuredData ? blog.structuredData : JSON.stringify(defaultStructuredData);
---

<Layout 
  title={`${blog.metaTitle || blog.title} | 180workspace Blog`}
  description={blog.metaDescription || `Read ${blog.title} on the 180workspace blog.`}
>
  <main class="container mx-auto px-4 py-16 max-w-4xl">
    
    <div class="mb-12 border-b border-border pb-8">
      <div class="flex items-center gap-x-4 text-sm mb-6">
        <a href="/blog" class="text-muted-foreground hover:text-primary transition-colors flex items-center gap-2">
          ← Back to Blog
        </a>
        <span class="text-border">|</span>
        <time datetime={blog.publishedAt?.toISOString()} class="text-muted-foreground">
          {blog.publishedAt ? new Date(blog.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'Unknown Date'}
        </time>
        <span class="rounded-full bg-primary/10 px-3 py-1 font-medium text-primary">
          {blog.category}
        </span>
      </div>
      
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-6 leading-tight">
        {blog.title}
      </h1>
      
      <div class="flex items-center gap-3 mt-8">
        <div class="h-10 w-10 rounded-full bg-primary/20 flex items-center justify-center font-bold text-primary">
          {blog.authorName ? blog.authorName.charAt(0) : '1'}
        </div>
        <div>
          <p class="font-medium text-foreground">{blog.authorName || '180workspace Team'}</p>
          <p class="text-sm text-muted-foreground">Content Team</p>
        </div>
      </div>
    </div>

    {/* Content Area - Typically you'd use a Markdown renderer component here like @astrojs/markdown-remark, but for simplicity we render the content as is or you can use a markdown parser. Assuming HTML for now. */}
    <article class="prose prose-lg dark:prose-invert max-w-none prose-headings:font-bold prose-a:text-primary hover:prose-a:text-primary/80">
      {/* In a real app with markdown, you'd parse this. We use set:html if the content is pre-rendered HTML, or render it through a markdown component. */}
      {/* For this scaffold, if it's raw text, we'll just display it. */}
      <div set:html={blog.content} />
    </article>

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={jsonLd} />
  </main>
</Layout>
