---
import Layout from '../../layouts/Layout.astro';

const devConsoleUrl = import.meta.env.PUBLIC_DEV_CONSOLE_URL || 'https://developers.180workspace.com/dashboard';
---

<Layout
  title="180 Core — Sovereign Identity & Payment Infrastructure"
  description="Universal WhatsApp OTP authentication, biometric passkeys, sovereign profile, and 1-click UPI wallet checkout with 0.8% flat fee."
>
  <div class="relative min-h-screen bg-black text-white overflow-hidden selection:bg-indigo-500 selection:text-white">
    {/* Subtle Background Ambiance Glows & Grid Mesh */}
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[550px] bg-gradient-to-b from-blue-600/15 via-indigo-600/10 to-transparent blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute top-40 left-1/4 w-96 h-96 bg-purple-600/10 blur-[128px] pointer-events-none -z-10"></div>
    <div class="absolute inset-0 bg-grid-pattern-dark opacity-10 pointer-events-none -z-10"></div>

    {/* Hero Section */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 sm:pt-20 lg:pt-24 pb-16 sm:pb-24 text-center space-y-8">
      {/* Eyebrow Pill */}
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-zinc-900/90 border border-white/10 text-xs text-zinc-300 backdrop-blur-xl shadow-lg transition-all hover:border-white/20">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-medium">Sovereign Developer Infrastructure</span>
        <span class="text-zinc-600">/</span>
        <span class="text-indigo-400 font-mono text-[11px] font-semibold">180 Core v2.4</span>
      </div>

      {/* Main Headline */}
      <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tight text-white leading-[1.08] max-w-5xl mx-auto">
        The Sovereign Core for <br class="hidden sm:block" />
        <span class="bg-gradient-to-r from-blue-400 via-indigo-300 to-purple-400 bg-clip-text text-transparent">
          Identity, Profiles & Payments
        </span>
      </h1>

      {/* Subtitle */}
      <p class="max-w-2xl mx-auto text-base sm:text-lg text-zinc-400 leading-relaxed font-normal">
        Build high-trust applications with two fundamental APIs. Universal WhatsApp OTP authentication and 1-click sovereign wallet checkout with instant UPI settlement.
      </p>

      {/* Hero Action CTAs */}
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3.5 pt-2 max-w-md sm:max-w-none mx-auto">
        <button
          id="core-hero-launch-btn"
          type="button"
          class="min-h-[48px] px-8 py-3.5 rounded-2xl bg-white text-black hover:bg-zinc-100 font-bold text-sm shadow-xl hover:shadow-white/10 transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Launch Developer Console</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </button>

        <a
          href="https://developers.180workspace.com/docs"
          target="_blank"
          rel="noopener noreferrer"
          class="min-h-[48px] px-7 py-3.5 rounded-2xl bg-zinc-900 border border-white/10 text-zinc-200 hover:text-white hover:bg-zinc-800 font-semibold text-sm transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span>Read Core API Docs</span>
        </a>
      </div>

      {/* Quick Terminal Command Copy Badge */}
      <div class="pt-2">
        <button
          id="copy-quickstart-btn"
          type="button"
          class="inline-flex items-center gap-2.5 px-4 py-2 rounded-xl bg-zinc-900/80 border border-white/10 hover:border-zinc-700 text-xs font-mono text-zinc-300 transition-colors group cursor-pointer"
          data-code="npm i @workspace/identity-sdk"
        >
          <span class="text-zinc-500">$</span>
          <span>npm i @workspace/identity-sdk</span>
          <span class="w-3.5 h-3.5 text-zinc-400 group-hover:text-white transition-colors" id="copy-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-3.5 h-3.5">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </span>
          <span id="copied-badge" class="hidden text-emerald-400 font-sans text-[11px] font-bold">Copied!</span>
        </button>
      </div>

      {/* Trust & Performance Metrics Bar */}
      <div class="pt-8 max-w-4xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 p-4 sm:p-5 rounded-2xl bg-zinc-900/40 border border-white/10 backdrop-blur-md">
          <div class="p-3 text-center sm:text-left">
            <div class="text-xl sm:text-2xl font-black text-white tracking-tight">&lt; 24ms</div>
            <div class="text-[11px] text-zinc-400 font-mono mt-0.5">Token JWKS Verify</div>
          </div>
          <div class="p-3 text-center sm:text-left border-l border-white/5">
            <div class="text-xl sm:text-2xl font-black text-emerald-400 tracking-tight">0.8%</div>
            <div class="text-[11px] text-zinc-400 font-mono mt-0.5">Sovereign UPI Rate</div>
          </div>
          <div class="p-3 text-center sm:text-left border-l border-white/5">
            <div class="text-xl sm:text-2xl font-black text-blue-400 tracking-tight">T+0</div>
            <div class="text-[11px] text-zinc-400 font-mono mt-0.5">Bank Settlement</div>
          </div>
          <div class="p-3 text-center sm:text-left border-l border-white/5">
            <div class="text-xl sm:text-2xl font-black text-purple-400 tracking-tight">99.2%</div>
            <div class="text-[11px] text-zinc-400 font-mono mt-0.5">WhatsApp Delivery</div>
          </div>
        </div>
      </div>
    </section>

    {/* Visual Architecture Flow: How 180 Core Works */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <div class="text-center max-w-2xl mx-auto mb-10 space-y-3">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-400">System Architecture</span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-white">
          How Sovereign Core Works
        </h2>
        <p class="text-sm text-zinc-400">
          From customer authentication to instant bank settlement in a unified, end-to-end cryptographic pipeline.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        {/* Step 1 */}
        <div class="p-6 rounded-2xl bg-zinc-900/50 border border-white/10 hover:border-blue-500/30 transition-all duration-300 relative group">
          <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center font-bold text-sm mb-4">
            01
          </div>
          <h3 class="font-bold text-base text-white mb-2">Client Touchpoint</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Your web or mobile app calls <code class="text-blue-300 font-mono text-[11px]">openPopup()</code>. Zero passwords, zero friction.
          </p>
        </div>

        {/* Step 2 */}
        <div class="p-6 rounded-2xl bg-zinc-900/50 border border-white/10 hover:border-indigo-500/30 transition-all duration-300 relative group">
          <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold text-sm mb-4">
            02
          </div>
          <h3 class="font-bold text-base text-white mb-2">WhatsApp / Passkey</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            User confirms OTP via official WhatsApp channel or biometric WebAuthn passkey in under 3 seconds.
          </p>
        </div>

        {/* Step 3 */}
        <div class="p-6 rounded-2xl bg-zinc-900/50 border border-white/10 hover:border-purple-500/30 transition-all duration-300 relative group">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center font-bold text-sm mb-4">
            03
          </div>
          <h3 class="font-bold text-base text-white mb-2">RS256 JWT Issued</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Cryptographic token signed with asymmetric RS256 JWKS key pair, verifiable offline by your backend.
          </p>
        </div>

        {/* Step 4 */}
        <div class="p-6 rounded-2xl bg-zinc-900/50 border border-white/10 hover:border-emerald-500/30 transition-all duration-300 relative group">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm mb-4">
            04
          </div>
          <h3 class="font-bold text-base text-white mb-2">1-Click Settlement</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            180 Pay settles instant UPI payments at 0.8% flat directly into your verified bank account (T+0).
          </p>
        </div>
      </div>
    </section>

    {/* The Two Sovereign Pillars */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {/* Pillar 1: 180 Identity */}
        <div class="p-6 sm:p-8 lg:p-10 rounded-3xl bg-zinc-900/60 border border-white/10 space-y-6 flex flex-col justify-between group hover:border-blue-500/40 transition-all duration-300 shadow-xl">
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <div class="w-12 h-12 rounded-2xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-blue-500/10 text-blue-400 border border-blue-500/20">
                OAuth 2.0 & OIDC
              </span>
            </div>

            <div>
              <span class="text-[11px] font-mono uppercase tracking-wider text-blue-400 font-bold">
                Universal Sovereign Auth
              </span>
              <h2 class="text-2xl sm:text-3xl font-black text-white mt-1 tracking-tight">180 Identity & Profile</h2>
            </div>

            <p class="text-sm text-zinc-400 leading-relaxed">
              Universal authentication with WhatsApp OTP, Google SSO, and sovereign @usernames. Issues cryptographic RS256 JWTs with client-side modal or bottom-sheet verification.
            </p>

            <ul class="space-y-3 pt-2 text-xs text-zinc-300">
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-blue-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span>Zero password fatigue with biometric passkeys & instant WhatsApp OTP</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-blue-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span>RFC 7636 PKCE code exchange with anti-CSRF state protection</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-blue-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span>Real-time session introspection & active token revocation via edge endpoints</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-blue-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span>Sovereign profile graph synced across your entire multi-tenant app suite</span>
              </li>
            </ul>
          </div>

          <div class="pt-6 border-t border-white/5 space-y-3">
            <button
              id="try-identity-btn"
              type="button"
              class="w-full min-h-[48px] py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs sm:text-sm transition-all duration-200 cursor-pointer flex items-center justify-center gap-2 shadow-lg shadow-blue-600/20 hover:scale-[1.01] active:scale-[0.99]"
            >
              <span>Test 180 Identity Flow (Live Popup)</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </button>
            <div class="text-[11px] text-center text-zinc-500 font-mono">
              Launches real sovereign OAuth popup with fallback redirect
            </div>
          </div>
        </div>

        {/* Pillar 2: 180 Pay */}
        <div class="p-6 sm:p-8 lg:p-10 rounded-3xl bg-zinc-900/60 border border-white/10 space-y-6 flex flex-col justify-between group hover:border-purple-500/40 transition-all duration-300 shadow-xl">
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <div class="w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                </svg>
              </div>
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-purple-500/10 text-purple-400 border border-purple-500/20">
                UPI & Escrow Checkout
              </span>
            </div>

            <div>
              <span class="text-[11px] font-mono uppercase tracking-wider text-purple-400 font-bold">
                Direct Indian Settlement
              </span>
              <h2 class="text-2xl sm:text-3xl font-black text-white mt-1 tracking-tight">180 Pay Engine</h2>
            </div>

            <p class="text-sm text-zinc-400 leading-relaxed">
              1-Click Sovereign Wallet and UPI checkout engine. Direct 2-way verification, instant settlements to verified bank accounts, and automatic HMAC-SHA256 webhooks.
            </p>

            <ul class="space-y-3 pt-2 text-xs text-zinc-300">
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-purple-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span>0.8% flat sovereign fee (saves 60% compared to standard 2.0% gateways)</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-purple-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span>Prepaid Sovereign Wallet balance shared seamlessly across ecosystem</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-purple-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span>Instant automated penny-drop bank account validation and KYC verification</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-purple-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span>Automated HMAC-SHA256 webhooks with exponential backoff retries</span>
              </li>
            </ul>
          </div>

          <div class="pt-6 border-t border-white/5 space-y-3">
            <button
              id="try-pay-btn"
              type="button"
              class="w-full min-h-[48px] py-3 px-4 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs sm:text-sm transition-all duration-200 cursor-pointer flex items-center justify-center gap-2 shadow-lg shadow-purple-600/20 hover:scale-[1.01] active:scale-[0.99]"
            >
              <span>Test 180 Pay Sandbox Checkout</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
            <div class="text-[11px] text-center text-zinc-500 font-mono">
              Triggers authenticated sandbox payment bottom-sheet flow
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Interactive Code Playground / Multi-Language SDK Snippets */}
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <div class="text-center max-w-2xl mx-auto mb-8 space-y-2">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-400">Developer First</span>
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-white">
          Integrate with 2 Lines of Code
        </h2>
        <p class="text-xs sm:text-sm text-zinc-400">
          Native client and backend SDKs with full TypeScript definitions and zero dependencies.
        </p>
      </div>

      <div class="rounded-3xl bg-zinc-950 border border-white/10 shadow-2xl overflow-hidden">
        {/* Terminal Header & Tabs */}
        <div class="px-4 py-3 bg-zinc-900/80 border-b border-white/5 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            <span class="text-xs font-mono text-zinc-400 ml-2 hidden sm:inline">180-quickstart</span>
          </div>

          {/* Language Switcher Tabs */}
          <div class="flex items-center gap-1 bg-black/60 p-1 rounded-xl border border-white/5">
            <button
              type="button"
              class="code-tab-btn active px-3 py-1 rounded-lg text-xs font-mono font-semibold transition-all bg-white/10 text-white"
              data-lang="ts"
            >
              TypeScript
            </button>
            <button
              type="button"
              class="code-tab-btn px-3 py-1 rounded-lg text-xs font-mono font-semibold transition-all text-zinc-400 hover:text-white"
              data-lang="python"
            >
              Python
            </button>
            <button
              type="button"
              class="code-tab-btn px-3 py-1 rounded-lg text-xs font-mono font-semibold transition-all text-zinc-400 hover:text-white"
              data-lang="curl"
            >
              cURL
            </button>
            <button
              type="button"
              class="code-tab-btn px-3 py-1 rounded-lg text-xs font-mono font-semibold transition-all text-zinc-400 hover:text-white"
              data-lang="dart"
            >
              Flutter / Dart
            </button>
          </div>

          {/* Copy Button */}
          <button
            id="copy-snippet-btn"
            type="button"
            class="px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-[11px] font-mono text-zinc-300 hover:text-white transition-colors flex items-center gap-1.5 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span id="copy-snippet-text">Copy</span>
          </button>
        </div>

        {/* Code Content Container */}
        <div class="p-4 sm:p-6 overflow-x-auto">
          {/* TypeScript Snippet */}
          <pre id="snippet-ts" class="code-snippet font-mono text-xs sm:text-sm text-zinc-300 leading-relaxed">
<code>{`// 1. Authenticate with Sovereign 180 Identity (Client-side)
import { OneEightyIdentity, OneEightyPay } from '@workspace/identity-sdk';

const session = await OneEightyIdentity.openPopup({
  clientId: 'app_sandbox_7a9f82d1',
  scopes: ['openid', 'identity:read', 'identity:whatsapp'],
  uxMode: 'popup' // Fallback to redirect on mobile WebView
});

console.log('Sovereign User Authenticated:', session.user.username);
// e.g., "@alex" with verified phone + RS256 token

// 2. Accept 1-Click UPI & Sovereign Wallet Checkout
const payment = await OneEightyPay.openBottomSheet({
  amount: 499,
  currency: 'INR',
  title: '180 Pro Monthly Subscription',
  onSuccess: (tx) => {
    console.log('Payment Settled (0.8% fee):', tx.transactionId);
  }
});`}</code>
          </pre>

          {/* Python Snippet */}
          <pre id="snippet-python" class="code-snippet hidden font-mono text-xs sm:text-sm text-zinc-300 leading-relaxed">
<code>{`# 1. Verify Sovereign RS256 Token on Backend (FastAPI / Django)
import jwt
from jwt import PyJWKClient

JWKS_URL = "https://profile.180workspace.com/.well-known/jwks.json"
jwks_client = PyJWKClient(JWKS_URL)

def verify_180_token(token: str):
