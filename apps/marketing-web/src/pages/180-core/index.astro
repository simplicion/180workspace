  <script is:inline define:vars={{ devConsoleUrl }}>
    // 1. Sovereign Identity Modal & Popup Launcher
    function launchIdentityLogin() {
      var isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
      var authHost = isLocal ? 'http://localhost:3009' : 'https://profile.180workspace.com';
      var redirectTarget = isLocal ? 'http://localhost:3008/dashboard' : (devConsoleUrl || 'https://developers.180workspace.com/dashboard');

      // Construct Sovereign OAuth URL for 180 Developers Console
      var params = [
        'client_id=180-developers-portal',
        'redirect_uri=' + encodeURIComponent(redirectTarget),
        'response_type=code',
        'scope=' + encodeURIComponent('openid identity:read identity:email identity:whatsapp'),
        'ux_mode=popup'
      ].join('&');

      var loginUrl = authHost + '/auth/login?' + params;

      // Standard centered popup dimensions
      var w = 480;
      var h = 720;
      var left = window.screen.width ? Math.max(0, (window.screen.width - w) / 2) : 100;
      var top = window.screen.height ? Math.max(0, (window.screen.height - h) / 2) : 100;

      var popup = window.open(
        loginUrl,
        '180_Core_Auth',
        'width=' + w + ',height=' + h + ',top=' + top + ',left=' + left + ',scrollbars=yes,status=no,toolbar=no,resizable=yes'
      );

      if (popup && typeof popup.focus === 'function') {
        try { popup.focus(); } catch(_) {}
      }

      // If browser blocked popup, fallback to direct navigation
      if (!popup || popup.closed || typeof popup.closed === 'undefined') {
        window.location.href = loginUrl;
        return;
      }

      function handleAuthSuccess(token, user) {
        if (token) {
          try {
            localStorage.setItem('platform_auth_token', token);
            localStorage.setItem('token', token);
            var isProd = window.location.protocol === 'https:';
            var is180 = window.location.hostname.endsWith('180workspace.com');
            var domainAttr = is180 ? '; domain=.180workspace.com' : '';
            var secureAttr = isProd ? '; Secure' : '';
            document.cookie = 'platform_auth_token=' + token + '; path=/; max-age=604800; SameSite=Lax' + secureAttr + domainAttr;
          } catch (_) {}
        }
        if (user) {
          try {
            localStorage.setItem('user', JSON.stringify(user));
          } catch (_) {}
        }
        try {
          if (popup && !popup.closed) popup.close();
        } catch (_) {}

        var sep = redirectTarget.indexOf('?') !== -1 ? '&' : '?';
        var destinationUrl = redirectTarget + (token ? sep + 'token=' + encodeURIComponent(token) : '');
        window.location.href = destinationUrl;
      }

      function handleMessage(e) {
        if (!e.data) return;
        var data = e.data;
        if (typeof data === 'string') {
          try { data = JSON.parse(data); } catch(_) {}
        }
        if (data.type === '180_IDENTITY_SUCCESS' || data.type === '180_AUTH_SUCCESS') {
          var token = data.authToken || data.accessToken || data.token;
          handleAuthSuccess(token, data.user);
          window.removeEventListener('message', handleMessage);
        }
      }

      window.addEventListener('message', handleMessage);
    }

    // Attach click events
    document.getElementById('core-hero-launch-btn')?.addEventListener('click', launchIdentityLogin);
    document.getElementById('core-bottom-launch-btn')?.addEventListener('click', launchIdentityLogin);
    document.getElementById('try-identity-btn')?.addEventListener('click', launchIdentityLogin);
    document.getElementById('try-pay-btn')?.addEventListener('click', launchIdentityLogin);

    // 2. Terminal Quickstart Copy Button
    var copyQuickstartBtn = document.getElementById('copy-quickstart-btn');
    if (copyQuickstartBtn) {
      copyQuickstartBtn.addEventListener('click', function() {
        var code = copyQuickstartBtn.getAttribute('data-code') || 'npm i @workspace/identity-sdk';
        navigator.clipboard.writeText(code).then(function() {
          var badge = document.getElementById('copied-badge');
          var icon = document.getElementById('copy-icon');
          if (badge && icon) {
            badge.classList.remove('hidden');
            icon.classList.add('hidden');
            setTimeout(function() {
              badge.classList.add('hidden');
              icon.classList.remove('hidden');
            }, 2000);
          }
        }).catch(function() {});
      });
    }

    // 3. Multi-Language Code Tabs Switcher
    var tabButtons = document.querySelectorAll('.code-tab-btn');
    var snippets = {
      ts: document.getElementById('snippet-ts'),
      python: document.getElementById('snippet-python'),
      curl: document.getElementById('snippet-curl'),
      dart: document.getElementById('snippet-dart')
    };

    var activeLang = 'ts';

    tabButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var lang = btn.getAttribute('data-lang');
        if (!lang || !snippets[lang]) return;

        tabButtons.forEach(function(b) {
          b.classList.remove('active', 'bg-white/10', 'text-white');
          b.classList.add('text-zinc-400');
        });

        btn.classList.add('active', 'bg-white/10', 'text-white');
        btn.classList.remove('text-zinc-400');

        Object.keys(snippets).forEach(function(k) {
          if (snippets[k]) snippets[k].classList.add('hidden');
        });

        snippets[lang].classList.remove('hidden');
        activeLang = lang;
      });
    });

    // 4. Code Snippet Copy Button
    var copySnippetBtn = document.getElementById('copy-snippet-btn');
    if (copySnippetBtn) {
      copySnippetBtn.addEventListener('click', function() {
        var activeSnippet = snippets[activeLang];
        if (!activeSnippet) return;
        var text = activeSnippet.innerText;
        navigator.clipboard.writeText(text).then(function() {
          var label = document.getElementById('copy-snippet-text');
          if (label) {
            label.textContent = 'Copied!';
            setTimeout(function() {
              label.textContent = 'Copy';
            }, 2000);
          }
        }).catch(function() {});
      });
    }

    // 5. FAQ Accordion Toggle
    var faqToggles = document.querySelectorAll('.faq-toggle');
    faqToggles.forEach(function(toggle) {
      toggle.addEventListener('click', function() {
        var parent = toggle.closest('.faq-item');
        if (!parent) return;
        var answer = parent.querySelector('.faq-answer');
        var icon = toggle.querySelector('.faq-icon');
        var isExpanded = toggle.getAttribute('aria-expanded') === 'true';

        toggle.setAttribute('aria-expanded', String(!isExpanded));
        if (answer) answer.classList.toggle('hidden');
        if (icon) icon.classList.toggle('rotate-180');
      });
    });
  </script>
