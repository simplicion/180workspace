---
import Layout from '../layouts/Layout.astro';

const lastUpdated = "September 25, 2026";
---

<Layout 
  title="Delete Your Account | 180workspace"
  description="Request permanent deletion of your 180workspace account and all associated data. Google Play compliant account deletion process."
  canonicalUrl="https://180workspace.com/account-delete"
>
  <main class="w-full relative">
    
    <!-- Hero Header -->
    <section class="relative pt-24 pb-12 md:pt-36 md:pb-16 overflow-hidden border-b border-slate-200/80 dark:border-slate-800">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-gradient-to-tr from-red-500/15 via-orange-500/10 to-amber-500/10 blur-[120px] rounded-full pointer-events-none -z-10"></div>
      <div class="absolute inset-0 bg-grid-pattern dark:bg-grid-pattern-dark [mask-image:radial-gradient(ellipse_70%_60%_at_50%_10%,#000_60%,transparent_100%)] -z-20"></div>

      <div class="container mx-auto px-4 max-w-5xl text-center">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800 shadow-sm mb-6">
          <svg class="w-4 h-4 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Account Management</span>
        </div>
        
        <h1 class="display-h1 max-w-4xl mx-auto mb-6">
          Delete Your <span class="bg-gradient-to-r from-red-600 via-orange-600 to-amber-600 bg-clip-text text-transparent">Account</span>
        </h1>
        <p class="body-lead max-w-3xl mx-auto mb-6">
          We respect your right to data ownership. Use this page to request permanent deletion of your 180workspace account and all associated data.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-semibold text-slate-500 dark:text-slate-400">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-red-500"></span>
            <span>Permanent & Irreversible</span>
          </div>
          <span>•</span>
          <div class="flex items-center gap-1.5">
            <span>Last Updated: {lastUpdated}</span>
          </div>
          <span>•</span>
          <div class="flex items-center gap-1.5">
            <span>GDPR & CCPA Compliant</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <div class="container mx-auto px-4 max-w-4xl py-12 md:py-16">
      <div class="space-y-10">

        <!-- What Gets Deleted -->
        <section class="space-y-4">
          <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
            What Gets Deleted
          </h2>
          <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
            When you request account deletion, the following data will be <strong>permanently and irreversibly removed</strong> from all our systems within <strong>30 days</strong>:
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
            <div class="p-5 rounded-2xl bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800 shadow-lg shadow-slate-900/5">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-8 h-8 rounded-xl bg-red-100 dark:bg-red-900/30 flex items-center justify-center">
                  <svg class="w-4 h-4 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                  </svg>
                </div>
                <h3 class="font-bold text-slate-900 dark:text-white text-sm">Account Profile</h3>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-400">Name, email address, profile picture, authentication credentials, and login history.</p>
            </div>

            <div class="p-5 rounded-2xl bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800 shadow-lg shadow-slate-900/5">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-8 h-8 rounded-xl bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center">
                  <svg class="w-4 h-4 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <h3 class="font-bold text-slate-900 dark:text-white text-sm">Media & Content</h3>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-400">All uploaded videos, images, edited projects, captions, audio recordings, and brand assets.</p>
            </div>

            <div class="p-5 rounded-2xl bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800 shadow-lg shadow-slate-900/5">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-8 h-8 rounded-xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center">
                  <svg class="w-4 h-4 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                  </svg>
                </div>
                <h3 class="font-bold text-slate-900 dark:text-white text-sm">Connected Accounts</h3>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-400">All OAuth tokens and connections to YouTube, Instagram, TikTok, X (Twitter), LinkedIn, and other platforms.</p>
            </div>

            <div class="p-5 rounded-2xl bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800 shadow-lg shadow-slate-900/5">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-8 h-8 rounded-xl bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center">
                  <svg class="w-4 h-4 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                  </svg>
                </div>
                <h3 class="font-bold text-slate-900 dark:text-white text-sm">Analytics & History</h3>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-400">Content calendars, posting history, growth analytics, brand identity configurations, and all Work Graph data.</p>
            </div>
          </div>
        </section>

        <!-- Timeline -->
        <section class="space-y-4">
          <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
            Deletion Timeline
          </h2>
          <div class="relative pl-8 space-y-6 before:absolute before:left-3 before:top-2 before:bottom-2 before:w-0.5 before:bg-gradient-to-b before:from-red-500 before:via-orange-400 before:to-emerald-500">
            <div class="relative">
              <div class="absolute -left-8 top-1 w-6 h-6 rounded-full bg-red-500 flex items-center justify-center">
                <span class="text-white text-[10px] font-bold">1</span>
              </div>
              <h3 class="font-bold text-slate-900 dark:text-white text-sm">Request Submitted</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">You submit the deletion request via the form below or by emailing us. A confirmation email is sent within 24 hours.</p>
            </div>
            <div class="relative">
              <div class="absolute -left-8 top-1 w-6 h-6 rounded-full bg-orange-500 flex items-center justify-center">
                <span class="text-white text-[10px] font-bold">2</span>
              </div>
              <h3 class="font-bold text-slate-900 dark:text-white text-sm">7-Day Grace Period</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">You can cancel the deletion request within 7 days by logging back in. After 7 days, the process becomes irreversible.</p>
            </div>
            <div class="relative">
              <div class="absolute -left-8 top-1 w-6 h-6 rounded-full bg-amber-500 flex items-center justify-center">
                <span class="text-white text-[10px] font-bold">3</span>
              </div>
              <h3 class="font-bold text-slate-900 dark:text-white text-sm">Data Purge (Days 7–30)</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">All personal data, media files, connected account tokens, and analytics are permanently erased from primary databases and backups.</p>
            </div>
            <div class="relative">
              <div class="absolute -left-8 top-1 w-6 h-6 rounded-full bg-emerald-500 flex items-center justify-center">
                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <h3 class="font-bold text-slate-900 dark:text-white text-sm">Deletion Complete</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">A final confirmation email is sent once all data has been permanently removed. Your account no longer exists in our systems.</p>
            </div>
          </div>
        </section>

        <!-- Request Form -->
        <section id="request-deletion" class="scroll-mt-28 space-y-4">
          <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
            Request Account Deletion
          </h2>
          <p class="text-slate-700 dark:text-slate-300 leading-relaxed text-sm">
            Choose one of the following methods to request deletion of your account and all associated data:
          </p>

          <!-- Method 1: Email -->
          <div class="p-6 rounded-3xl bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800 shadow-xl shadow-slate-900/5 space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center">
                <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 dark:text-white">Method 1: Email Request</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">Recommended • Fastest processing</p>
              </div>
            </div>
            <p class="text-sm text-slate-700 dark:text-slate-300">
              Send an email to <a href="mailto:support@180workspace.com?subject=Account%20Deletion%20Request&body=I%20would%20like%20to%20permanently%20delete%20my%20180workspace%20account%20and%20all%20associated%20data.%0A%0ARegistered%20Email%3A%20%0A%0APlease%20confirm%20the%20deletion%20process." class="text-indigo-600 dark:text-indigo-400 font-bold hover:underline">support@180workspace.com</a> with the subject line <strong>"Account Deletion Request"</strong>.
            </p>
            <p class="text-xs text-slate-500 dark:text-slate-400">Include the email address registered with your 180workspace account.</p>
            <a 
              href="mailto:support@180workspace.com?subject=Account%20Deletion%20Request&body=I%20would%20like%20to%20permanently%20delete%20my%20180workspace%20account%20and%20all%20associated%20data.%0A%0ARegistered%20Email%3A%20%0A%0APlease%20confirm%20the%20deletion%20process."
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-red-600 to-orange-600 text-white font-bold text-sm shadow-lg shadow-red-500/25 hover:shadow-red-500/40 transition-all hover:-translate-y-0.5"
              id="delete-email-button"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              Send Deletion Email
            </a>
          </div>

          <!-- Method 2: In-App -->
          <div class="p-6 rounded-3xl bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800 shadow-xl shadow-slate-900/5 space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center">
                <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 dark:text-white">Method 2: In-App Deletion</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">Available in 180 Manager mobile app</p>
              </div>
            </div>
            <ol class="text-sm text-slate-700 dark:text-slate-300 space-y-2 list-decimal pl-5">
              <li>Open the <strong>180 Manager</strong> app on your Android device</li>
              <li>Go to <strong>Settings</strong> → <strong>Account</strong></li>
              <li>Tap <strong>"Delete My Account"</strong></li>
              <li>Confirm your identity with your password</li>
              <li>Tap <strong>"Permanently Delete"</strong> to initiate the process</li>
            </ol>
          </div>

          <!-- Method 3: Web App -->
          <div class="p-6 rounded-3xl bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800 shadow-xl shadow-slate-900/5 space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-sky-100 dark:bg-sky-900/30 flex items-center justify-center">
                <svg class="w-5 h-5 text-sky-600 dark:text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 dark:text-white">Method 3: Web Dashboard</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">Via app.180workspace.com</p>
              </div>
            </div>
            <ol class="text-sm text-slate-700 dark:text-slate-300 space-y-2 list-decimal pl-5">
              <li>Log in at <a href="https://app.180workspace.com" class="text-indigo-600 dark:text-indigo-400 font-semibold hover:underline">app.180workspace.com</a></li>
              <li>Navigate to <strong>Settings</strong> → <strong>Account & Security</strong></li>
              <li>Click <strong>"Delete Account"</strong> at the bottom of the page</li>
              <li>Confirm by entering your password and clicking <strong>"Delete Forever"</strong></li>
            </ol>
          </div>
        </section>

        <!-- Important Notes -->
        <section class="space-y-4">
          <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
            Important Notes
          </h2>
          <div class="p-5 rounded-2xl bg-amber-50/80 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/50 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-amber-600 dark:text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.072 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
              </svg>
              <div class="text-sm text-amber-900 dark:text-amber-200 space-y-2">
                <p><strong>This action is permanent.</strong> Once the 7-day grace period expires, your data cannot be recovered under any circumstances.</p>
                <p><strong>Active subscriptions</strong> will be automatically cancelled. No further charges will occur after deletion.</p>
                <p><strong>Shared workspaces:</strong> If you are the sole owner of a workspace, all workspace data will also be deleted. Transfer ownership first if you want to preserve workspace data.</p>
                <p><strong>Connected platforms:</strong> Deletion revokes all OAuth tokens. Content already posted to third-party platforms (YouTube, Instagram, etc.) is <em>not</em> affected — manage that content directly on those platforms.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Contact -->
        <section class="space-y-4">
          <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
            Need Help?
          </h2>
          <div class="p-6 rounded-3xl bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800 shadow-xl shadow-slate-900/5">
            <p class="text-sm text-slate-700 dark:text-slate-300 mb-4">
              If you have questions about the deletion process or need assistance, our support team is ready to help:
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="mailto:support@180workspace.com" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold text-sm hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors" id="support-email-link">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                support@180workspace.com
              </a>
              <a href="/privacy" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold text-sm hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors" id="privacy-policy-link">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                Read Privacy Policy
              </a>
            </div>
          </div>
        </section>

      </div>
    </div>

  </main>
</Layout>
