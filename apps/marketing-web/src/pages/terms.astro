---
import Layout from '../layouts/Layout.astro';

const lastUpdated = "September 4, 2026";
const effectiveDate = "January 1, 2026";

const sections = [
  { id: "acceptance", title: "1. Acceptance of Terms" },
  { id: "services", title: "2. Description of Service" },
  { id: "accounts", title: "3. User Accounts & Security" },
  { id: "billing", title: "4. Subscription Billing & Payment" },
  { id: "acceptable-use", title: "5. Acceptable Use Policy" },
  { id: "intellectual-property", title: "6. Data Ownership & IP Rights" },
  { id: "sla", title: "7. Availability & Service Level SLA" },
  { id: "third-parties", title: "8. Third-Party Integrations" },
  { id: "termination", title: "9. Termination & Account Cancellation" },
  { id: "disclaimers", title: "10. Warranty Disclaimers" },
  { id: "liability", title: "11. Limitation of Liability" },
  { id: "indemnification", title: "12. Indemnification" },
  { id: "governing-law", title: "13. Governing Law & Dispute Resolution" },
  { id: "modifications", title: "14. Modifications to Terms" },
  { id: "contact", title: "15. Contact Legal Team" }
];
---

<Layout 
  title="Terms of Service | 180workspace"
  description="Review the Terms of Service for 180workspace. Clear, transparent terms governing the unified Work Graph business operating platform, SaaS subscriptions, and data ownership."
  canonicalUrl="https://180workspace.com/terms"
>
  <main class="w-full relative">
    
    <!-- Hero Header -->
    <section class="relative pt-24 pb-12 md:pt-36 md:pb-16 overflow-hidden border-b border-slate-200/80 dark:border-slate-800">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-gradient-to-tr from-indigo-500/15 via-blue-500/10 to-emerald-500/10 blur-[120px] rounded-full pointer-events-none -z-10"></div>
      <div class="absolute inset-0 bg-grid-pattern dark:bg-grid-pattern-dark [mask-image:radial-gradient(ellipse_70%_60%_at_50%_10%,#000_60%,transparent_100%)] -z-20"></div>

      <div class="container mx-auto px-4 max-w-5xl text-center">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800 shadow-sm mb-6">
          <svg class="w-4 h-4 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Legal Agreement</span>
        </div>
        
        <h1 class="display-h1 max-w-4xl mx-auto mb-6">
          Terms of <span class="bg-gradient-to-r from-indigo-600 via-blue-600 to-emerald-600 bg-clip-text text-transparent">Service</span>
        </h1>
        <p class="body-lead max-w-3xl mx-auto mb-6">
          Transparent, enterprise-ready contractual terms governing your use of the 180workspace operating system.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-semibold text-slate-500 dark:text-slate-400">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Effective: {effectiveDate}</span>
          </div>
          <span>•</span>
          <div class="flex items-center gap-1.5">
            <span>Last Updated: {lastUpdated}</span>
          </div>
          <span>•</span>
          <div class="flex items-center gap-1.5">
            <span>Version: 3.1</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content Grid -->
    <div class="container mx-auto px-4 max-w-7xl py-12 md:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Sticky Table of Contents (Desktop) -->
        <aside class="hidden lg:block lg:col-span-4">
          <div class="sticky top-28 p-6 rounded-3xl bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl border border-slate-200/80 dark:border-slate-800 shadow-xl shadow-slate-900/5">
            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-4 flex items-center gap-2">
              <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
              Table of Contents
            </h3>
            <nav class="space-y-1 text-xs">
              {sections.map((section) => (
                <a 
                  href={`#${section.id}`} 
                  class="block py-2 px-3 rounded-lg text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 font-medium transition-colors"
                >
                  {section.title}
                </a>
              ))}
            </nav>

            <div class="mt-6 pt-6 border-t border-slate-200/80 dark:border-slate-800">
              <div class="p-4 rounded-2xl bg-indigo-50/50 dark:bg-indigo-950/30 border border-indigo-100 dark:border-indigo-900/50 text-xs">
                <p class="font-bold text-slate-900 dark:text-white mb-1">Commercial Contracting</p>
                <p class="text-slate-600 dark:text-slate-400 mb-3">Enterprise custom master services agreement (MSA) inquiries?</p>
                <a href="mailto:legal@180workspace.com" class="inline-flex items-center gap-1 font-bold text-indigo-600 dark:text-indigo-400 hover:underline">
                  <span>legal@180workspace.com</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        </aside>

        <!-- Terms Content Body -->
        <article class="lg:col-span-8 space-y-12 text-slate-700 dark:text-slate-300 leading-relaxed text-sm md:text-base">
          
          <!-- Section 1: Acceptance -->
          <section id="acceptance" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
              1. Acceptance of Terms
            </h2>
            <p>
              By accessing, browsing, registering for, or using the services provided by <strong>180workspace</strong> ("180workspace," "we," "us," or "our") at <a href="https://180workspace.com" class="text-indigo-600 dark:text-indigo-400 font-semibold hover:underline">180workspace.com</a> or <a href="https://app.180workspace.com" class="text-indigo-600 dark:text-indigo-400 font-semibold hover:underline">app.180workspace.com</a> (the "Service"), you agree to be bound by these Terms of Service ("Terms").
            </p>
            <p>
              If you are agreeing to these Terms on behalf of an organization or enterprise entity, you represent and warrant that you have full legal authority to bind that organization. If you do not have such authority or do not agree with these Terms, you must not access or use the Service.
            </p>
          </section>

          <!-- Section 2: Services Description -->
          <section id="services" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
              2. Description of Service
            </h2>
            <p>
              180workspace provides a unified Work Graph business operating platform comprising 16 integrated software applications, including but not limited to:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs md:text-sm">
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
                <strong>Voiceforce (AI Calling & Telephony):</strong> Autonomous voice AI agents, virtual DIDs, and global telephony routing.
              </div>
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
                <strong>CRM & Pipeline Management:</strong> Contacts, deals, contracts & sales workflows.
              </div>
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
                <strong>Traffic Director:</strong> Edge URL routing, link attribution & bot protection.
              </div>
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
                <strong>Finance & Billing:</strong> Invoices, automated recurring billing & expense tracking.
              </div>
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
                <strong>Projects & Operations:</strong> Kanban boards, sprints, time tracking & tasks.
              </div>
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
                <strong>HR Management & Payroll:</strong> Employee directories, leave management & compensation.
              </div>
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800">
                <strong>Orbit Copilot:</strong> Context-aware AI meeting summaries & workflow automation.
              </div>
            </div>
          </section>

          <!-- Section 3: Accounts & Security -->
          <section id="accounts" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
              3. User Accounts & Access Security
            </h2>
            <p>
              To access the Service, you must create a verified tenant workspace account. You agree to:
            </p>
            <ul class="list-disc list-inside space-y-1.5 text-xs md:text-sm">
              <li>Provide accurate, current, and complete organization and contact information.</li>
              <li>Maintain the confidentiality of your login credentials and immediately notify 180workspace of any unauthorized account activity.</li>
              <li>Ensure all workspace users comply with these Terms. You are responsible for all activities occurring under your tenant account.</li>
            </ul>
          </section>

          <!-- Section 4: Subscription Billing -->
          <section id="billing" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
              4. Subscription Billing, Upgrades & Payment
            </h2>
            <div class="space-y-3 text-xs md:text-sm">
              <p>
                <strong>4.1 Subscription Plans:</strong> 180workspace is billed on a recurring monthly or annual subscription basis (e.g., Starter, Momentum at $12/month, or Enterprise).
              </p>
              <p>
                <strong>4.2 Payment Processing:</strong> Payments are processed through our PCI-DSS Level 1 certified billing partner, Stripe. By subscribing, you authorize 180workspace to charge your specified payment method on a recurring cycle until cancelled.
              </p>
              <p>
                <strong>4.3 Upgrades & Downgrades:</strong> Upgrading your plan is effective immediately with prorated billing. Downgrades take effect at the conclusion of the current billing cycle.
              </p>
              <p>
                <strong>4.4 Refund Policy:</strong> Subscriptions are non-refundable except where required by applicable consumer law. You may cancel your subscription at any time via your workspace billing dashboard.
              </p>
            </div>
          </section>

          <!-- Section 5: Acceptable Use -->
          <section id="acceptable-use" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
              5. Acceptable Use Policy (AUP)
            </h2>
            <p>You agree not to misuse the Service. Strictly prohibited activities include:</p>
            <div class="p-5 rounded-2xl bg-rose-50/60 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/50 space-y-2 text-xs md:text-sm text-slate-700 dark:text-slate-300">
              <ul class="list-disc list-inside space-y-1.5">
                <li>Deploying Voiceforce for illegal automated robocalling, fraudulent caller ID spoofing, or harassment in violation of TCPA, TSR, STIR/SHAKEN, or applicable telecommunications laws.</li>
                <li>Deploying Traffic Director for deceptive malware distribution, phishing, or click-fraud activities.</li>
                <li>Attempting to bypass tenant isolation boundaries, reverse-engineer proprietary algorithms, or perform unauthorized vulnerability stress tests.</li>
                <li>Sending unsolicited mass commercial communications (spam) in violation of CAN-SPAM, GDPR, or CASL.</li>
                <li>Using automated crawlers or scrapers to extract platform data outside authorized developer REST APIs.</li>
              </ul>
            </div>
          </section>

          <!-- Section 6: IP & Data Ownership -->
          <section id="intellectual-property" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
              6. Data Ownership & Intellectual Property
            </h2>
            <div class="space-y-3">
              <div class="p-5 rounded-2xl bg-indigo-50/50 dark:bg-indigo-950/30 border border-indigo-100 dark:border-indigo-900/50">
                <h3 class="font-bold text-slate-900 dark:text-white mb-2">Customer Data Ownership (100% Yours)</h3>
                <p class="text-xs md:text-sm text-slate-600 dark:text-slate-300">
                  You retain all right, title, and interest (including all intellectual property rights) in and to all data, records, files, and content you upload to 180workspace ("Customer Data"). We claim no ownership over your Work Graph data.
                </p>
              </div>
              <p class="text-xs md:text-sm">
                180workspace and its licensors retain all proprietary rights, copyright, and patent protections in the Service software, user interface designs, trademarks, and documentation.
              </p>
            </div>
          </section>

          <!-- Section 7: SLA -->
          <section id="sla" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
              7. Availability & Service Level Agreement (SLA)
            </h2>
            <p>
              We strive to maintain a <strong>99.9% uptime</strong> across our global infrastructure. Scheduled maintenance windows are communicated in advance and performed during low-traffic periods. Dedicated Enterprise SLAs with financial credits are available under custom enterprise agreements.
            </p>
          </section>

          <!-- Section 8: Third Parties -->
          <section id="third-parties" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
              8. Third-Party Integrations
            </h2>
            <p>
              The Service integrates with third-party providers (such as Google OAuth, Stripe, AWS, and Cloudflare). Your use of third-party services is subject to their respective terms and privacy policies. 180workspace is not responsible for outages or modifications caused by third-party platforms.
            </p>
          </section>

          <!-- Section 9: Termination -->
          <section id="termination" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
              9. Termination & Account Cancellation
            </h2>
            <p>
              You may terminate your account at any time via the workspace settings. 180workspace reserves the right to suspend or terminate accounts that violate our Acceptable Use Policy or engage in fraudulent activity. Upon termination, data is handled in accordance with Section 6 of our Privacy Policy.
            </p>
          </section>

          <!-- Section 10: Warranty Disclaimers -->
          <section id="disclaimers" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
              10. Warranty Disclaimers
            </h2>
            <p class="text-xs md:text-sm uppercase tracking-wide text-slate-500">
              TO THE MAXIMUM EXTENT PERMITTED BY LAW, THE SERVICE IS PROVIDED ON AN "AS IS" AND "AS AVAILABLE" BASIS WITHOUT WARRANTIES OF ANY KIND, WHETHER EXPRESS, IMPLIED, STATUTORY OR OTHERWISE, INCLUDING WITHOUT LIMITATION WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, OR NON-INFRINGEMENT.
            </p>
          </section>

          <!-- Section 11: Limitation of Liability -->
          <section id="liability" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
              11. Limitation of Liability
            </h2>
            <p class="text-xs md:text-sm text-slate-600 dark:text-slate-300">
              IN NO EVENT SHALL 180WORKSPACE, ITS OFFICERS, DIRECTORS, OR EMPLOYEES BE LIABLE FOR INDIRECT, PUNITIVE, INCIDENTAL, SPECIAL, OR CONSEQUENTIAL DAMAGES ARISING OUT OF THE USE OF THE SERVICE. OUR TOTAL AGGREGATE LIABILITY SHALL NOT EXCEED THE TOTAL FEES PAID BY YOU TO 180WORKSPACE IN THE TWELVE (12) MONTHS PRECEDING THE EVENT GIVING RISE TO LIABILITY.
            </p>
          </section>

          <!-- Section 12: Indemnification -->
          <section id="indemnification" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
              12. Indemnification
            </h2>
            <p>
              You agree to defend, indemnify, and hold harmless 180workspace and its affiliates from and against any third-party claims, damages, liabilities, and expenses arising out of your breach of these Terms or misuse of the Service.
            </p>
          </section>

          <!-- Section 13: Governing Law -->
          <section id="governing-law" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
              13. Governing Law & Dispute Resolution
            </h2>
            <p>
              These Terms shall be governed by and construed in accordance with the laws of the State of Delaware, United States, without regard to its conflict of law provisions. Any dispute arising out of or relating to these Terms shall be resolved via binding confidential arbitration.
            </p>
          </section>

          <!-- Section 14: Modifications -->
          <section id="modifications" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
              14. Modifications to Terms
            </h2>
            <p>
              We reserve the right to update these Terms from time to time. Material modifications will be notified via email or dashboard alert at least 14 days prior to taking effect. Continued use of the Service after changes constitute acceptance of the revised Terms.
            </p>
          </section>

          <!-- Section 15: Contact -->
          <section id="contact" class="scroll-mt-28 space-y-4">
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 dark:text-white tracking-tight">
              15. Contact Legal Team
            </h2>
            <p>
              For any questions or legal inquiries regarding these Terms of Service, please reach out to:
            </p>
            <div class="p-6 rounded-3xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-2 text-xs md:text-sm">
              <p class="font-bold text-slate-900 dark:text-white text-base">180workspace Legal Affairs</p>
              <p>Email: <a href="mailto:legal@180workspace.com" class="text-indigo-600 dark:text-indigo-400 font-bold hover:underline">legal@180workspace.com</a></p>
              <p>Enterprise Contracts: <a href="mailto:enterprise@180workspace.com" class="text-indigo-600 dark:text-indigo-400 font-bold hover:underline">enterprise@180workspace.com</a></p>
              <p>Website: <a href="https://180workspace.com" class="text-indigo-600 dark:text-indigo-400 font-bold hover:underline">https://180workspace.com</a></p>
            </div>
          </section>

        </article>
      </div>
    </div>

  </main>
</Layout>
