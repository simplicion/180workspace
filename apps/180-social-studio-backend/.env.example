# 180 Social Studio Dedicated Backend Environment Configuration

# Server
PORT=4005
NODE_ENV=development
API_BASE_URL=http://localhost:4005
CLIENT_URL=http://localhost:3000,http://localhost:3002

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/180_social_studio?schema=public"

# Token Encryption Vault (AES-256-GCM Master Key for OAuth tokens)
SOCIAL_TOKEN_ENCRYPTION_KEY="replace_with_32_char_master_key_for_oauth_tokens"

# Authentication & Sessions
JWT_SECRET="replace_with_jwt_secret"
JWT_ACCESS_SECRET="replace_with_jwt_access_secret"
JWT_REFRESH_SECRET="replace_with_jwt_refresh_secret"

# Media Storage (S3 / Cloudflare R2 / AWS)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME="180-social-studio-media"
MEDIA_STORAGE_DRIVER="local"

# AI Capabilities (Audio Transcriptions & Captions)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Platform OAuth Integrations
META_APP_ID=""
META_APP_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
