{
    "watch": ["src", "server.js", "package.json", "../../packages/*/src", "../../packages/**/src", "../../packages/*/dist", "../../packages/**/dist"],
    "ext": "js,json,ts",
    "exec": "tsx server.js",
    "ignore": [
        "node_modules",
        "*.test.js",
        "*.spec.js",
        "logs",
        "coverage",
        "../../apps/user-web/.next",
        "../../apps/user-web/node_modules"
    ],
    "delay": "500"
}
