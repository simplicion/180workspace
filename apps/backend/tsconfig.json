{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/ai": ["../../packages/domains/ai/dist"],
      "@workspace/video-contracts": ["../../packages/video-contracts/src"],
      "@workspace/video-contracts/*": ["../../packages/video-contracts/src/*"],
      "@workspace/video-engine-runtime": ["../../packages/video-engine-runtime/src"],
      "@workspace/video-engine-runtime/*": ["../../packages/video-engine-runtime/src/*"]
    }
  },
  "include": ["src/**/*", "server.js"],
  "exclude": ["node_modules", "dist"]
}
