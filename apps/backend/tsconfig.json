      "@workspace/projects-and-tasks-domain": ["../../packages/domains/projects-and-tasks/src/index.ts"],
      "@workspace/projects-and-tasks-domain/*": ["../../packages/domains/projects-and-tasks/src/*"],
      "@workspace/public": ["../../packages/domains/public/src/index.ts"],
      "@workspace/public/*": ["../../packages/domains/public/src/*"],
      "@workspace/rag": ["../../packages/domains/rag/src/index.ts"],
      "@workspace/rag/*": ["../../packages/domains/rag/src/*"],
      "@workspace/settings": ["../../packages/domains/settings/src/index.ts"],
      "@workspace/settings/*": ["../../packages/domains/settings/src/*"],
      "@workspace/social-media": ["../../packages/domains/social-media/src/index.ts"],
      "@workspace/social-media/*": ["../../packages/domains/social-media/src/*"],
      "@workspace/traffic-director": ["../../packages/domains/traffic-director/src/index.ts"],
