{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "CommonJS",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@workspace/backend-infra": ["../../packages/backend-common/src/index.ts"],
      "@workspace/backend-infra/*": ["../../packages/backend-common/src/*"],
      "@workspace/db": ["../../packages/db/src/index.ts"],
      "@workspace/db/*": ["../../packages/db/src/*"],
      "@workspace/ai": ["../../packages/domains/ai/src/index.ts"],
      "@workspace/ai/*": ["../../packages/domains/ai/src/*"],
      "@workspace/automations": ["../../packages/domains/automations/src/index.ts"],
      "@workspace/automations/*": ["../../packages/domains/automations/src/*"],
      "@workspace/communications": ["../../packages/domains/communications/src/index.ts"],
      "@workspace/communications/*": ["../../packages/domains/communications/src/*"],
      "@workspace/company": ["../../packages/domains/company/src/index.ts"],
      "@workspace/company/*": ["../../packages/domains/company/src/*"],
      "@workspace/crm-and-sales": ["../../packages/domains/crm-and-sales/src/index.ts"],
      "@workspace/crm-and-sales/*": ["../../packages/domains/crm-and-sales/src/*"],
      "@workspace/engine": ["../../packages/domains/engine/src/index.ts"],
      "@workspace/engine/*": ["../../packages/domains/engine/src/*"],
      "@workspace/finance": ["../../packages/domains/finance/src/index.ts"],
      "@workspace/finance/*": ["../../packages/domains/finance/src/*"],
      "@workspace/hr-management": ["../../packages/domains/hr-management/src/index.ts"],
      "@workspace/hr-management/*": ["../../packages/domains/hr-management/src/*"],
      "@workspace/identity": ["../../packages/domains/identity/src/index.ts"],
      "@workspace/identity/*": ["../../packages/domains/identity/src/*"],
      "@workspace/identity-sdk": ["../../packages/identity-sdk/src/index.tsx"],
      "@workspace/identity-sdk/*": ["../../packages/identity-sdk/*"],
      "@workspace/insights": ["../../packages/domains/insights/src/index.ts"],
      "@workspace/insights/*": ["../../packages/domains/insights/src/*"],
      "@workspace/integrations": ["../../packages/domains/integrations/src/index.ts"],
      "@workspace/integrations/*": ["../../packages/domains/integrations/src/*"],
      "@workspace/platform-admin": ["../../packages/domains/platform-admin/src/index.ts"],
