{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/ai": ["../../packages/domains/ai/dist"]
    }
  },
  "include": ["src/**/*", "server.js"],
  "exclude": ["node_modules", "dist"]
}
