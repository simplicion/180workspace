{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "CommonJS",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@workspace/ai": ["../../packages/domains/ai/dist"],
      "@workspace/video-contracts": ["../../packages/video-contracts/dist/index.d.ts"],
      "@workspace/video-contracts/*": ["../../packages/video-contracts/dist/*"],
      "@workspace/db-180core": ["../../packages/db-180developers/dist"],
      "@workspace/identity-provider": ["../../packages/domains/identity-provider/dist"],
      "@workspace/identity-sdk": ["../../packages/identity-sdk/dist/index.js", "../../packages/identity-sdk/src/index.tsx"],
      "@workspace/identity-sdk/*": ["../../packages/identity-sdk/*"],
      "@workspace/workspace-auth": ["../../packages/domains/workspace-auth/dist/index.js", "../../packages/domains/workspace-auth/src/index.ts"],
      "@workspace/workspace-auth/*": ["../../packages/domains/workspace-auth/*"]
    }
  },
  "include": ["src/**/*", "server.js"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "src/**/*.test.ts"]
}
