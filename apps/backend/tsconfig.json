      "@workspace/video-engine-runtime": ["../../packages/video-engine-runtime/src/index.ts"],
      "@workspace/video-engine-runtime/*": ["../../packages/video-engine-runtime/src/*"],
      "@workspace/voiceforce": ["../../packages/domains/voiceforce/src/index.ts"],
      "@workspace/voiceforce/*": ["../../packages/domains/voiceforce/src/*"],
      "@workspace/wallet": ["../../packages/domains/wallet/src/index.ts"],
      "@workspace/wallet/*": ["../../packages/domains/wallet/src/*"],
      "@workspace/workspace-auth": ["../../packages/domains/workspace-auth/src/index.ts"],
      "@workspace/workspace-auth/*": ["../../packages/domains/workspace-auth/src/*"],
      "@workspace/workspace-tools": ["../../packages/domains/workspace-tools/src/index.ts"],
      "@workspace/workspace-tools/*": ["../../packages/domains/workspace-tools/src/*"]
    }
  },
  "include": ["src/**/*", "server.js"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "src/**/*.test.ts"]
