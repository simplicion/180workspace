# ==========================================
# API Configuration
# ==========================================
# Backend API URL
NEXT_PUBLIC_API_URL=https://api.180workspace.com

# Socket.IO URL
NEXT_PUBLIC_SOCKET_URL=https://api.yourdomain.com

# ==========================================
# Application Settings
# ==========================================
# Main domain for subdomain detection
NEXT_PUBLIC_MAIN_DOMAIN=yourdomain.com

# ==========================================
# NextAuth Configuration
# ==========================================
# The base URL of your application
NEXTAUTH_URL=https://yourdomain.com
# Secret used to encrypt NextAuth session data
NEXTAUTH_SECRET=your_nextauth_secret_here

# ==========================================
# Authentication & Identity (Google OAuth)
# ==========================================
# Google Client ID (Public)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
# Google Client ID (Backend)
GOOGLE_CLIENT_ID=your_google_client_id_here
# Google Client Secret (Backend)
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:port/db

# ==========================================
# Email Configuration (Nodemailer SMTP)
# ==========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM=noreply@example.com

# ==========================================
# Payment Gateway (Razorpay)
# ==========================================
# Public Razorpay Key
NEXT_PUBLIC_RAZORPAY_KEY=your_razorpay_key_here
# Backend Razorpay Key ID
RAZORPAY_KEY_ID=your_razorpay_key_id
# Backend Razorpay Key Secret
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Backend Razorpay Webhook Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Razorpay Webhook URL
RAZORPAY_WEBHOOK_URL=your_razorpay_webhook_url

CLIENT_URL="https://app.180workspace.com,https://180workspace.com,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003"

# Skip Prisma Generate on Vercel install
PRISMA_GENERATE_SKIP=true

# ==========================================
# Stock Media & B-Roll (Pexels & Pixabay)
# ==========================================
PEXELS_API_KEY="your_pexels_api_key_here"
NEXT_PUBLIC_PEXELS_API_KEY="your_pexels_api_key_here"
PIXABAY_API_KEY="your_pixabay_api_key_here"
NEXT_PUBLIC_PIXABAY_API_KEY="your_pixabay_api_key_here"


# ==========================================
# Desktop app downloads
# ==========================================
# HTTPS URLs of the installers published by .github/workflows/desktop-release.yml (GitHub Releases / CDN).
# Set the same variables on the backend. When unset, /api/download/<platform> answers 404 rather than serving a placeholder.
DESKTOP_DOWNLOAD_URL_WINDOWS=""
DESKTOP_DOWNLOAD_URL_MAC=""
DESKTOP_DOWNLOAD_URL_LINUX=""

# LOCAL DEVELOPMENT ONLY. Lets you open the video editor in a normal browser instead of the desktop app.
# Never set this in a production build: media processing is a desktop-app-only feature.
# NEXT_PUBLIC_ALLOW_BROWSER_MEDIA_EDITOR=true
