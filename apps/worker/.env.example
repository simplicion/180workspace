# ==========================================
# Server Configuration
# ==========================================
# Environment mode (development/production)
NODE_ENV=production
# Service run mode (api/worker/both)
RUN_MODE=worker
# Port to run the server on
PORT=4000

# ==========================================
# Security & JWT Secrets
# ==========================================
# Secret for signing access tokens
JWT_SECRET=your_jwt_secret_here
# Secret for signing refresh tokens
JWT_REFRESH_SECRET=your_refresh_secret_here
# Secret for super admin authentication
SUPER_ADMIN_JWT_SECRET=your_super_admin_secret_here

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:port/db

# ==========================================
# Cache & Queues (Redis)
# ==========================================
# Redis connection URL
REDIS_URL=redis://user:password@host:port
# Internal Redis URL (if applicable)
REDIS_INTERNAL_URL=redis://user:password@host:port

# ==========================================
# Authentication (Google OAuth)
# ==========================================
# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here
# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ==========================================
# Default Admin Credentials
# ==========================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# ==========================================
# Cloudflare R2 Storage (CDN)
# ==========================================
R2_ENDPOINT=https://account_id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_bucket
REELS_CDN_URL=https://your_cdn_domain.com
R2_ACCESS_KEY=your_access_key
R2_SECRET_KEY=your_secret_key

# ==========================================
# Email Configuration (Nodemailer SMTP)
# ==========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM=noreply@example.com

# ==========================================
# Payment Gateway (Razorpay)
# ==========================================
# Backend Razorpay Key ID
RAZORPAY_KEY_ID=your_razorpay_key_id
# Backend Razorpay Key Secret
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

CLIENT_URL="https://180workspace.com,https://180workspace.com,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003"

# Skip Prisma Generate on Vercel install
PRISMA_GENERATE_SKIP=true
