## Proposed Technical Changes

### 1. Database Layer (`packages/db`)

#### [MODIFY] [schema.prisma](file:///c:/Users/saavi/OneDrive/Desktop/180workspace/packages/db/prisma/schema.prisma)
Add the following Prisma models to support the Traffic Director domain:

```prisma
model TrafficLink {
  id             String         @id @default(uuid())
  companyId      String
  name           String
  slug           String         @unique
  description    String?
  fallbackUrl    String
  isActive       Boolean        @default(true)
  customDomain   String?
  tags           String[]       @default([])
  totalClicks    Int            @default(0)
  rules          TrafficRule[]
  logs           TrafficLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([slug])
}

model TrafficRule {
  id             String         @id @default(uuid())
  linkId         String
  name           String
  priority       Int            @default(0)
  isActive       Boolean        @default(true)
  destinationUrl String
  actionType     String         @default("redirect") // redirect_302, redirect_301, redirect_307, rewrite
  conditions     Json           // Array of condition criteria: { type: 'geo'|'device'|'header'|'query'|'bot'|'time', operator: 'eq'|'in'|'regex', value: any }
  weight         Int            @default(100) // For split-testing within rule
  matchCount     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  link           TrafficLink    @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([priority])
}

model TrafficLog {
  id             String         @id @default(uuid())
  linkId         String
  ruleId         String?
  ipAddress      String?
  country        String?
  city           String?
  deviceType     String?
  os             String?
  browser        String?
  userAgent      String?
  referrer       String?
  isBot          Boolean        @default(false)
  botName        String?
  destinationUrl String
  responseStatus Int            @default(302)
  latencyMs      Int            @default(0)
  timestamp      DateTime       @default(now())

  link           TrafficLink    @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, timestamp])
  @@index([timestamp])
}
```

