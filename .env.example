# ==========================================
# 180 Workspace Environment Configuration Template
# ==========================================
NODE_ENV=production
RUN_MODE=both
PORT=4002

# ==========================================
# Security & JWT Secrets
# ==========================================
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
SUPER_ADMIN_JWT_SECRET=your_super_admin_jwt_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_here

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/180workspace_db
CORE_DATABASE_URL=postgresql://user:password@localhost:5432/180core_db?schema=180core

# ==========================================
# Cache & Queues (Redis)
# ==========================================
REDIS_URL=redis://127.0.0.1:6379
REDIS_INTERNAL_URL=redis://127.0.0.1:6379

# ==========================================
# Authentication (Google OAuth)
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================================
# Storage & CDN (Cloudflare R2 / S3)
# ==========================================
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=180workspace
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key

# ==========================================
# AI Models & Agents
# ==========================================
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ==========================================
# 180 Voiceforce & Telephony
# ==========================================
CARTESIA_API_KEY=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""

# ==========================================
# SMS Gateway (MSG91)
# ==========================================
MSG91_AUTH_KEY=""
