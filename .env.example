# ==========================================
# 180 Workspace Environment Configuration Template
# ==========================================
NODE_ENV=production
RUN_MODE=both
PORT=4002

# ==========================================
# Security & JWT Secrets
# ==========================================
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
SUPER_ADMIN_JWT_SECRET=your_super_admin_jwt_secret_here

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/180workspace_db

# ==========================================
# Cache & Queues (Redis)
# ==========================================
REDIS_URL=redis://127.0.0.1:6379
REDIS_INTERNAL_URL=redis://127.0.0.1:6379

# ==========================================
# Authentication (Google OAuth)
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================================
# Storage & CDN (Cloudflare R2 / S3)
# ==========================================
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=180workspace
REELS_CDN_URL=https://your-r2-subdomain.r2.dev
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key

# ==========================================
# Social Media Publishing & Multi-Platform Hub
# ==========================================
ALLOW_SIMULATED_PUBLISHING=false
SIMULATE_SOCIAL_PUBLISHING=false

SOCIAL_OAUTH_CALLBACK_BASE_URL="https://api.180workspace.com"
SOCIAL_MEDIA_PUBLIC_BASE_URL="https://api.180workspace.com"
SOCIAL_TOKEN_ENCRYPTION_KEY="your_base64_32byte_aes_key"

SOCIAL_SCHEDULER_ENABLED=true
SOCIAL_SCHEDULER_INTERVAL_MS=30000
SOCIAL_TOKEN_REFRESH_SKEW_SEC=300

# Meta Platform & Graph API (Facebook & Instagram)
META_APP_ID=""
META_APP_SECRET=""
META_BUSINESS_ID=""
META_GRAPH_VERSION="v21.0"
META_WEBHOOK_VERIFY_TOKEN=""

# Instagram Business Login
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# Threads API
THREADS_APP_ID=""
THREADS_APP_SECRET=""

# LinkedIn Marketing & Community Management API
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_PROVIDER_MODE="mock" # Set to 'live' when approved by LinkedIn
LINKEDIN_API_VERSION="202507"
LINKEDIN_SCOPES="openid,profile,w_member_social,r_organization_social,w_organization_social"

# YouTube Data API v3 & Analytics (Falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET if empty)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_PROVIDER_MODE="mock" # Set to 'live' for real YouTube publishing via Google Cloud OAuth
YOUTUBE_SCOPES="https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/youtube.force-ssl https://www.googleapis.com/auth/yt-analytics.readonly"

# X (Twitter) API v2
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Pinterest Platform
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""

# Reddit Developer API
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
