{
  "name": "@workspace/identity-sdk",
  "version": "1.0.0",
  "description": "Universal Client SDK for 180 Identity Single Sign-On and 180 Pay Sovereign Checkout (180 Core SDK)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/180-core-sdk.d.ts",
      "default": "./dist/180-core-sdk.js"
    },
    "./180-core-sdk": {
      "types": "./dist/180-core-sdk.d.ts",
      "default": "./dist/180-core-sdk.js"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); fs.copyFileSync('./src/180-core-sdk.js', './dist/180-core-sdk.js'); fs.copyFileSync('./src/180-core-sdk.min.js', './dist/180-core-sdk.min.js'); fs.copyFileSync('./src/180-core-sdk.d.ts', './dist/180-core-sdk.d.ts');\""
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
