generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                                       String                @id @default(uuid())
  name                                     String
  slug                                     String?               @unique
  logoUrl                                  String?
  bannerUrl                                String?
  oneLineDescription                       String?
  industry                                 String?
  startupStage                             String?
  teamSize                                 String?
  country                                  String?
  website                                  String?
  customDomain                             String?               @unique
  foundedDate                              DateTime?
  companyType                              String?
  tagline                                  String?
  headquarters                             String?
  otherOffices                             String?
  aboutUs                                  String?
  vision                                   String?
  mission                                  String?
  story                                    String?
  coreValues                               Json?                 @default("[]")
  socialLinks                              Json?                 @default("{}")
  productsBuilt                            String?
  happyClients                             String?
  countriesActive                          String?
  awardsCount                              String?
  topRecognition                           String?
  companyHighlights                        Json?                 @default("[]")
  profileViews                             Int                   @default(0)
  followersCount                           Int                   @default(0)
  privacySettings                          Json?                 @default("{}")
  adminName                                String?
  adminEmail                               String?               @unique
  adminPhone                               String?
  adminPasswordHash                        String?
  adminRole                                String                @default("admin")
  databaseConfigured                       Boolean               @default(false)
  isOnboardingComplete                     Boolean               @default(false)
  subscriptionStatus                       String                @default("trial")
  accountStatus                            String                @default("active")
  totalUsers                               Int                   @default(0)
  currency                                 String?               @default("USD")
  currencySymbol                           String?               @default("$")
  metadata                                 Json?                 @default("{}")
  trialStartDate                           DateTime?
  trialEndDate                             DateTime?
  nextChargeDate                           DateTime?
  autopayEnabled                           Boolean               @default(false)
  mandateStatus                            String?
  createdAt                                DateTime              @default(now())
  updatedAt                                DateTime              @updatedAt
  attendances                              Attendance[]
  auditLogs                                AuditLog[]
  automationLogs_CompanyAutomationLogs     AutomationLog[]       @relation("CompanyAutomationLogs")
  clients_CompanyClients                   Client[]              @relation("CompanyClients")
  CompanyConfig                            CompanyConfig?
  coreValueItems                           CompanyCoreValue[]
  followersList                            CompanyFollower[]     @relation("CompanyFollowers")
  investors                                CompanyInvestor[]
  media                                    CompanyMedia[]
  publicReviews                            CompanyPublicReview[] @relation("CompanyPublicReviews")
  offerings                                CompanyOffering[]
  contentCalendars_CompanyContentCalendars ContentCalendar[]     @relation("CompanyContentCalendars")
  designations                             Designation[]
  documents_CompanyDocuments               Document[]            @relation("CompanyDocuments")
  emailLogs_CompanyEmailLogs               EmailLog[]            @relation("CompanyEmailLogs")
  events_CompanyEvents                     Event[]               @relation("CompanyEvents")
  expenseTransactions                      ExpenseTransaction[]
  goals                                    Goal[]
  holidays_CompanyHolidays                 Holiday[]             @relation("CompanyHolidays")
  jobs_CompanyJobs                         Job[]                 @relation("CompanyJobs")

  Leave                          Leave[]
  meetingLogs_CompanyMeetingLogs MeetingLog[]         @relation("CompanyMeetingLogs")
  projects                       Project[]
  reviews                        Review[]
  salaries                       Salary[]
  serviceRequests                ServiceRequest[]
  Settings                       Settings?
  tasks                          Task[]
  CompanyTransaction             CompanyTransaction[]
  users                          User[]
  vendors_CompanyVendors         Vendor[]             @relation("CompanyVendors")

  workLogs_CompanyWorkLogs WorkLog[]          @relation("CompanyWorkLogs")
  assets                   Asset[]
  forms                    Form[]
  knowledgeArticles        KnowledgeArticle[]
  savedBanks               SavedBank[]
  teamActivityLogs         TeamActivityLog[]
  calendarEvents           CalendarEvent[]    @relation("CompanyCalendarEvents")
  trafficLinks             TrafficLink[]
  voiceAgents              VoiceAgent[]
  phoneNumbers             PhoneNumber[]
  callCampaigns            CallCampaign[]
  callSessions             CallSession[]
  voiceBalanceInr          Float                  @default(0.0)
  voiceAutoRecharge        Boolean                @default(false)
  voiceThresholdInr        Float                  @default(200.0)
  voiceRechargeAmountInr   Float                  @default(1000.0)
  voiceTransactions        VoiceWalletTransaction[]
  dncRegistries            DncRegistry[]
  forwardingRules          ForwardingRule[]
  callQueues               CallQueue[]
  dailyVoiceBriefings      DailyVoiceBriefing[]
  ragVaults                RagMemoryVault[]
  documentCategories       DocumentCategory[]
  agentRequests            AgentRequest[]
}

model SavedBank {
  id        String   @id @default(uuid())
  companyId String
  type      String
  name      String
  content   String
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyCoreValue {
  id          String   @id @default(uuid())
  companyId   String
  title       String
  description String
  iconUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model CompanyPublicReview {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  rating      Float
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation("CompanyPublicReviews", fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model CompanyFollower {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  createdAt DateTime @default(now())
  company   Company  @relation("CompanyFollowers", fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation("UserFollowingCompanies", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model CompanyConfig {
  id                   String    @id @default(uuid())
  companyId            String    @unique
  company              Company   @relation(fields: [companyId], references: [id])
  invoices             Invoice[]
  companyPaymentConfig Json?     @default("{}")
  storageUsedBytes     Float     @default(0)
  onboardingCompleted  Boolean   @default(false)
  timezone             String    @default("Asia/Kolkata")
  dateFormat           String    @default("DD/MM/YYYY")
  timeFormat           String    @default("12h")
  createdAt            DateTime  @default(now())

  @@index([companyId])
  @@index([companyId, id])
}

model Client {
  id        String  @id @default(uuid())
  name      String
  companyId String?

  email           String?
  phone           String?
  website         String?
  industry        String?
  clientType      String?
  taxId           String?
  billingAddress  String?
  location        String?
  status          String?
  notes           String?
  clientId        String?
  companyName     String?
  title           String?
  lastContacted   DateTime?
  employeeCount   String?
  annualRevenue   Float?    @default(0)
  clv             Float?    @default(0)
  healthStatus    String?   @default("Healthy")
  assignedManager String?
  customIndustry  String?
  country         String?
  leadSource      String?
  clientTier      String?
  category        String?

  // Recommended CRM Fields added for 180workspace
  shippingAddress   String?
  contactPersonName String?
  socialMediaLinks  Json?
  paymentTerms      String?
  currency          String?

  calendarEvents    CalendarEvent[] @relation("CalendarEventClients")

  automationLogs_AutomationTargetClient   AutomationLog[]       @relation("AutomationTargetClient")
  company                                 Company?              @relation("CompanyClients", fields: [companyId], references: [id])
  ClientCommunication                     ClientCommunication[]
  contentCalendars_ClientContentCalendars ContentCalendar[]     @relation("ClientContentCalendars")
  expenseTransactions                     ExpenseTransaction[]
  invoices                                Invoice[]
  CompanyTransaction                      CompanyTransaction[]  @relation("TransactionClient")
  deals                                   Deal[]                @relation("ClientDeals")
  salesActivities                         SalesActivity[]       @relation("ActivityClient")
  tasks                                   Task[]
  documents                               Document[]            @relation("ClientDocuments")

  @@index([companyId])
  @@index([companyId, id])
}

model ClientCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Designation {
  id         String   @id @default(uuid())
  name       String
  category   String   @default("general")
  isCustom   Boolean  @default(false)
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  users      User[]   @relation("UserDesignation")

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model User {
  id                                    String                @id @default(uuid())
  name                                  String
  email                                 String                @unique
  emailVerified                         DateTime?
  googleId                              String?               @unique
  password                              String?
  role                                  String                @default("employee")
  designationId                         String?
  permissions                           String[]              @default([])
  image                                 String?
  photoUrl                              String?
  bannerImage                           String?
  phone                                 String?
  isActive                              Boolean               @default(true)
  canViewActivity                       Boolean               @default(false)
  otpCode                               String?
  otpExpiry                             DateTime?
  username                              String?               @unique
  headline                              String?
  title                                 String?
  signatureImage                        String?
  companyName                           String?
  bio                                   String?
  city                                  String?
  country                               String?
  address                               String?
  socialLinks                           Json?
  highlights                            Json?                 @default("[]")
  interests                             String[]              @default([])
  employeeId                            String?
  department                            String?
  position                              String?
  joinDate                              DateTime?
  performanceScore                      Int                   @default(100)
  salary                                Float                 @default(0)
  leaveBalance                          Float                 @default(20)
  emergencyContact                      String?
  bankAccount                           String?
  employmentType                        String?
  workLocation                          String?
  managerId                             String?
  mfaEnabled                            Boolean               @default(false)
  mfaSecret                             String?
  isFirstLogin                          Boolean               @default(true)
  apiKey                                String?
  apiKeyEnabled                         Boolean               @default(false)
  companyId                             String?
  deletedAt                             DateTime?
  createdAt                             DateTime              @default(now())
  updatedAt                             DateTime              @updatedAt
  accounts                              Account[]
  aiChatSessions                        AiChatSession[]       @relation("UserAiChatSessions")
  aiRequestLogs_AiRequestLogs           AiRequestLog[]        @relation("AiRequestLogs")
  applications_UserApplicationsReviewed Application[]         @relation("UserApplicationsReviewed")
  applications_Applied                  Application[]         @relation("UserApplicationsApplied")
  createdAssets                         Asset[]               @relation("AssetCreator")
  ownedAssets                           Asset[]               @relation("AssetOwner")
  attendances                           Attendance[]          @relation("EmployeeAttendance")
  markedAttendances                     Attendance[]          @relation("MarkedByAttendance")
  auditLogs                             AuditLog[]            @relation("UserAuditLogs")
  automationTargetUser                  AutomationLog[]       @relation("AutomationTargetUser")
  automationTriggered                   AutomationLog[]       @relation("AutomationTriggered")
  calendarEvents                        CalendarEvent[]       @relation("EventCreator")
  calendarTemplates_CalendarTemplates   CalendarTemplate[]    @relation("CalendarTemplates")
  chatsCreated                          Chat[]                @relation("ChatCreator")
  clientCommunications                  ClientCommunication[] @relation("ClientCommunicationLogger")
  followedCompanies                     CompanyFollower[]     @relation("UserFollowingCompanies")
  companyPublicReviews                  CompanyPublicReview[]
  documents_UserDocuments               Document[]            @relation("UserDocuments")
  documentPagesCreated                  DocumentPage[]        @relation("UserDocumentPagesCreated")
  documentPagesUpdated                  DocumentPage[]        @relation("UserDocumentPagesUpdated")
  emailLogs_UserEmailLogs               EmailLog[]            @relation("UserEmailLogs")
  expenseTransactions                   ExpenseTransaction[]  @relation("ExpenseTransactionEmployee")
  expenseTransactionsReviewed           ExpenseTransaction[]  @relation("ExpenseTransactionReviewer")
  forumPosts_UserForumPosts             ForumPost[]           @relation("UserForumPosts")
  forumReplys_UserForumReplies          ForumReply[]          @relation("UserForumReplies")
  goalsOwned                            Goal[]                @relation("GoalOwner")
  invoicesCreated                       Invoice[]

  leavesRequested                    Leave[]              @relation("LeaveEmployee")
  leavesReviewed                     Leave[]              @relation("LeaveReviewer")
  meetingLogs_UserMeetingLogsCreated MeetingLog[]         @relation("UserMeetingLogsCreated")
  messagesDeleted                    Message[]            @relation("MessageDeletedBy")
  messagesSent                       Message[]            @relation("MessageSender")
  milestonesCompleted                Milestone[]          @relation("MilestoneCompleter")
  milestonesCreated                  Milestone[]          @relation("MilestoneCreator")
  createdModules                     Module[]             @relation("ModuleCreator")
  ownedModules                       Module[]             @relation("ModuleOwner")
  notesCreated                       Note[]               @relation("NoteCreator")
  notifications                      Notification[]       @relation("UserNotification")
  onboardings_UserOnboardings        Onboarding?          @relation("UserOnboardings")
  pollVotes                          PollVote[]           @relation("UserPollVotes")
  postReports                        PostReport[]         @relation("UserPostReports")
  reviewsReceived                    Review[]             @relation("ReviewEmployee")
  reviewsGiven                       Review[]             @relation("ReviewManager")
  salaries                           Salary[]             @relation("SalaryEmployee")
  salariesGenerated                  Salary[]             @relation("SalaryGeneratedBy")
  resolvedAgentRequests              AgentRequest[]       @relation("ResolvedAgentRequests")
  savedPosts                         SavedPost[]          @relation("UserSavedPosts")
  sessions                           Session[]
  assignedTasks                      Task[]               @relation("TaskAssignee")
  createdTasks                       Task[]               @relation("TaskCreator")
  companyTransactions                CompanyTransaction[] @relation("TransactionUser")
  timeLogs_UserTimeLogs              TimeLog[]            @relation("UserTimeLogs")
  company                            Company?             @relation(fields: [companyId], references: [id])
  designation                        Designation?         @relation("UserDesignation", fields: [designationId], references: [id])
  manager                            User?                @relation("UserManager", fields: [managerId], references: [id])
  subordinates                       User[]               @relation("UserManager")
  educations                         UserEducation[]
  experiences                        UserExperience[]
  userPreferences_UserPreferences    UserPreference?      @relation("UserPreferences")
  userProjects                       UserProject[]
  resumes                            UserResume[]
  skills                             UserSkill[]
  workLogsReviewed                   WorkLog[]            @relation("UserWorkLogsReviewed")
  workLogs                           WorkLog[]            @relation("UserWorkLogs")
  chatsAdministered                  Chat[]               @relation("ChatAdmins")
  chatsJoined                        Chat[]               @relation("ChatMembers")
  goalsAssigned                      Goal[]               @relation("GoalAssignedTo")
  meetingAttended                    CalendarEvent[]      @relation("MeetingAttendees")
  messagesMentioned                  Message[]            @relation("MessageMentions")
  messagesRead                       Message[]            @relation("MessageReadBy")
  messagesStarred                    Message[]            @relation("MessageStarredBy")
  postMentions                       ForumPost[]          @relation("PostMentions")
  User_UserFollows_A                 User[]               @relation("UserFollows")
  User_UserFollows_B                 User[]               @relation("UserFollows")
  assignedLeads                      Lead[]               @relation("DealAssignedRep")
  ownedDeals                         Deal[]               @relation("LeadOwner")
  salesActivitiesOwned               SalesActivity[]      @relation("SalesActivityOwner")
  quotesCreated                      Quote[]              @relation("QuoteCreator")

  knowledgeCreated  KnowledgeArticle[]        @relation("KnowledgeCreatedBy")
  knowledgeUpdated  KnowledgeArticle[]        @relation("KnowledgeUpdatedBy")
  knowledgeLocked   KnowledgeArticle[]        @relation("KnowledgeLockedBy")
  knowledgeVersions KnowledgeArticleVersion[] @relation("KnowledgeVersionCreator")
  teamActivityLogs  TeamActivityLog[]         @relation("UserTeamActivityLogs")
  employeeDocuments Document[]                @relation("EmployeeDocuments")

  @@unique([companyId, employeeId])
  @@index([companyId])
  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model Project {
  id                                       String               @id @default(uuid())
  name                                     String
  description                              String?
  status                                   String               @default("not_started")
  priority                                 String               @default("medium")
  deadline                                 DateTime?
  startDate                                DateTime             @default(now())
  progress                                 Int                  @default(0)
  budget                                   Float                @default(0)
  projectType                              String               @default("internal")
  visibility                               String               @default("public")
  billingType                              String               @default("non_billable")
  ownerId                                  String?
  memberIds                                String[]
  clientIds                                String[]
  tags                                     String[]
  companyId                                String?
  createdAt                                DateTime             @default(now())
  updatedAt                                DateTime             @updatedAt
  deletedAt                                DateTime?
  customTaskStatusName                     String?              @default("Custom")
  contentCalendars_ProjectContentCalendars ContentCalendar[]    @relation("ProjectContentCalendars")
  expenseTransactions                      ExpenseTransaction[]
  goals                                    Goal[]               @relation("GoalProject")
  invoices                                 Invoice[]
  milestones                               Milestone[]          @relation("ProjectMilestones")
  modules_ProjectModules                   Module[]             @relation("ProjectModules")
  company                                  Company?             @relation(fields: [companyId], references: [id])
  tasks                                    Task[]
  documents                                Document[]           @relation("ProjectDocuments")
  timeLogs_ProjectTimeLogs                 TimeLog[]            @relation("ProjectTimeLogs")
  workLogs_ProjectWorkLogs                 WorkLog[]            @relation("ProjectWorkLogs")

  @@index([companyId, status])
  @@index([companyId])
  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model Task {
  id                    String    @id @default(uuid())
  title                 String
  description           String?
  status                String    @default("todo")
  priority              String    @default("medium")
  dueDate               DateTime?
  estimatedHours        Float     @default(0)
  isOverdueNotified     Boolean   @default(false)
  completedOnTime       Boolean?
  projectId             String?
  assigneeId            String?
  creatorId             String?
  companyId             String?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  attachments           String[]  @default([])
  voiceMessageUrl       String?
  moduleId              String?
  clientId              String?
  assignee              User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  company               Company?  @relation(fields: [companyId], references: [id])
  creator               User?     @relation("TaskCreator", fields: [creatorId], references: [id])
  module                Module?   @relation(fields: [moduleId], references: [id])
  project               Project?  @relation(fields: [projectId], references: [id])
  client                Client?   @relation(fields: [clientId], references: [id])
  timeLogs_TaskTimeLogs TimeLog[] @relation("TaskTimeLogs")
  workLogs_TaskWorkLogs WorkLog[] @relation("TaskWorkLogs")

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId])
  @@index([companyId, id])
}

model Invoice {
  id               String            @id @default(uuid())
  invoiceNumber    String
  companyId        String
  projectId        String?
  clientId         String?
  clientName       String?
  issueDate        DateTime          @default(now())
  dueDate          DateTime?
  subtotal         Float             @default(0)
  taxPercent       Float             @default(0)
  totalTax         Float             @default(0)
  discount         Float             @default(0)
  totalAmount      Float             @default(0)
  status           String            @default("draft")
  notes            String?
  createdById      String?
  gatewayOrderId   String?
  paymentLink      String?
  gatewayPaymentId String?
  paidAt           DateTime?
  provider         String?
  fingerprint      String?
  riskScore        Float             @default(0)
  riskNotes        String[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  client           Client?           @relation(fields: [clientId], references: [id])
  companyConfig    CompanyConfig     @relation(fields: [companyId], references: [companyId])
  createdBy        User?             @relation(fields: [createdById], references: [id])
  project          Project?          @relation(fields: [projectId], references: [id])
  lineItems        InvoiceLineItem[]
  reminders        InvoiceReminder[]
  taxItems         InvoiceTaxItem[]
  Milestone        Milestone[]

  @@unique([invoiceNumber, companyId])
  @@unique([fingerprint, companyId])
  @@index([companyId, status])
  @@index([companyId])
  @@index([companyId, id])
  @@index([companyId, createdAt])
  @@index([companyId, issueDate(sort: Desc), id])
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String?
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  amount      Float   @default(0)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceTaxItem {
  id        String  @id @default(uuid())
  invoiceId String
  name      String?
  amount    Float   @default(0)
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceReminder {
  id          String   @id @default(uuid())
  invoiceId   String
  sentAt      DateTime @default(now())
  daysFromDue Int?
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ExpenseTransaction {
  id            String    @id @default(uuid())
  companyId     String
  type          String // "company_expense" | "employee_claim"
  title         String
  amount        Float
  currency      String    @default("USD")
  category      String    @default("other")
  date          DateTime
  dueDate       DateTime?
  attachmentUrl String?
  receiptLinks  String[]
  notes         String?
  status        String    @default("pending") // e.g., pending_approval, approved, unpaid, paid
  reviewNote    String?

  // Relations
  projectId     String?
  clientId      String?
  vendorId      String?
  employeeId    String?
  reviewedById  String?
  reviewedAt    DateTime?
  payoutId      String?
  transactionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client      Client?             @relation(fields: [clientId], references: [id])
  company     Company             @relation(fields: [companyId], references: [id])
  vendor      Vendor?             @relation(fields: [vendorId], references: [id])
  employee    User?               @relation("ExpenseTransactionEmployee", fields: [employeeId], references: [id])
  project     Project?            @relation(fields: [projectId], references: [id])
  reviewedBy  User?               @relation("ExpenseTransactionReviewer", fields: [reviewedById], references: [id])
  transaction CompanyTransaction? @relation("TransactionExpenseTransactions", fields: [transactionId], references: [id])

  @@index([companyId, employeeId, status])
  @@index([companyId, vendorId])
  @@index([companyId, projectId])
  @@index([companyId, id])
  @@index([companyId, createdAt])
  @@index([companyId, date(sort: Desc), id])
}

model CalendarEvent {
  id                           String       @id @default(uuid())
  title                        String
  description                  String?
  type                         String       @default("event")
  startDate                    DateTime
  endDate                      DateTime?
  allDay                       Boolean      @default(true)
  color                        String       @default("#4f46e5")
  isCompanyWide                Boolean      @default(false)
  createdById                  String?
  companyId                    String?
  relatedType                  String?
  relatedId                    String?
  startTime                    String?
  endTime                      String?
  platform                     String       @default("others")
  roomId                       String?
  meetingLink                  String?
  location                     String?
  agenda                       String?
  externalAttendees            String[]
  reminderMinutes              Int          @default(15)
  notes                        String?
  emailSent                    Boolean      @default(false)
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt
  createdBy                    User?        @relation("EventCreator", fields: [createdById], references: [id])
  company                      Company?     @relation("CompanyCalendarEvents", fields: [companyId], references: [id])
  meetingLogs_EventMeetingLogs MeetingLog[] @relation("EventMeetingLogs")
  attendees                    User[]       @relation("MeetingAttendees")
  clients                      Client[]     @relation("CalendarEventClients")
  agentRequests                AgentRequest[]

  @@index([companyId])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  action       String
  resourceType String?  @default("")
  resourceId   String?  @default("")
  details      Json?    @default("{}")
  ipAddress    String?  @default("")
  userAgent    String?  @default("")
  companyId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company? @relation(fields: [companyId], references: [id])
  user         User     @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@index([companyId])
  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model Attendance {
  id          String   @id @default(uuid())
  employeeId  String
  date        String
  status      String   @default("present")
  checkIn     String?  @default("")
  checkOut    String?  @default("")
  workHours   Float?   @default(0)
  shiftStatus String   @default("on_time")
  notes       String?  @default("")
  markedById  String?
  companyId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company? @relation(fields: [companyId], references: [id])
