  companyId              String
  planId                 String
  status                 String           @default("trial")
  provider               String           @default("none")
  providerSubscriptionId String?
  providerOrderId        String?
  providerCustomerId     String?
  mandateStatus          String           @default("pending")
  mandateAmount          Int              @default(100)
  autopayEnabled         Boolean          @default(false)
  autopayFailCount       Int              @default(0)
  autopayLastFailedAt    DateTime?
  autopayPausedAt        DateTime?
  cancelReason           String?
  cancelledAt            DateTime?
  trialStartDate         DateTime?
  trialEndDate           DateTime?
  subscriptionStartDate  DateTime?
  subscriptionEndDate    DateTime?
  startDate              DateTime         @default(now())
  renewalDate            DateTime?
  nextChargeDate         DateTime?
  paymentId              String?
  paymentStatus          String           @default("pending")
  amount                 Float
  currency               String           @default("INR")
  couponApplied          String?
  discountAmount         Float            @default(0)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  remindersSent          Json?            @default("[]")
  paymentHistories       PaymentHistory[]
  plan                   Plan             @relation(fields: [planId], references: [id])

  @@index([companyId, status])
  @@index([companyId])
}

model Coupon {
  id            String    @id @default(uuid())
  couponCode    String    @unique
  discountType  String    @default("percentage")
  discountValue Float
  maxUses       Int?
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PaymentHistory {
  id                String       @id @default(uuid())
  paymentId         String       @unique
  companyId         String
  subscriptionId    String
  amount            Float
  currency          String       @default("INR")
  provider          String
  providerPaymentId String
  status            String
  rawWebhookData    Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId])
}

model SuperAdmin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("superadmin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DeletionLog {
  id           String   @id @default(uuid())
  companyId    String
  companyName  String
  initiatedBy  String
  deletionDate DateTime @default(now())
  status       String   @default("completed")
  errorReason  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isEnabled   Boolean  @default(false)
  rules       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  content   String
  target    String    @default("all")
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ReleaseNote {
  id          String   @id @default(uuid())
  version     String   @unique
  title       String
  content     String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupportTicket {
  id          String   @id @default(uuid())
  companyId   String
  companyName String
  userId      String
  userName    String
  userEmail   String
  subject     String
  message     String
  messages    Json?    @default("[]")
  status      String   @default("open")
  priority    String   @default("medium")
  category    String   @default("technical")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId])
}

model TenantUserMapping {
  id        String   @id @default(uuid())
  userId    String
  email     String
  companyId String
  subdomain String
  role      String   @default("employee")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  userName  String
  userEmail String
  action    String
  details   Json?
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedPost {
  id        String    @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime  @default(now())
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation("UserSavedPosts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Hashtag {
  id        String      @id @default(uuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  posts     ForumPost[] @relation("ForumPostToHashtag")
}

model PollOption {
  id        String     @id @default(uuid())
  text      String
  votes     Int        @default(0)
  postId    String
  post      ForumPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  pollVotes PollVote[]
}

model PostReport {
  id         String    @id @default(uuid())
  postId     String
  reporterId String
  reason     String
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  post       ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter   User      @relation("UserPostReports", fields: [reporterId], references: [id], onDelete: Cascade)
}

model PollVote {
  id           String     @id @default(uuid())
  pollOptionId String
  userId       String
  createdAt    DateTime   @default(now())
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  user         User       @relation("UserPollVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollOptionId, userId])
}

model CompanyService {
  id                  String           @id @default(uuid())
  companyId           String
  name                String
  description         String?
  startingPrice       String?
  icon                String?
  imageUrl            String?
  detailedDescription String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requests            ServiceRequest[]

  @@index([companyId])
}

model CompanyProduct {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  link        String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyMedia {
  id        String   @id @default(uuid())
  companyId String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model ServiceRequest {
  id                   String         @id @default(uuid())
  serviceId            String
  companyId            String
  requesterName        String?
  requesterEmail       String
  requesterCompanyName String?
  companySize          String?
  requirements         String
  budgetRange          String?
  timeline             String?
  status               String         @default("pending")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  company              Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service              CompanyService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([serviceId])
}

model CompanyInvestor {
  id        String   @id @default(uuid())
  companyId String
  name      String
  type      String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model AiChatSession {
  id        String          @id @default(uuid())
  userId    String
  title     String          @default("New Chat")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  AiChatMessage[]
  user      User            @relation("UserAiChatSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiChatMessage {
  id        String        @id @default(uuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime      @default(now())
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model UserExperience {
  id          String    @id @default(uuid())
  userId      String
  companyName String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserEducation {
  id           String    @id @default(uuid())
  userId       String
  school       String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String
  skillName String
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserResume {
  id         String   @id @default(uuid())
  userId     String
  fileUrl    String
  fileName   String
  uploadedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserProject {
  id          String    @id @default(uuid())
  userId      String
  name        String
  description String?
  url         String?
  startDate   DateTime?
  endDate     DateTime?
  isOngoing   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id               String              @id @default(uuid())
  title            String
  description      String              @default("")
  eventType        String              @default("in-person")
  location         String              @default("")
  eventDate        DateTime
  registrationLink String?
  bannerImage      String?
  capacity         Int?
  tags             String[]            @default([])
  status           String              @default("upcoming")
  customFields     Json?               @default("[]")
  companyId        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  company          Company             @relation("CompanyEvents", fields: [companyId], references: [id])
  registrations    EventRegistration[]

  @@index([companyId, status])
}

model EventRegistration {
  id         String   @id @default(uuid())
  eventId    String
  name       String
  email      String
  phone      String?
  customData Json?    @default("{}")
  createdAt  DateTime @default(now())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}
