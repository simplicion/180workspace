generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Core Identity & Tenant Models
// -----------------------------------------------------------------------------

model Company {
  id      String  @id @default(uuid())
  name    String
  slug    String? @unique
  logoUrl   String?
  bannerUrl String?

  // Startup Information (PitchIn)
  oneLineDescription String?
  industry           String?
  startupStage       String?
  teamSize           String?
  country            String?
  website            String?
  foundedDate        DateTime?
  companyType        String?
  tagline            String?
  headquarters       String?
  otherOffices       String?
  aboutUs            String?
  vision             String?
  mission            String?
  story              String?
  coreValues         Json?     @default("[]")
  socialLinks        Json?     @default("{}")

  // Financial & Funding
  totalFunding   String?
  fundingStage   String?
  businessStatus String?
  burnRate       String?
  runway         String?
  annualRevenue  String?
  revenueGrowth  String?
  lastRound      String?
  lastValued     String?
  leadInvestor   String?

  // Highlights
  productsBuilt   String?
  happyClients    String?
  countriesActive String?
  awardsCount     String?
  topRecognition  String?
  companyHighlights Json? @default("[]")

  // Social & Engagement
  profileViews    Int     @default(0)
  followersCount  Int     @default(0)

  // Privacy
  privacySettings Json? @default("{}")

  // Admin Information
  adminName         String?
  adminEmail        String? @unique
  adminPhone        String?
  adminPasswordHash String?
  adminRole         String  @default("admin")

  // Onboarding & DB
  databaseConfigured   Boolean @default(false)
  isOnboardingComplete Boolean @default(false)

  // Subscription & Account
  subscriptionStatus String @default("trial")
  accountStatus      String @default("active")
  totalUsers         Int    @default(0)
  metadata           Json?  @default("{}")

  trialStartDate DateTime?
  trialEndDate   DateTime?
  nextChargeDate DateTime?
  autopayEnabled Boolean   @default(false)
  mandateStatus  String?

  users        User[]
  designations Designation[]
  goals        Goal[]
  projects     Project[]
  expenses     Expense[]
  auditLogs    AuditLog[]
  attendances  Attendance[]
  reviews      Review[]
  publicReviews CompanyPublicReview[] @relation("CompanyPublicReviews")
  followersList CompanyFollower[] @relation("CompanyFollowers")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  CompanyConfig                                 CompanyConfig?
  Leave                                         Leave[]
  Settings                                      Settings?
  TenantTransaction                             TenantTransaction[]
  workLogs_CompanyWorkLogs                      WorkLog[]             @relation("CompanyWorkLogs")
  vendorBills_CompanyVendorBills                VendorBill[]          @relation("CompanyVendorBills")
  vendors_CompanyVendors                        Vendor[]              @relation("CompanyVendors")
  meetingLogs_CompanyMeetingLogs                MeetingLog[]          @relation("CompanyMeetingLogs")
  jobOpportunitys_CompanyJobOpportunities       JobOpportunity[]      @relation("CompanyJobOpportunities")
  jobCandidateProfiles_CompanyCandidateProfiles JobCandidateProfile[] @relation("CompanyCandidateProfiles")
  jobApplications_CompanyJobApplications        JobApplication[]      @relation("CompanyJobApplications")
  jobs_CompanyJobs                              Job[]                 @relation("CompanyJobs")
  holidays_CompanyHolidays                      Holiday[]             @relation("CompanyHolidays")
  emailLogs_CompanyEmailLogs                    EmailLog[]            @relation("CompanyEmailLogs")
  documents_CompanyDocuments                    Document[]            @relation("CompanyDocuments")
  contentCalendars_CompanyContentCalendars      ContentCalendar[]     @relation("CompanyContentCalendars")
  automationLogs_CompanyAutomationLogs          AutomationLog[]       @relation("CompanyAutomationLogs")
  clients_CompanyClients                        Client[]              @relation("CompanyClients")
  events_CompanyEvents                          Event[]               @relation("CompanyEvents")

  services        CompanyService[]
  serviceRequests ServiceRequest[]
  products        CompanyProduct[]
  media           CompanyMedia[]
  investors       CompanyInvestor[]
  coreValueItems  CompanyCoreValue[]
  tasks           Task[]
  salaries        Salary[]
}

model CompanyCoreValue {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String
  iconUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompanyPublicReview {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation("CompanyPublicReviews", fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rating      Float    
  title       String
  description String   @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([userId])
}

model CompanyFollower {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation("CompanyFollowers", fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("UserFollowingCompanies", fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

model CompanyConfig {
  id        String    @id @default(uuid())
  companyId String    @unique
  company   Company   @relation(fields: [companyId], references: [id])
  invoices  Invoice[]

  @@index([companyId])
}

model Client {
  id                  String                @id @default(uuid())
  name                String
  invoices            Invoice[]
  expenses            Expense[]
  ClientCommunication ClientCommunication[]
  TenantTransaction   TenantTransaction[]   @relation("TransactionClient")

  automationLogs_AutomationTargetClient   AutomationLog[]   @relation("AutomationTargetClient")
  contentCalendars_ClientContentCalendars ContentCalendar[] @relation("ClientContentCalendars")

  companyId String?
  company   Company? @relation("CompanyClients", fields: [companyId], references: [id])

  @@index([companyId])
}

model Designation {
  id         String   @id @default(uuid())
  name       String
  category   String   @default("general")
  isCustom   Boolean  @default(false)
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())

  users User[] @relation("UserDesignation")

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
}

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  emailVerified DateTime?
  googleId      String?      @unique
  password      String?
  role          String       @default("employee")
  designationId String?
  designation   Designation? @relation("UserDesignation", fields: [designationId], references: [id])
  permissions   String[]     @default([])
  accounts      Account[]
  sessions      Session[]

  // Profile
  image           String?
  photoUrl        String?
  bannerImage     String?
  phone           String?
  isActive        Boolean @default(true)
  canViewActivity Boolean @default(false)

  // PitchIn & Auth
  otpCode     String?
  otpExpiry   DateTime?
  username    String?     @unique
  headline    String?
  title       String?
  companyName String?
  savedPosts  SavedPost[] @relation("UserSavedPosts")
  bio         String?
  city        String?
  country     String?
  socialLinks Json?
  highlights  Json?       @default("[]")
  interests   String[]    @default([])

  // HR / Employee fields
  employeeId       String?   @unique
  department       String?
  position         String?
  joinDate         DateTime?
  performanceScore Int       @default(100)
  salary           Float     @default(0)
  leaveBalance     Float     @default(20)
  emergencyContact String?
  bankAccount      String?
  employmentType   String?
  workLocation     String?
  managerId        String?
  manager          User?     @relation("UserManager", fields: [managerId], references: [id])
  subordinates     User[]    @relation("UserManager")

  // MFA
  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  // System
  isFirstLogin  Boolean @default(true)
  apiKey        String?
  apiKeyEnabled Boolean @default(false)

  // Tenant Relationship
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Relationships
  assignedTasks     Task[]          @relation("TaskAssignee")
  createdTasks      Task[]          @relation("TaskCreator")
  invoicesCreated   Invoice[]
  expenses          Expense[]       @relation("ExpenseEmployee")
  expensesReviewed  Expense[]       @relation("ExpenseReviewer")
  calendarEvents    CalendarEvent[] @relation("EventCreator")
  meetingAttended   CalendarEvent[] @relation("MeetingAttendees")
  auditLogs         AuditLog[]      @relation("UserAuditLogs")
  attendances       Attendance[]    @relation("EmployeeAttendance")
  markedAttendances Attendance[]    @relation("MarkedByAttendance")
  ownedAssets       Asset[]         @relation("AssetOwner")
  createdAssets     Asset[]         @relation("AssetCreator")

  chatsCreated         Chat[]                @relation("ChatCreator")
  chatsJoined          Chat[]                @relation("ChatMembers")
  chatsAdministered    Chat[]                @relation("ChatAdmins")
  messagesSent         Message[]             @relation("MessageSender")
  messagesDeleted      Message[]             @relation("MessageDeletedBy")
  messagesRead         Message[]             @relation("MessageReadBy")
  messagesMentioned    Message[]             @relation("MessageMentions")
  messagesStarred      Message[]             @relation("MessageStarredBy")
  clientCommunications ClientCommunication[] @relation("ClientCommunicationLogger")
  goalsOwned           Goal[]                @relation("GoalOwner")
  goalsAssigned        Goal[]                @relation("GoalAssignedTo")
  leavesRequested      Leave[]               @relation("LeaveEmployee")
  leavesReviewed       Leave[]               @relation("LeaveReviewer")
  milestonesCompleted  Milestone[]           @relation("MilestoneCompleter")
  milestonesCreated    Milestone[]           @relation("MilestoneCreator")
  notesCreated         Note[]                @relation("NoteCreator")
  notifications        Notification[]        @relation("UserNotification")
  reviewsGiven         Review[]              @relation("ReviewManager")
  reviewsReceived      Review[]              @relation("ReviewEmployee")
  salaries             Salary[]              @relation("SalaryEmployee")
  tenantTransactions   TenantTransaction[]   @relation("TransactionUser")
  postReports          PostReport[]          @relation("UserPostReports")
  pollVotes            PollVote[]            @relation("UserPollVotes")

  // AutomationLog
  automationTriggered  AutomationLog[] @relation("AutomationTriggered")
  automationTargetUser AutomationLog[] @relation("AutomationTargetUser")

  // DocumentPage
  documentPagesCreated DocumentPage[] @relation("UserDocumentPagesCreated")
  documentPagesUpdated DocumentPage[] @relation("UserDocumentPagesUpdated")

  // WorkLog
  workLogs         WorkLog[] @relation("UserWorkLogs")
  workLogsReviewed WorkLog[] @relation("UserWorkLogsReviewed")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  aiRequestLogs_AiRequestLogs                AiRequestLog[]        @relation("AiRequestLogs")
  calendarTemplates_CalendarTemplates        CalendarTemplate[]    @relation("CalendarTemplates")
  documents_UserDocuments                    Document[]            @relation("UserDocuments")
  emailLogs_UserEmailLogs                    EmailLog[]            @relation("UserEmailLogs")
  forumPosts_UserForumPosts                  ForumPost[]           @relation("UserForumPosts")
  forumReplys_UserForumReplies               ForumReply[]          @relation("UserForumReplies")
  applications_UserApplicationsReviewed      Application[]         @relation("UserApplicationsReviewed")
  applications_Applied                       Application[]         @relation("UserApplicationsApplied")
  jobApplications_UserJobApplications        JobApplication[]      @relation("UserJobApplications")
  jobCandidateProfiles_UserCandidateProfiles JobCandidateProfile[] @relation("UserCandidateProfiles")
  meetingLogs_UserMeetingLogsCreated         MeetingLog[]          @relation("UserMeetingLogsCreated")
  onboardings_UserOnboardings                Onboarding[]          @relation("UserOnboardings")
  timeLogs_UserTimeLogs                      TimeLog[]             @relation("UserTimeLogs")

  aiChatSessions                  AiChatSession[]  @relation("UserAiChatSessions")
  userPreferences_UserPreferences UserPreference[] @relation("UserPreferences")

  // Social
  followers    User[]      @relation("UserFollows")
  following    User[]      @relation("UserFollows")
  postMentions ForumPost[] @relation("PostMentions")
  followedCompanies CompanyFollower[] @relation("UserFollowingCompanies")

  // Profile extensions
  experiences  UserExperience[]
  educations   UserEducation[]
  skills       UserSkill[]
  resumes      UserResume[]
  userProjects UserProject[]

  ownedModules   Module[] @relation("ModuleOwner")
  createdModules Module[] @relation("ModuleCreator")

  companyPublicReviews CompanyPublicReview[]

  @@index([companyId])
}

// -----------------------------------------------------------------------------
// Operations Models
// -----------------------------------------------------------------------------

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  status      String    @default("not_started") // not_started, in_progress, on_hold, completed, cancelled
  priority    String    @default("medium") // low, medium, high, critical
  deadline    DateTime?
  startDate   DateTime  @default(now())
  progress    Int       @default(0)
  budget      Float     @default(0)
  projectType String    @default("internal") // internal, client, marketing, development
  customTaskStatusName String? @default("Custom")
  visibility  String    @default("public") // public, private
  billingType String    @default("non_billable") // hourly, fixed, non_billable

  ownerId   String?
  memberIds String[]
  clientIds String[]
  tags      String[]

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  tasks    Task[]
  invoices Invoice[]
  expenses Expense[]

  goals      Goal[]      @relation("GoalProject")
  milestones Milestone[] @relation("ProjectMilestones")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contentCalendars_ProjectContentCalendars ContentCalendar[] @relation("ProjectContentCalendars")
  modules_ProjectModules                   Module[]          @relation("ProjectModules")
  timeLogs_ProjectTimeLogs                 TimeLog[]         @relation("ProjectTimeLogs")
  workLogs_ProjectWorkLogs                 WorkLog[]         @relation("ProjectWorkLogs")

  @@index([companyId, status])
  @@index([companyId])
}

model Task {
  id                String    @id @default(uuid())
  title             String
  description       String?
  status            String    @default("todo") // todo, in_progress, in_review, review, done
  priority          String    @default("medium") // low, medium, high, critical
  dueDate           DateTime?
  estimatedHours    Float     @default(0)
  isOverdueNotified Boolean   @default(false)
  completedOnTime   Boolean?
  voiceMessageUrl   String?
  attachments       String[]  @default([])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId  String?
  creator    User?   @relation("TaskCreator", fields: [creatorId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  timeLogs_TaskTimeLogs TimeLog[] @relation("TaskTimeLogs")
  workLogs_TaskWorkLogs WorkLog[] @relation("TaskWorkLogs")

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([companyId])
}

// -----------------------------------------------------------------------------
// Financial Models
// -----------------------------------------------------------------------------

model Invoice {
  id            String @id @default(uuid())
  invoiceNumber String

  companyId     String
  companyConfig CompanyConfig @relation(fields: [companyId], references: [companyId])
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id])
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id])
  clientName    String?

  issueDate DateTime  @default(now())
  dueDate   DateTime?

  subtotal    Float   @default(0)
  taxPercent  Float   @default(0)
  totalTax    Float   @default(0)
  discount    Float   @default(0)
  totalAmount Float   @default(0)
  status      String  @default("draft") // draft, sent, paid, overdue, cancelled
  notes       String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  // Payment Details (Flattened)
  gatewayOrderId   String?
  paymentLink      String?
  gatewayPaymentId String?
  paidAt           DateTime?
  provider         String?

  fingerprint String?
  riskScore   Float    @default(0)
  riskNotes   String[]

  lineItems InvoiceLineItem[]
  taxItems  InvoiceTaxItem[]
  reminders InvoiceReminder[]

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  Milestone Milestone[]

  @@unique([invoiceNumber, companyId])
  @@unique([fingerprint, companyId])
  @@index([companyId, status])
  @@index([companyId])
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String?
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  amount      Float   @default(0)
}

model InvoiceTaxItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name      String?
  amount    Float   @default(0)
}

model InvoiceReminder {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sentAt      DateTime @default(now())
  daysFromDue Int?
}

model Expense {
  id           String   @id @default(uuid())
  title        String
  amount       Float
  category     String   @default("other") // travel, food, accommodation, etc.
  date         DateTime
  receiptUrl   String?
  receiptLinks String[]
  notes        String?
  status       String   @default("pending") // pending, approved, rejected
  reviewNote   String?

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])

  employeeId   String
  employee     User      @relation("ExpenseEmployee", fields: [employeeId], references: [id])
  reviewedById String?
  reviewedBy   User?     @relation("ExpenseReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, employeeId, status])
  @@index([companyId, projectId])
}

// -----------------------------------------------------------------------------
// Meeting & Calendar Models
// -----------------------------------------------------------------------------

model CalendarEvent {
  id            String    @id @default(uuid())
  title         String
  description   String?
  type          String    @default("event") // holiday, event, meeting, deadline, leave, other
  startDate     DateTime
  endDate       DateTime?
  allDay        Boolean   @default(true)
  color         String    @default("#4f46e5")
  isCompanyWide Boolean   @default(false)

  createdById String?
  createdBy   User?   @relation("EventCreator", fields: [createdById], references: [id])

  // CRM Linking
  relatedType String? // Lead, Opportunity, Account
  relatedId   String?

  // Meeting specific fields
  startTime         String?
  endTime           String?
  platform          String   @default("others")
  roomId            String?
  meetingLink       String?
  location          String?
  agenda            String?
  externalAttendees String[]
  reminderMinutes   Int      @default(15)
  notes             String?
  emailSent         Boolean  @default(false)

  attendees User[] @relation("MeetingAttendees")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetingLogs_EventMeetingLogs MeetingLog[] @relation("EventMeetingLogs")
}

// TODO: Map remaining 39 Mongoose models
model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation("UserAuditLogs", fields: [userId], references: [id])
  action       String
  resourceType String?  @default("")
  resourceId   String?  @default("")
  details      Json?    @default("{}")
  ipAddress    String?  @default("")
  userAgent    String?  @default("")
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@index([companyId])
}

model Attendance {
  id          String   @id @default(uuid())
  employeeId  String
  employee    User     @relation("EmployeeAttendance", fields: [employeeId], references: [id])
  date        String
  status      String   @default("present")
  checkIn     String?  @default("")
  checkOut    String?  @default("")
  workHours   Float?   @default(0)
  shiftStatus String   @default("on_time")
  notes       String?  @default("")
  markedById  String?
  markedBy    User?    @relation("MarkedByAttendance", fields: [markedById], references: [id])
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([companyId, status])
  @@index([companyId])
}

model Asset {
  id           String    @id @default(uuid())
  name         String
  type         String    @default("service")
  provider     String?
  status       String    @default("active")
  renewalDate  DateTime?
  cost         Float?    @default(0)
  billingCycle String    @default("monthly")
  url          String?
  description  String?
  credentials  Json?
  ownerId      String?
  owner        User?     @relation("AssetOwner", fields: [ownerId], references: [id])
  createdById  String
  createdBy    User      @relation("AssetCreator", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

// -----------------------------------------------------------------------------
// Additional Models
// -----------------------------------------------------------------------------

model Chat {
  id          String  @id @default(uuid())
  isGroup     Boolean @default(false)
  name        String  @default("")
  description String  @default("")
  avatar      String  @default("")

  createdById   String?
  createdBy     User?    @relation("ChatCreator", fields: [createdById], references: [id])
  lastMessageId String?
  lastMessage   Message? @relation("ChatLastMessage", fields: [lastMessageId], references: [id])
  lastActivity  DateTime @default(now())
  isMuted       Boolean  @default(false)

  members User[] @relation("ChatMembers")
  admins  User[] @relation("ChatAdmins")

  messages       Message[] @relation("ChatMessages")
  pinnedMessages Message[] @relation("PinnedMessages")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id             String @id @default(uuid())
  chatId         String
  chat           Chat   @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User   @relation("MessageSender", fields: [senderId], references: [id])
  content        String @default("")
  attachmentUrl  String @default("")
  attachmentType String @default("none")

  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[] @relation("MessageReplies")

  reactions Json?   @default("{}")
  isSystem  Boolean @default(false)

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("MessageDeletedBy", fields: [deletedById], references: [id])

  readBy    User[] @relation("MessageReadBy")
  mentions  User[] @relation("MessageMentions")
  starredBy User[] @relation("MessageStarredBy")

  chatsWithThisLastMessage   Chat[] @relation("ChatLastMessage")
  chatsWithThisPinnedMessage Chat[] @relation("PinnedMessages")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId, createdAt(sort: Desc)])
}

model ClientCommunication {
  id       String   @id @default(uuid())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type     String   @default("note")
  subject  String
  summary  String   @default("")
  date     DateTime @default(now())

  loggedById   String?
  loggedBy     User?   @relation("ClientCommunicationLogger", fields: [loggedById], references: [id])
  loggedByName String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, date(sort: Desc)])
}

model Goal {
  id          String    @id @default(uuid())
  title       String
  description String    @default("")
  type        String    @default("personal")
  status      String    @default("active")
  progress    Float     @default(0)
  dueDate     DateTime?
  motivation  String    @default("")
  celebration String    @default("")
  difficulty  String    @default("medium")
  color       String    @default("#6366f1")

  ownerId String
  owner   User   @relation("GoalOwner", fields: [ownerId], references: [id])

  projectId String?
  project   Project? @relation("GoalProject", fields: [projectId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  keyResults Json?
  deletedAt  DateTime?

  assignedTo User[] @relation("GoalAssignedTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
}

model Leave {
  id         String  @id @default(uuid())
  employeeId String
  employee   User    @relation("LeaveEmployee", fields: [employeeId], references: [id])
  type       String  @default("casual")
  startDate  String
  endDate    String
  reason     String?
