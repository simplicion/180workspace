  currency           String  @default("USD")
  paymentConfig      Json?   @default("{}")
  paymentsEnabled    Boolean @default(false)
  platformApiUrl     String  @default("")

  // SMTP
  smtpHost   String?
  smtpPort   Int?
  smtpUser   String?
  smtpPass   String?
  smtpFrom   String?
  smtpSecure Boolean @default(false)

  // Feature Settings
  allowSelfRegistration    Boolean @default(true)
  trialDays                Int     @default(14)
  dataRetentionDays        Int     @default(30)
  trialMandateAmount       Int     @default(100)
  maxAutopayRetries        Int     @default(3)
  autopayRetryIntervalDays Int     @default(3)
  superAdminDbUri          String?
  brandingTagline          String  @default("")
  themeColor               String  @default("#4f46e5")
  companyLegalName         String  @default("")
  companyAddress           String  @default("")
  companyPhone             String  @default("")
  companyWebsite           String  @default("")

  // DB Config
  dbHost String?
  dbPort Int?
  dbUser String?
  dbPass String?
  dbName String?
  dbSrv  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id           String   @id @default(uuid())
  planName     String
  price        Float
  currency     String   @default("INR")
  billingCycle String   @default("monthly")
  maxUsers     Int      @default(10)
  features     String[]
  isActive     Boolean  @default(true)
  trialDays    Int      @default(14)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     String    @id @default(uuid())
  companyId              String
  planId                 String
  plan                   Plan      @relation(fields: [planId], references: [id])
  status                 String    @default("trial") // active, trial, suspended, cancelled, expired, mandate_pending
  provider               String    @default("none")
  providerSubscriptionId String?
  providerOrderId        String?
  providerCustomerId     String?
  mandateStatus          String    @default("pending")
  mandateAmount          Int       @default(100)
  autopayEnabled         Boolean   @default(false)
  autopayFailCount       Int       @default(0)
  autopayLastFailedAt    DateTime?
  autopayPausedAt        DateTime?
  cancelReason           String?
  cancelledAt            DateTime?
  trialStartDate         DateTime?
  trialEndDate           DateTime?
  subscriptionStartDate  DateTime?
  subscriptionEndDate    DateTime?
  startDate              DateTime  @default(now())
  renewalDate            DateTime?
  nextChargeDate         DateTime?
  paymentId              String?
  paymentStatus          String    @default("pending")
  amount                 Float
  currency               String    @default("INR")
  couponApplied          String?
  discountAmount         Float     @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  remindersSent Json?    @default("[]")

  paymentHistories PaymentHistory[]

  @@index([companyId, status])
  @@index([companyId])
}

model Coupon {
  id            String    @id @default(uuid())
  couponCode    String    @unique
  discountType  String    @default("percentage") // percentage, fixed
  discountValue Float
  maxUses       Int?
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentHistory {
  id                String       @id @default(uuid())
  paymentId         String       @unique
  companyId         String
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount            Float
  currency          String       @default("INR")
  provider          String
  providerPaymentId String
  status            String
  rawWebhookData    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId])
}

model SuperAdmin {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String
  role         String @default("superadmin")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeletionLog {
  id           String   @id @default(uuid())
  companyId    String
  companyName  String
  initiatedBy  String
  deletionDate DateTime @default(now())
  status       String   @default("completed") // pending, completed, failed
  errorReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId])
}

model FeatureFlag {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isEnabled   Boolean @default(false)
  rules       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  content   String
  target    String    @default("all") // all, specific_plans
  isActive  Boolean   @default(true)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReleaseNote {
  id          String   @id @default(uuid())
  version     String   @unique
  title       String
  content     String
  publishedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id          String @id @default(uuid())
  companyId   String
  companyName String
  userId      String
  userName    String
  userEmail   String
  subject     String
  message     String
  messages    Json?  @default("[]")
  status      String @default("open") // open, in_progress, resolved, closed
  priority    String @default("medium") // low, medium, high
  category    String @default("technical")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId])
}

model TenantUserMapping {
  id        String @id @default(uuid())
  userId    String
  email     String
  companyId String
  subdomain String
  role      String @default("employee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  userName  String
  userEmail String
  action    String
  details   Json?
  timestamp DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedPost {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation("UserSavedPosts", fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Hashtag {
  id        String      @id @default(uuid())
  name      String      @unique
  posts     ForumPost[]
  createdAt DateTime    @default(now())
}

model PollOption {
  id        String     @id @default(uuid())
  text      String
  votes     Int        @default(0)
  postId    String
  post      ForumPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  pollVotes PollVote[]
}

model PostReport {
  id         String    @id @default(uuid())
  postId     String
  post       ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User      @relation("UserPostReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     String    @default("pending") // pending, reviewed, dismissed
  createdAt  DateTime  @default(now())
}

model PollVote {
  id           String     @id @default(uuid())
  pollOptionId String
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("UserPollVotes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([pollOptionId, userId])
}

// -----------------------------------------------------------------------------
// Company Profile & Services Models
// -----------------------------------------------------------------------------

model CompanyService {
  id                String  @id @default(uuid())
  companyId         String
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  startingPrice     String?
  icon              String?
  imageUrl          String?
  detailedDescription String?

  requests ServiceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model CompanyProduct {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  link        String?
  logoUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model CompanyMedia {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  imageUrl  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model ServiceRequest {
  id        String         @id @default(uuid())
  serviceId String
  service   CompanyService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  requesterName        String?
  requesterEmail       String
  requesterCompanyName String?
  companySize          String?
  requirements         String
  budgetRange          String?
  timeline             String?

  status String @default("pending") // pending, reviewing, accepted, rejected, completed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([serviceId])
}

model CompanyInvestor {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name    String
  type    String? // e.g., Lead Investor, Investor
  logoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// -----------------------------------------------------------------------------
// AI Assistant Models
// -----------------------------------------------------------------------------

model AiChatSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserAiChatSessions", fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiChatMessage[]

  @@index([userId])
}

model AiChatMessage {
  id        String        @id @default(uuid())
  sessionId String
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // 'user' or 'assistant'
  content   String
  createdAt DateTime      @default(now())

  @@index([sessionId])
}

// -----------------------------------------------------------------------------
// Profile Models
// -----------------------------------------------------------------------------

model UserExperience {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserEducation {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  school       String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  description  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model UserSkill {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillName String
  isCustom  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

model UserResume {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl    String
  fileName   String
  uploadedAt DateTime @default(now())

  @@index([userId])
}

model UserProject {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?   @db.Text
  url         String?
  startDate   DateTime?
  endDate     DateTime?
  isOngoing   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Event {
  id              String   @id @default(uuid())
  title           String
  description     String   @default("")
  eventType       String   @default("in-person") // in-person, online, hybrid
  location        String   @default("")
  eventDate       DateTime
  registrationLink String?
  bannerImage     String?
  capacity        Int?
  tags            String[] @default([])
  status          String   @default("upcoming") // upcoming, ongoing, past, cancelled
  customFields    Json?    @default("[]")

  companyId       String
  company         Company  @relation("CompanyEvents", fields: [companyId], references: [id])

  registrations   EventRegistration[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, status])
}

model EventRegistration {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  customData  Json?    @default("{}")
  createdAt   DateTime @default(now())

  @@index([eventId])
}
