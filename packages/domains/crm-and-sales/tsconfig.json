{
  
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "moduleResolution": "Node",
    "module": "CommonJS",
    "target": "ES2022",
    "allowJs": true, "allowSyntheticDefaultImports": true, "esModuleInterop": true, "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}



