datasource db {
  provider = "postgresql"
  url      = env("DEVELOPERS_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// ─────────────────────────────────────────────────────────────────────────────
// 180 DEVELOPERS & SOVEREIGN IDENTITY ENGINE DATA MODELS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(uuid())
  email                String?   @unique
  phone                String?   @unique
  password             String?
  passwordHash         String?
  username             String    @unique
  name                 String
  avatarUrl            String?   @default("")
  photoUrl             String?   @default("")
  image                String?   @default("")
  bio                  String?   @default("")
  headline             String?   @default("")
  location             String?   @default("")
  latitude             Float?
  longitude            Float?
  city                 String?   @default("")
  country              String?   @default("")
  role                 String    @default("USER")
  isVerified           Boolean   @default(false)
  emailVerified        Boolean   @default(false)
  isActive             Boolean   @default(true)
  isOnboardingComplete Boolean   @default(false)
  otpCode              String?
  otpExpiry            DateTime?
  companyId            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  oauthApps        OAuthApp[]               @relation("UserOAuthApps")
  oauthCodes       OAuthAuthorizationCode[] @relation("UserOAuthCodes")
  oauthTokens      OAuthToken[]             @relation("UserOAuthTokens")
  oauthConsents    OAuthConsent[]           @relation("UserOAuthConsents")
  otps             OtpVerification[]        @relation("UserOtps")
  securityKeys     SecurityKey[]            @relation("UserSecurityKeys")
  wallet           Wallet?                  @relation("UserWallet")
  checkoutSessions CheckoutSession[]        @relation("UserCheckoutSessions")

  @@index([username])
  @@index([email])
  @@index([phone])
}

model OAuthApp {
  id               String   @id @default(uuid())
  name             String
  description      String?  @default("")
  clientId         String   @unique
  clientSecretHash String
  clientSecretHint String
  redirectUris     String[] @default([])
  allowedOrigins   String[] @default([])
  logoUrl          String?  @default("")
  homepageUrl      String?  @default("")
  isVerified       Boolean  @default(false)
  isActive         Boolean  @default(true)
  enableAuth       Boolean  @default(true)
  enablePay        Boolean  @default(true)
  webhookUrl       String?  @default("")
  webhookSecret    String?  @default("")
  allowedScopes    String[] @default(["identity:read"])
  userId           String
  companyId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User                     @relation("UserOAuthApps", fields: [userId], references: [id], onDelete: Cascade)
  codes            OAuthAuthorizationCode[] @relation("AppOAuthCodes")
  tokens           OAuthToken[]             @relation("AppOAuthTokens")
  consents         OAuthConsent[]           @relation("AppOAuthConsents")
  metrics          DeveloperMetric[]        @relation("AppMetrics")
  webhooks         WebhookEndpoint[]        @relation("AppWebhooks")
  wallet           Wallet?                  @relation("AppWallet")
  checkoutSessions CheckoutSession[]        @relation("AppCheckoutSessions")
  payoutRequests   PayoutRequest[]          @relation("AppPayoutRequests")

  @@index([userId])
  @@index([clientId])
}

model OAuthAuthorizationCode {
  id                  String    @id @default(uuid())
  code                String    @unique
  appId               String
  userId              String
  redirectUri         String
  scopes              String[]
  codeChallenge       String?
  codeChallengeMethod String?   @default("S256")
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime  @default(now())

  app  OAuthApp @relation("AppOAuthCodes", fields: [appId], references: [id], onDelete: Cascade)
  user User     @relation("UserOAuthCodes", fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
}

model OAuthToken {
  id           String    @id @default(uuid())
  accessToken  String    @unique
  refreshToken String?   @unique
  tokenType    String    @default("Bearer")
  scopes       String[]
  appId        String
  userId       String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  app  OAuthApp @relation("AppOAuthTokens", fields: [appId], references: [id], onDelete: Cascade)
  user User     @relation("UserOAuthTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([accessToken])
  @@index([refreshToken])
}

model OAuthConsent {
  id        String   @id @default(uuid())
  appId     String
  userId    String
  scopes    String[]
  grantedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app  OAuthApp @relation("AppOAuthConsents", fields: [appId], references: [id], onDelete: Cascade)
  user User     @relation("UserOAuthConsents", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appId, userId])
}

model OtpVerification {
  id         String   @id @default(uuid())
  identifier String
  type       String // WHATSAPP, SMS, EMAIL
  code       String
  expiresAt  DateTime
  verified   Boolean  @default(false)
  attempts   Int      @default(0)
  userId     String?
  createdAt  DateTime @default(now())

  user User? @relation("UserOtps", fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, verified])
}

model SecurityKey {
  id           String   @id @default(uuid())
  userId       String
  credentialId String   @unique
  publicKey    String
  counter      BigInt   @default(0)
  transports   String[] @default([])
  createdAt    DateTime @default(now())

  user User @relation("UserSecurityKeys", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeveloperMetric {
  id         String   @id @default(uuid())
  appId      String
  endpoint   String
  statusCode Int
  latencyMs  Int
  createdAt  DateTime @default(now())

  app OAuthApp @relation("AppMetrics", fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, createdAt])
}

model WebhookEndpoint {
  id        String   @id @default(uuid())
  appId     String
  url       String
  secret    String
  events    String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app        OAuthApp          @relation("AppWebhooks", fields: [appId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[] @relation("EndpointDeliveries")

  @@index([appId])
}

model WebhookDelivery {
  id          String    @id @default(uuid())
  endpointId  String
  event       String
  payload     String
  statusCode  Int?
  response    String?   @default("")
  error       String?   @default("")
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  endpoint WebhookEndpoint @relation("EndpointDeliveries", fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// 180 WALLET, LEDGER & CHECKOUT FINANCIAL DATA MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Wallet {
  id             String   @id @default(uuid())
  userId         String?  @unique
  developerAppId String?  @unique
  balance        Float    @default(0)
  currency       String   @default("INR")
  isLocked       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User?         @relation("UserWallet", fields: [userId], references: [id], onDelete: Cascade)
  app           OAuthApp?     @relation("AppWallet", fields: [developerAppId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[] @relation("WalletLedgerEntries")
}

model LedgerEntry {
  id           String   @id @default(uuid())
  walletId     String
  amount       Float
  balanceAfter Float
  type         String // TOPUP, CHECKOUT_PAY, CHECKOUT_RECEIVE, PAYOUT, REFUND
  referenceId  String?
  description  String?
  metadata     Json?
  createdAt    DateTime @default(now())

  wallet Wallet @relation("WalletLedgerEntries", fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([referenceId])
}

model CheckoutSession {
  id          String    @id @default(uuid())
  appId       String
  userId      String?
  amount      Float
  currency    String    @default("INR")
  status      String    @default("PENDING") // PENDING, AUTHORIZED, CAPTURED, EXPIRED, CANCELLED
  title       String
  description String?   @default("")
  returnUrl   String?   @default("")
  cancelUrl   String?   @default("")
  metadata    Json?
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  app  OAuthApp @relation("AppCheckoutSessions", fields: [appId], references: [id], onDelete: Cascade)
  user User?    @relation("UserCheckoutSessions", fields: [userId], references: [id], onDelete: SetNull)

  @@index([appId, status])
  @@index([userId])
}

model PayoutRequest {
  id             String    @id @default(uuid())
  appId          String
  userId         String
  amount         Float
  currency       String    @default("INR")
  status         String    @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, PROCESSING, PAID, REJECTED
  payoutMethod   String // UPI, BANK_TRANSFER
  accountDetails Json
  adminNote      String?   @default("")
  transactionRef String?   @default("")
  requestedAt    DateTime  @default(now())
  processedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  app OAuthApp @relation("AppPayoutRequests", fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, status])
  @@index([userId])
}
